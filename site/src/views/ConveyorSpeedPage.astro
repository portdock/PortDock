---
// 웹 도구: 컨베이어 라인 속도 ↔ 인버터 주파수(lib/conveyor.ts). 둘레 π·D(정의) + 동기 속도 120f/p(ABB)·슬립 근사(YASKAWA E2-02).
import Base from "../layouts/Base.astro";
import AdSlot from "../components/AdSlot.astro";
import Crumbs from "../components/Crumbs.astro";
import WebToolLinks from "../components/WebToolLinks.astro";
import UseNotice from "../components/UseNotice.astro";
import { speedFromHz } from "../lib/conveyor";
import { type Lang } from "../data/tools";
import { url } from "../lib/i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const ko = lang === "ko";
const PATH = "tools/conveyor-speed/";
const ABB = "https://library.e.abb.com/public/1fd380f8ca8b4934ae3fa609d764fd33/21043_ABB_Motor_Guide_REV_D.pdf";
// 예: 4극·감속 1/30·지름 100 mm 에서 주파수별 라인 속도(동기 기준)
const tRows = [10, 20, 30, 40, 50, 60].map((hz) => {
  const o = speedFromHz(hz, { poles: 4, slipRpm: 0, ratio: 30, diaMm: 100 });
  return [`${hz} Hz`, `${+o.motorRpm.toFixed(0)}`, `${+o.rollerRpm.toFixed(2)}`, `${+o.m.toFixed(2)}`];
});
const L = ko
  ? {
      title: "컨베이어 속도 ↔ 인버터 주파수 계산기",
      desc: "롤러 지름·감속비·모터 극수·슬립으로 인버터 주파수에서 컨베이어 라인 속도(m/min)를 구하고, 원하는 속도에 필요한 주파수(Hz)를 계산합니다.",
      dia: "구동 롤러(드럼) 지름 (mm)",
      ratio: "감속비 (모터 ÷ 롤러, 예 30)",
      poles: "모터 극수",
      base: "명판 정격 주파수 (Hz)",
      rated: "명판 정격 회전수 (r/min, 모르면 비움)",
      hz: "출력 주파수 (Hz)",
      want: "원하는 라인 속도 (m/min)",
      res: "결과",
      k: { slip: "정격 슬립 회전수", motor: "모터 회전수 (슬립 반영)", roller: "롤러 회전수", m: "라인 속도", ms: "라인 속도 (동기 속도 기준)", perhz: "1 Hz 당 라인 속도", need: "원하는 속도에 필요한 주파수" },
      example: "기본값(지름 100 mm, 감속 1/30, 4극 60 Hz 1750 r/min)은 예시입니다. 실제 감속비·롤러 지름은 감속기 명판과 도면 값을 넣으세요.",
      how: "값을 바꾸면 바로 다시 계산합니다. 계산은 이 브라우저 안에서만 하고, 입력한 값은 어디에도 보내지 않습니다.",
      fTitle: "계산식",
      formula: ["동기 속도 ns = 120 × f ÷ 극수   [r/min]", "모터 회전수 n ≈ ns − 정격 슬립 회전수 (정격 슬립 = 동기 속도 − 명판 회전수)", "롤러 회전수 = n ÷ 감속비", "라인 속도 v = π × D × 롤러 회전수   [m/min, D 는 m]", "필요 주파수 f = (v ÷ (π × D) × 감속비 + 슬립 회전수) × 극수 ÷ 120"],
      tTitle: "예: 4극·감속 1/30·롤러 100 mm (슬립 무시)",
      tHead: ["주파수", "모터 r/min", "롤러 r/min", "라인 m/min"],
      tNote: "슬립을 무시하면 라인 속도는 주파수에 정비례합니다(이 예는 1 Hz 당 0.314 m/min). 실제로는 부하에 따라 슬립이 있어 같은 주파수에서 조금 느립니다.",
      lTitle: "맞춰 볼 것",
      l: [
        "벨트 두께·미끄럼은 이 식에 들어 있지 않아 실제 속도가 계산과 조금 다를 수 있습니다. 처음 한 번은 길이를 재고 시간을 재서(예: 10 m 를 몇 초에) 계산값과 비교합니다.",
        "체인·풀리로 한 번 더 감속하면 감속비를 곱해서 넣습니다(감속기 1/30 × 스프로킷 2:1 → 60).",
        "슬립 회전수를 그대로 두는 것은 근사입니다. 인버터의 슬립 보상·벡터 제어를 켜면 동기 속도 쪽에 가까워집니다.",
        "인버터에서 표시 단위를 m/min 으로 바꾸는 기능(표시 계수)을 쓸 때 «1 Hz 당 라인 속도» 가 그 계수입니다 — 설정 방법은 인버터 매뉴얼을 봅니다.",
      ],
      uTitle: "현장에서 쓰는 곳",
      u: ["라인 속도 사양(m/min)에 맞는 인버터 주파수·최고 주파수 정하기.", "감속기·롤러를 바꾼 뒤 같은 속도를 내는 주파수 다시 구하기.", "PLC 에서 Modbus 로 주파수 지령을 줄 때 속도 ↔ Hz 환산 계수."],
      faqTitle: "자주 묻는 것",
      faq: [
        ["컨베이어 속도는 어떻게 계산하나요?", "모터 회전수 ÷ 감속비 = 롤러 회전수, 여기에 롤러 둘레(π × 지름)를 곱합니다. 60 Hz 4극(1800 r/min), 감속 1/30, 지름 100 mm 면 60 r/min × 0.314 m = 18.85 m/min 입니다(슬립 무시)."],
        ["원하는 m/min 에 필요한 Hz 는?", "속도 ÷ (π × 지름) 으로 롤러 회전수, × 감속비로 모터 회전수, 거기에 슬립을 더해 × 극수 ÷ 120 입니다. 위 예에서 15 m/min 은 약 47.7 Hz(슬립 무시)입니다."],
        ["주파수를 두 배로 하면 속도도 두 배인가요?", "기저 주파수 아래에서는 거의 그렇습니다(슬립만큼 차이). 기저 주파수 위로 올리면 토크가 줄어드니 모터·감속기 사양을 확인합니다."],
      ],
      msNote: "극수·슬립·감속비만으로 회전수를 보려면",
      msLink: "모터 회전수 계산기",
      tbNote: "벨트·풀리 치수는",
      tbLink: "타이밍 벨트 계산기",
      srcTitle: "근거",
      src: "라인 속도는 회전 한 번에 둘레(π × 지름)만큼 움직인다는 정의입니다. 동기 속도 = 주파수 × 120 ÷ 극수는 ABB «Low voltage motors — Motor guide»(2019) §9.3, 정격 슬립(동기 속도 − 명판 회전수)을 운전 주파수에서도 그대로 두는 근사는 YASKAWA A1000 매뉴얼 E2-02(모터 정격 슬립)의 정의를 따른 것으로, 모터 회전수 계산기와 같은 식입니다.",
      srcLink: "ABB Motor guide (PDF)",
    }
  : {
      title: "Conveyor Speed ↔ VFD Frequency Calculator",
      desc: "Conveyor line speed (m/min) from drive frequency, roller diameter, gear ratio, motor poles and slip, and the frequency (Hz) needed for a target speed.",
      dia: "Drive roller (drum) diameter (mm)",
      ratio: "Gear ratio (motor ÷ roller, e.g. 30)",
      poles: "Motor poles",
      base: "Nameplate rated frequency (Hz)",
      rated: "Nameplate rated speed (r/min, blank if unknown)",
      hz: "Output frequency (Hz)",
      want: "Target line speed (m/min)",
      res: "Results",
      k: { slip: "Rated slip speed", motor: "Motor speed (with slip)", roller: "Roller speed", m: "Line speed", ms: "Line speed (synchronous)", perhz: "Line speed per Hz", need: "Frequency for target speed" },
      example: "The defaults (100 mm roller, 1/30 gearbox, 4-pole 60 Hz 1750 r/min) are an example. Enter the real gear ratio and roller diameter from the gearbox nameplate and drawings.",
      how: "Results update as you type. Everything runs in your browser; nothing you type is sent anywhere.",
      fTitle: "Formulas",
      formula: ["Synchronous speed ns = 120 × f ÷ poles   [r/min]", "Motor speed n ≈ ns − rated slip speed (rated slip = synchronous − nameplate speed)", "Roller speed = n ÷ gear ratio", "Line speed v = π × D × roller speed   [m/min, D in m]", "Required frequency f = (v ÷ (π × D) × ratio + slip speed) × poles ÷ 120"],
      tTitle: "Example: 4 poles, 1/30 gearbox, 100 mm roller (slip ignored)",
      tHead: ["Frequency", "Motor r/min", "Roller r/min", "Line m/min"],
      tNote: "Ignoring slip, line speed is proportional to frequency (0.314 m/min per Hz in this example). In practice slip under load makes it a little slower at the same frequency.",
      lTitle: "Things to check",
      l: [
        "Belt thickness and slipping are not in this formula, so the real speed can differ a little. Measure once (e.g. seconds for 10 m) and compare with the calculation.",
        "For an extra chain or pulley stage, multiply the ratios (1/30 gearbox × 2:1 sprockets → 60).",
        "Keeping the slip speed constant is an approximation. With slip compensation or vector control on, the speed gets closer to synchronous.",
        "If the drive can display in m/min (a display coefficient), «line speed per Hz» is that coefficient; see the drive manual for how to set it.",
      ],
      uTitle: "Where it is used",
      u: ["Setting the drive frequency and maximum frequency for a line speed spec in m/min.", "Recalculating the frequency for the same speed after changing a gearbox or roller.", "The speed ↔ Hz factor for a PLC that sends frequency commands over Modbus."],
      faqTitle: "FAQ",
      faq: [
        ["How do I calculate conveyor speed?", "Motor speed ÷ gear ratio = roller speed; multiply by the roller circumference (π × diameter). At 60 Hz, 4 poles (1800 r/min), a 1/30 gearbox and a 100 mm roller: 60 r/min × 0.314 m = 18.85 m/min (slip ignored)."],
        ["What frequency gives a target m/min?", "Speed ÷ (π × diameter) gives the roller speed, × ratio the motor speed; add the slip and multiply by poles ÷ 120. In the example, 15 m/min needs about 47.7 Hz (slip ignored)."],
        ["Does doubling the frequency double the speed?", "Nearly, below base frequency (apart from slip). Above base frequency the torque drops, so check the motor and gearbox ratings."],
      ],
      msNote: "For speed from poles, slip and ratio alone, use the",
      msLink: "Motor Speed Calculator",
      tbNote: "For belt and pulley dimensions, use the",
      tbLink: "Timing Belt Calculator",
      srcTitle: "Basis",
      src: "Line speed follows from the definition that one revolution moves one circumference (π × diameter). Synchronous speed = frequency × 120 ÷ poles is from ABB «Low voltage motors — Motor guide» (2019) §9.3; keeping the rated slip (synchronous − nameplate speed) constant at other frequencies follows the definition of motor rated slip in the YASKAWA A1000 manual (E2-02), the same as the motor speed calculator.",
      srcLink: "ABB Motor guide (PDF)",
    };
const ld = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: L.faq.map(([q, a]) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a } })),
};
---

<Base lang={lang} title={L.title} seoTitle={ko ? "컨베이어 속도 계산기 — m/min ↔ 인버터 Hz·감속비 — PortDock" : "Conveyor Speed Calculator: m/min ↔ VFD Hz, Gear Ratio — PortDock"} description={L.desc} path={PATH} ads>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <header class="page-head">
    <div class="wrap">
      <Crumbs lang={lang} items={[{ name: ko ? "웹 도구" : "Web tools", path: "tools/" }, { name: L.title, path: PATH }]} />
      <h1>{L.title}</h1>
      <p>{L.desc}</p>
    </div>
  </header>
  <div class="wrap" style="padding-top:24px">
    <form class="calc card" id="cv">
      <div class="row">
        <label class="fld">{L.dia}<input id="dia" class="mono" value="100" inputmode="decimal" spellcheck="false" autocomplete="off" /></label>
        <label class="fld">{L.ratio}<input id="ratio" class="mono" value="30" inputmode="decimal" spellcheck="false" autocomplete="off" /></label>
      </div>
      <div class="row">
        <label class="fld">{L.poles}<select id="poles">{[2, 4, 6, 8].map((p) => <option value={p} selected={p === 4}>{p}</option>)}</select></label>
        <label class="fld">{L.base}<input id="base" class="mono" value="60" inputmode="decimal" spellcheck="false" autocomplete="off" /></label>
        <label class="fld">{L.rated}<input id="rated" class="mono" value="1750" inputmode="decimal" spellcheck="false" autocomplete="off" /></label>
      </div>
      <div class="row">
        <label class="fld">{L.hz}<input id="hz" class="mono" value="60" inputmode="decimal" spellcheck="false" autocomplete="off" /></label>
        <label class="fld">{L.want}<input id="want" class="mono" value="15" inputmode="decimal" spellcheck="false" autocomplete="off" /></label>
      </div>
      <p class="err" id="err" role="alert"></p>
      <div class="tbl" aria-live="polite">
        <table class="t kv">
          <caption class="note" style="text-align:left">{L.res}</caption>
          <tbody>{Object.entries(L.k).map(([id, name]) => <tr><td>{name}</td><td class="mono" data-k={id}></td></tr>)}</tbody>
        </table>
      </div>
      <p class="note">{L.example}</p>
      <p class="note">{L.how}</p>
    </form>

    <AdSlot />

    <section class="prose">
      <h2>{L.fTitle}</h2>
      <ul>{L.formula.map((f) => <li class="mono">{f}</li>)}</ul>
      <h2>{L.tTitle}</h2>
      <div class="tbl">
        <table class="t">
          <thead><tr>{L.tHead.map((h) => <th>{h}</th>)}</tr></thead>
          <tbody>{tRows.map((r) => <tr>{r.map((c) => <td class="mono">{c}</td>)}</tr>)}</tbody>
        </table>
      </div>
      <p>{L.tNote}</p>
      <h2>{L.lTitle}</h2>
      <ul>{L.l.map((x) => <li>{x}</li>)}</ul>
      <h2>{L.uTitle}</h2>
      <ul>{L.u.map((x) => <li>{x}</li>)}</ul>
      <h2>{L.faqTitle}</h2>
      {
        L.faq.map(([q, a]) => (
          <>
            <h3>{q}</h3>
            <p>{a}</p>
          </>
        ))
      }
      <p>
        {L.msNote} <a href={url(lang, "tools/motor-speed/")}>{L.msLink}</a>. {L.tbNote} <a href={url(lang, "tools/timing-belt/")}>{L.tbLink}</a>.
      </p>
      <h2>{L.srcTitle}</h2>
      <p>{L.src} <a href={ABB} rel="noopener">{L.srcLink}</a>.</p>
    </section>
    <UseNotice lang={lang} />
    <WebToolLinks lang={lang} path={PATH} />
  </div>
  <script>
    import { hzForSpeed, perHz, speedFromHz } from "../lib/conveyor";
    import { syncRpm } from "../lib/motor";
    const ko = document.documentElement.lang === "ko";
    const form = document.getElementById("cv") as HTMLFormElement;
    const $ = <E extends HTMLElement = HTMLInputElement>(id: string) => document.getElementById(id) as E;
    const num = (id: string) => {
      const s = $(id).value.trim().replace(",", ".");
      const n = s === "" ? NaN : Number(s);
      return Math.abs(n) > 1e12 ? NaN : n;
    };
    const set = (k: string, v: string) => {
      const td = form.querySelector<HTMLElement>(`td[data-k="${k}"]`);
      if (td) td.textContent = v;
    };
    const p4 = (x: number) => String(+x.toPrecision(4));
    function run() {
      try {
        const poles = Number($<HTMLSelectElement>("poles").value);
        const ratedS = $("rated").value.trim();
        let slipRpm = 0;
        if (ratedS !== "") {
          const ns = syncRpm(num("base"), poles);
          const r = num("rated");
          if (!(r > 0 && r <= ns)) throw new RangeError("rated");
          slipRpm = ns - r;
        }
        const d = { poles, slipRpm, ratio: num("ratio"), diaMm: num("dia") };
        if (!(d.ratio > 0) || !(d.diaMm > 0)) throw new RangeError("in");
        const o = speedFromHz(num("hz"), d);
        set("slip", ratedS === "" ? (ko ? "0 (비움 — 동기 속도로 계산)" : "0 (blank — synchronous)") : `${p4(slipRpm)} r/min`);
        set("motor", `${p4(o.motorRpm)} r/min`);
        set("roller", `${p4(o.rollerRpm)} r/min`);
        set("m", `${p4(o.m)} m/min (${p4(o.m / 60)} m/s)`);
        set("ms", `${p4(o.mSync)} m/min`);
        set("perhz", `${p4(perHz(d))} m/min`);
        set("need", `${p4(hzForSpeed(num("want"), d))} Hz`);
        $("err").textContent = "";
      } catch {
        $("err").textContent = ko ? "숫자를 확인하세요 — 지름·감속비는 0 보다 크고, 정격 회전수는 동기 속도 이하, 주파수·속도는 0 이상" : "Check the numbers — diameter and ratio above 0, rated speed at or below synchronous, frequency and speed 0 or more";
        for (const td of form.querySelectorAll<HTMLElement>("td[data-k]")) td.textContent = "";
      }
    }
    form.addEventListener("input", run);
    form.addEventListener("change", run);
    form.addEventListener("submit", (e) => e.preventDefault());
    run();
  </script>
</Base>
