---
// 웹 도구: IP 서브넷 계산기 — 주소·마스크 → 네트워크·브로드캐스트·호스트 범위, PC 와 장비가 양쪽 마스크로 서로 같은 서브넷인지(lib/subnet.ts).
// 근거 RFC 는 lib 머리 주석. 광고는 본문 아래에만(AdSlot).
import Base from "../layouts/Base.astro";
import AdSlot from "../components/AdSlot.astro";
import Crumbs from "../components/Crumbs.astro";
import WebToolLinks from "../components/WebToolLinks.astro";
import UseNotice from "../components/UseNotice.astro";
import { PREFIX_TABLE } from "../lib/subnet";
import { type Lang } from "../data/tools";
import { url } from "../lib/i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const ko = lang === "ko";
const PATH = "tools/subnet/";
const L = ko
  ? {
      title: "IP 서브넷 계산기",
      desc: "IP 주소와 서브넷 마스크(255.255.255.0·/24)로 네트워크·브로드캐스트 주소와 쓸 수 있는 범위를 내고, PC 와 PLC·HMI 가 같은 대역인지 양쪽 마스크로 판정합니다.",
      a: "A — PC 주소",
      am: "A 마스크",
      b: "B — 장비 주소(PLC·HMI·Modbus TCP)",
      bm: "B 마스크",
      gw: "A 게이트웨이(선택)",
      res: "A 의 서브넷",
      k: {
        cidr: "CIDR",
        mask: "서브넷 마스크",
        wild: "와일드카드",
        net: "네트워크 주소",
        bc: "브로드캐스트 주소",
        range: "쓸 수 있는 주소",
        hosts: "쓸 수 있는 주소 수",
        kind: "주소 종류",
        binIp: "주소(2진)",
        binMask: "마스크(2진)",
      },
      pairTitle: "A 와 B 가 서로 닿는가",
      how: "값을 바꾸면 바로 다시 계산합니다. 계산은 이 브라우저 안에서만 하고, 입력한 주소는 어디에도 보내지 않습니다.",
      tip: "마스크 칸에는 24, /24, 255.255.255.0 어느 꼴이든 넣을 수 있습니다. 주소 칸에 192.168.1.10/24 처럼 함께 써도 됩니다.",
      howTitle: "같은 서브넷인지 판정하는 법",
      howP: [
        "주소와 마스크를 비트마다 AND 하면 네트워크 주소가 나옵니다. 두 장치의 네트워크 주소가 같으면 같은 서브넷이고, 이더넷에서 바로(ARP 로) 서로를 찾습니다. 다르면 패킷을 게이트웨이(라우터)로 보냅니다.",
        "이 판정은 장치마다 «자기 마스크» 로 따로 합니다. 그래서 PC 는 /16, 장비는 /24 처럼 마스크가 다르면, PC 는 장비를 같은 망으로 보고 바로 보내지만 장비는 PC 를 다른 망으로 보고 응답을 게이트웨이로 보내 버리는 «한쪽만 닿는» 상태가 생깁니다. 이 계산기는 A·B 두 방향을 따로 보여 줍니다.",
      ],
      ex: "예: 192.168.1.10/24 → 네트워크 192.168.1.0, 브로드캐스트 192.168.1.255, 쓸 수 있는 주소 192.168.1.1~192.168.1.254(254개).",
      tableTitle: "마스크 표",
      tableHead: ["CIDR", "서브넷 마스크", "쓸 수 있는 주소 수"],
      tableNote: "/31 은 점대점 연결에서 두 주소를 모두 쓰고(RFC 3021), /32 는 주소 하나입니다.",
      privTitle: "사설 주소 대역 (RFC 1918)",
      priv: ["10.0.0.0/8 — 10.0.0.0 ~ 10.255.255.255", "172.16.0.0/12 — 172.16.0.0 ~ 172.31.255.255", "192.168.0.0/16 — 192.168.0.0 ~ 192.168.255.255"],
      privNote: "공장·사무실 안쪽 장비는 보통 이 대역을 씁니다. 169.254.x.x 가 보이면 그 PC·장비가 DHCP 서버에서 주소를 받지 못해 스스로 붙인 링크 로컬 주소(RFC 3927)입니다.",
      faqTitle: "자주 묻는 것",
      faq: [
        ["255.255.255.0 은 /몇인가요?", "앞에서부터 1 비트가 24개라 /24 입니다. 255.255.0.0 은 /16, 255.255.255.128 은 /25, 255.255.255.252 는 /30 입니다."],
        ["PLC 가 192.168.0.10 이고 PC 가 192.168.1.20 이면 통신이 되나요?", "마스크가 255.255.255.0(/24)이면 네트워크가 192.168.0.0 과 192.168.1.0 으로 달라 게이트웨이 없이는 닿지 않습니다. PC 에 192.168.0.x 대역의 빈 주소를 하나 더 넣는 방법이 흔합니다."],
        ["/24 에서 몇 대까지 주소를 줄 수 있나요?", "256 개 가운데 네트워크 주소(.0)와 브로드캐스트 주소(.255)를 뺀 254 개입니다. 게이트웨이도 이 중 하나를 씁니다."],
      ],
      appNote: "같은 대역의 장비를 실제로 찾으려면",
      appNote2: "으로 ARP·핑 검색을 합니다.",
    }
  : {
      title: "IP Subnet Calculator",
      desc: "From an IP and mask (255.255.255.0 or /24): network, broadcast and usable range, and whether a PC and a PLC or HMI share a subnet, checked with both masks.",
      a: "A — PC address",
      am: "A mask",
      b: "B — device address (PLC, HMI, Modbus TCP)",
      bm: "B mask",
      gw: "A gateway (optional)",
      res: "A's subnet",
      k: {
        cidr: "CIDR",
        mask: "Subnet mask",
        wild: "Wildcard",
        net: "Network address",
        bc: "Broadcast address",
        range: "Usable addresses",
        hosts: "Usable address count",
        kind: "Address type",
        binIp: "Address (binary)",
        binMask: "Mask (binary)",
      },
      pairTitle: "Can A and B reach each other?",
      how: "Results update as you type. Everything runs in your browser; addresses you type are not sent anywhere.",
      tip: "The mask fields accept 24, /24 or 255.255.255.0. You can also type 192.168.1.10/24 in the address field.",
      howTitle: "How the same-subnet decision works",
      howP: [
        "AND the address with the mask bit by bit and you get the network address. If two hosts have the same network address they are on the same subnet and find each other directly on Ethernet (via ARP); otherwise packets go to the gateway (router).",
        "Each host decides with its own mask. If the PC uses /16 and the device /24, the PC sees the device as local and sends directly, but the device sees the PC as remote and sends its replies to its gateway — a «one-way» setup. This calculator shows both directions separately.",
      ],
      ex: "Example: 192.168.1.10/24 → network 192.168.1.0, broadcast 192.168.1.255, usable 192.168.1.1–192.168.1.254 (254 addresses).",
      tableTitle: "Mask table",
      tableHead: ["CIDR", "Subnet mask", "Usable addresses"],
      tableNote: "/31 uses both addresses on point-to-point links (RFC 3021); /32 is a single address.",
      privTitle: "Private address ranges (RFC 1918)",
      priv: ["10.0.0.0/8 — 10.0.0.0 to 10.255.255.255", "172.16.0.0/12 — 172.16.0.0 to 172.31.255.255", "192.168.0.0/16 — 192.168.0.0 to 192.168.255.255"],
      privNote: "Plant and office devices normally use these. A 169.254.x.x address means that PC or device got no address from a DHCP server and assigned itself a link-local one (RFC 3927).",
      faqTitle: "FAQ",
      faq: [
        ["What prefix is 255.255.255.0?", "It has 24 leading one bits, so /24. 255.255.0.0 is /16, 255.255.255.128 is /25 and 255.255.255.252 is /30."],
        ["The PLC is 192.168.0.10 and the PC 192.168.1.20 — will they talk?", "With 255.255.255.0 (/24) their networks are 192.168.0.0 and 192.168.1.0, so they cannot reach each other without a gateway. Adding a free 192.168.0.x address to the PC is the usual fix."],
        ["How many hosts fit in a /24?", "256 addresses minus the network (.0) and broadcast (.255) addresses = 254. The gateway takes one of them too."],
      ],
      appNote: "To find the devices on that subnet, run an ARP and ping sweep with",
      appNote2: ".",
    };
const ld = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: L.faq.map(([q, a]) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a } })),
};
---

<Base lang={lang} title={L.title} seoTitle={ko ? "IP 서브넷 계산기 — 마스크·대역·PLC 와 PC 같은 대역 확인 — PortDock" : "IP Subnet Calculator: Mask, Range, PLC & PC Subnet — PortDock"} description={L.desc} path={PATH} ads>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <header class="page-head">
    <div class="wrap">
      <Crumbs lang={lang} items={[{ name: ko ? "웹 도구" : "Web tools", path: "tools/" }, { name: L.title, path: PATH }]} />
      <h1>{L.title}</h1>
      <p>{L.desc}</p>
    </div>
  </header>
  <div class="wrap" style="padding-top:24px">
    <form class="calc card" id="sn" data-lang={lang}>
      <div class="row">
        <label class="fld" style="flex:2 1 220px">{L.a}<input id="a" class="mono" value="192.168.1.200" spellcheck="false" autocomplete="off" /></label>
        <label class="fld">{L.am}<input id="am" class="mono" value="255.255.255.0" spellcheck="false" autocomplete="off" /></label>
        <label class="fld">{L.gw}<input id="gw" class="mono" value="" placeholder="192.168.1.1" spellcheck="false" autocomplete="off" /></label>
      </div>
      <div class="row">
        <label class="fld" style="flex:2 1 220px">{L.b}<input id="b" class="mono" value="192.168.1.10" spellcheck="false" autocomplete="off" /></label>
        <label class="fld">{L.bm}<input id="bm" class="mono" value="24" spellcheck="false" autocomplete="off" /></label>
      </div>
      <p class="note">{L.tip}</p>
      <p class="err" id="err" role="alert"></p>
      <div class="tbl" aria-live="polite">
        <table class="t kv">
          <caption class="note" style="text-align:left">{L.res}</caption>
          <tbody>{Object.entries(L.k).map(([id, name]) => <tr><td>{name}</td><td data-k={id}></td></tr>)}</tbody>
        </table>
      </div>
      <h2 style="font-size:17px;margin:4px 0 0">{L.pairTitle}</h2>
      <div id="pair"></div>
      <p class="note">{L.how}</p>
    </form>

    <AdSlot />

    <section class="prose">
      <h2>{L.howTitle}</h2>
      {L.howP.map((p) => <p>{p}</p>)}
      <p class="mono">{L.ex}</p>
      <h2>{L.privTitle}</h2>
      <ul>{L.priv.map((x) => <li class="mono">{x}</li>)}</ul>
      <p>{L.privNote}</p>
      <h2>{L.tableTitle}</h2>
      <div class="tbl">
        <table class="t">
          <thead><tr>{L.tableHead.map((h) => <th>{h}</th>)}</tr></thead>
          <tbody>{PREFIX_TABLE.map((r) => <tr><td class="mono">/{r.prefix}</td><td class="mono">{r.mask}</td><td class="mono">{r.hosts.toLocaleString("en-US")}</td></tr>)}</tbody>
        </table>
      </div>
      <p class="note">{L.tableNote}</p>
      <h2>{L.faqTitle}</h2>
      {
        L.faq.map(([q, a]) => (
          <>
            <h3>{q}</h3>
            <p>{a}</p>
          </>
        ))
      }
      <p>
        {L.appNote} <a href={url(lang, "netscan/")}>PortDock Net Scan</a>{L.appNote2}
      </p>
    </section>
    <UseNotice lang={lang} />
    <WebToolLinks lang={lang} path={PATH} />
  </div>
  <script>
    import { KIND_LABEL, bin, ipStr, pair, parseCidr, parseIp, subnet, type Lang } from "../lib/subnet";
    const form = document.getElementById("sn") as HTMLFormElement;
    const lang = (form.dataset.lang ?? "ko") as Lang;
    const ko = lang === "ko";
    const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
    const set = (k: string, v: string) => {
      const td = form.querySelector<HTMLElement>(`td[data-k="${k}"]`);
      if (td) td.textContent = v;
    };
    function run() {
      const err = $("err");
      const box = document.getElementById("pair")!;
      box.replaceChildren();
      const A = parseCidr($("a").value, $("am").value);
      if (!A) {
        err.textContent = ko ? "A 주소나 마스크를 확인하세요(예: 192.168.1.200 · 255.255.255.0 또는 24)" : "Check A's address or mask (e.g. 192.168.1.200 · 255.255.255.0 or 24)";
        for (const td of form.querySelectorAll<HTMLElement>("td[data-k]")) td.textContent = "";
        return;
      }
      const s = subnet(A.ip, A.prefix);
      set("cidr", `${ipStr(s.network)}/${s.prefix}`);
      set("mask", ipStr(s.mask));
      set("wild", ipStr(s.wildcard));
      set("net", ipStr(s.network));
      set("bc", ipStr(s.broadcast));
      set("range", `${ipStr(s.first)} ~ ${ipStr(s.last)}`);
      set("hosts", s.hosts.toLocaleString("en-US"));
      set("kind", KIND_LABEL[s.kind][lang]);
      set("binIp", bin(s.ip));
      set("binMask", bin(s.mask));
      const bText = $("b").value.trim();
      const B = bText ? parseCidr(bText, $("bm").value) : null;
      const gwText = $("gw").value.trim();
      const gw = gwText ? parseIp(gwText) : undefined;
      if ((bText && !B) || gw === null) {
        err.textContent = ko ? "B 주소·마스크나 게이트웨이를 확인하세요" : "Check B's address/mask or the gateway";
        return;
      }
      err.textContent = "";
      if (!B) return;
      const p = pair(A, B, gw);
      const nb = subnet(B.ip, B.prefix);
      const line = (cls: string, text: string) => {
        const el = document.createElement("p");
        el.className = "verdict " + cls;
        el.textContent = text;
        box.append(el);
      };
      line("", ko ? `A ${ipStr(A.ip)}/${A.prefix} 의 네트워크 ${ipStr(s.network)} → B ${p.aSeesB ? "같은 서브넷" : "다른 네트워크"}` : `A ${ipStr(A.ip)}/${A.prefix}, network ${ipStr(s.network)} → B is ${p.aSeesB ? "local" : "remote"}`);
      line("", ko ? `B ${ipStr(B.ip)}/${B.prefix} 의 네트워크 ${ipStr(nb.network)} → A ${p.bSeesA ? "같은 서브넷" : "다른 네트워크"}` : `B ${ipStr(B.ip)}/${B.prefix}, network ${ipStr(nb.network)} → A is ${p.bSeesA ? "local" : "remote"}`);
      for (const m of p.messages) line(m.level, m[lang]);
    }
    form.addEventListener("input", run);
    form.addEventListener("submit", (e) => e.preventDefault());
    run();
  </script>
</Base>
