---
// 웹 도구: Modbus RTU ↔ TCP 프레임 변환기 — 같은 PDU 를 RTU(국번+CRC)·TCP(MBAP)·ASCII(«:»+LRC+CR LF)로 바꿔 보여 준다.
// 계산·풀이는 lib/modbusConvert.ts(CRC·LRC 는 checksum.ts, PDU 풀이는 modbusDecode.ts 의 decodePdu). 광고는 본문 아래에만(AdSlot).
import Base from "../layouts/Base.astro";
import AdSlot from "../components/AdSlot.astro";
import Crumbs from "../components/Crumbs.astro";
import WebToolLinks from "../components/WebToolLinks.astro";
import UseNotice from "../components/UseNotice.astro";
import { buildFrame } from "../lib/modbusConvert";
import { page2 } from "../i18n";
import type { SiteLang } from "../i18n/langs";
import { ui, link, isTranslated } from "../lib/i18n";
import { pageName } from "../i18n/names";

interface Props {
  lang: SiteLang;
}
const { lang } = Astro.props;
const PATH = "tools/modbus-rtu-tcp/";
const L =
  lang === "ko"
  ? {
      title: "Modbus RTU ↔ TCP 프레임 변환기",
      seo: "Modbus RTU ↔ TCP 변환기 — MBAP·CRC·ASCII LRC (온라인) — PortDock",
      desc: "Modbus RTU(국번+CRC)를 MBAP 머리가 붙은 TCP 프레임으로, TCP 를 RTU 로 바꿉니다. ASCII(«:»·LRC)와도 서로 바꾸고 바이트마다 색으로 풀어 줍니다.",
      input: "프레임 (RTU·TCP 는 HEX, ASCII 는 «:» 로 시작하는 글자)",
      help: "예: 01 03 00 00 00 0A C5 CD · 00 01 00 00 00 06 01 03 00 00 00 0A · :01030000000AF2\\r\\n — 요청·응답 모두, 프레임 하나씩",
      mode: "입력 형식",
      auto: "자동 판별",
      tid: "트랜잭션 ID (TCP 로 바꿀 때, 0~65535)",
      tidHelp: "응답을 바꿀 때는 짝 요청의 번호를 넣으세요.",
      examples: "예시",
      ex: ["RTU 03 요청", "RTU 03 응답", "TCP 요청", "TCP 예외 응답", "ASCII 요청", "RTU 10 쓰기"],
      how: "모든 변환은 이 브라우저 안에서만 하고, 붙여 넣은 바이트는 어디에도 보내지 않습니다.",
      faqTitle: "자주 묻는 것",
      srcTitle: "근거",
      faq: [
        ["RTU 와 TCP 프레임은 무엇이 다른가요?", "가운데 PDU(함수 코드부터 데이터까지)는 똑같습니다. RTU 는 앞에 국번 1바이트, 뒤에 CRC16 2바이트(낮은 바이트 먼저)를 붙이고, TCP 는 CRC 없이 앞에 MBAP 머리 7바이트(트랜잭션 ID 2·프로토콜 ID 2(항상 0)·길이 2·유닛 ID 1)를 붙입니다. 길이는 유닛 ID 부터 끝까지의 바이트 수입니다."],
        ["게이트웨이를 쓸 때 유닛 ID 는 무엇을 넣나요?", "TCP→RTU 게이트웨이(시리얼 서버)는 받은 유닛 ID 를 시리얼 쪽 국번으로 씁니다. 그래서 뒤에 있는 장비의 국번(1~247)을 넣어야 합니다. 0 은 시리얼에서 브로드캐스트라 게이트웨이에 따라 모든 장비에 넘기거나(응답 없음) 게이트웨이 자신으로 봅니다. 255(FF)는 직접 연결한 TCP 장비에 권장되는 값이라, 게이트웨이에서는 보통 시리얼로 넘기지 않거나 게이트웨이 자신이 답합니다. 정확한 처리는 게이트웨이 매뉴얼을 볼 것."],
        ["트랜잭션 ID 는 어떻게 정하나요?", "요청을 보내는 쪽이 정하고 장비는 응답에 같은 번호를 되돌립니다. 보통 요청마다 1씩 늘립니다. RTU 에는 이 칸이 없어서 TCP→RTU 로 바꾸면 사라지고, RTU→TCP 로 바꿀 때는 위 칸의 값을 씁니다."],
        ["ASCII 모드는 무엇인가요?", "Modbus over Serial Line 의 다른 전송 방식입니다. 국번·PDU·LRC 를 바이트마다 HEX 글자 두 개(대문자)로 보내고, 앞에 «:»(3A), 끝에 CR LF(0D 0A)를 붙입니다. LRC 는 국번부터 PDU 끝까지 바이트를 더한 값의 2의 보수(8비트)입니다. RTU 와 같은 PDU 를 쓰므로 서로 바꿀 수 있습니다."],
        ["CRC·LRC 가 틀렸다고 나옵니다", "끝 바이트를 CRC(또는 LRC)로 보고 빼낸 뒤 나머지로 변환하고, 올바른 값을 함께 보여 줍니다. CRC 없이 국번+PDU 만 붙여 넣었다면 형식을 RTU 로 두고 올바른 CRC 를 끝에 붙여 다시 넣거나, CRC·체크섬 계산기로 CRC 를 구하세요."],
      ],
      guide: "Modbus TCP 연결·MBAP 머리",
      guide2: "Modbus RTU 프레임 읽는 법",
      src: ["MBAP 머리(트랜잭션·프로토콜·길이·유닛 ID), 게이트웨이의 유닛 ID", "RTU·ASCII 프레임, 국번(0 브로드캐스트, 1~247), CRC·LRC", "PDU(함수 코드·데이터), 예외 응답"],
      seeG: ["MBAP 머리와 연결 문제는 가이드 ", ", RTU 바이트 풀이는 ", " 를 보세요."],
      seeT: ["값 표·40001 주소까지 자세히 풀려면 ", "Modbus 프레임 해석기", ", 문제로 익히려면 ", "Modbus 연습장", " 을 쓰세요."],
    }
  : lang === "en"
  ? {
      title: "Modbus RTU ↔ TCP Frame Converter",
      seo: "Modbus RTU to TCP Converter: MBAP, CRC, ASCII LRC — PortDock",
      desc: "Convert Modbus RTU (address + CRC) to Modbus TCP with an MBAP header and back, plus ASCII mode (colon, LRC). Every byte color-coded and explained.",
      input: "Frame (HEX for RTU and TCP, text starting with «:» for ASCII)",
      help: "e.g. 01 03 00 00 00 0A C5 CD · 00 01 00 00 00 06 01 03 00 00 00 0A · :01030000000AF2\\r\\n — requests or responses, one frame at a time",
      mode: "Input format",
      auto: "Auto-detect",
      tid: "Transaction ID (when converting to TCP, 0–65535)",
      tidHelp: "For a response, enter the number from its request.",
      examples: "Examples",
      ex: ["RTU 03 request", "RTU 03 response", "TCP request", "TCP exception", "ASCII request", "RTU 10 write"],
      how: "Everything is converted in your browser; the bytes you paste are not sent anywhere.",
      faqTitle: "FAQ",
      srcTitle: "References",
      faq: [
        ["What is the difference between an RTU and a TCP frame?", "The PDU in the middle (function code and data) is identical. RTU adds a 1-byte slave address in front and a 2-byte CRC16 (low byte first) at the end. TCP has no CRC and puts a 7-byte MBAP header in front: transaction ID (2), protocol ID (2, always 0), length (2) and unit ID (1). The length counts the bytes from the unit ID to the end."],
        ["Which Unit ID do I use through a gateway?", "A TCP-to-RTU gateway (serial device server) uses the Unit ID it receives as the slave address on the serial side, so enter the address of the device behind it (1 to 247). Address 0 is a broadcast on a serial line, so depending on the gateway it is forwarded to every device (no reply) or taken as the gateway itself. 255 (FF) is the value recommended for a TCP device addressed directly; a gateway usually does not forward it to the serial line, or answers it itself. Check the gateway manual for the exact behaviour."],
        ["How is the Transaction ID chosen?", "The sender of the request picks it and the device returns the same number in its response; it is usually increased by one per request. RTU has no such field, so it is dropped when converting TCP to RTU, and the value in the box above is used when converting RTU to TCP."],
        ["What is ASCII mode?", "The other transmission mode of Modbus over Serial Line. The address, PDU and LRC are sent as two upper-case HEX characters per byte, with «:» (3A) in front and CR LF (0D 0A) at the end. The LRC is the 8-bit two's complement of the sum of the bytes from the address to the end of the PDU. It carries the same PDU as RTU, so the two convert directly."],
        ["It says the CRC or LRC is wrong", "The last bytes are taken as the CRC (or LRC) and dropped, the rest is converted, and the correct value is shown. If you pasted only the address and PDU without a CRC, keep the format on RTU and append the correct CRC, or get it from the CRC & Checksum Calculator."],
      ],
      guide: "Modbus TCP connections and the MBAP header",
      guide2: "Reading Modbus RTU frames",
      src: ["MBAP header (transaction, protocol, length, unit ID), unit ID at gateways", "RTU and ASCII framing, addresses (0 broadcast, 1–247), CRC and LRC", "PDU (function code and data), exception responses"],
      seeG: ["For the MBAP header and connection problems see ", "; for the RTU bytes see ", "."],
      seeT: ["To decode values and 40001 addresses in detail use the ", "Modbus Frame Decoder", "; to practise with questions try the ", "Modbus Practice Quiz", "."],
    }
  : (() => {
      const d = page2(lang, "modbusRtuTcp");
      // Modbus 연습장(4차 묶음)이 그 언어로 번역됐으면 링크 글을 그 언어 이름으로(사전의 글은 «(영어)» 표시가 붙은 이름)
      const practice = "tools/modbus-practice/";
      return { ...d, seeT: [d.seeT[0], d.seeT[1], d.seeT[2], isTranslated(lang, practice) ? pageName(lang, practice) : d.seeT[3], d.seeT[4]] };
    })();
const pdus: [number, number[]][] = [
  [1, [0x03, 0x00, 0x00, 0x00, 0x0a]],
  [1, [0x03, 0x06, 0x02, 0x2b, 0x00, 0x00, 0x00, 0x64]],
];
const EXAMPLES = [
  buildFrame("rtu", ...pdus[0]).text,
  buildFrame("rtu", ...pdus[1]).text,
  buildFrame("tcp", 1, [0x03, 0x00, 0x6b, 0x00, 0x03], 1).text,
  buildFrame("tcp", 17, [0x83, 0x02], 5).text,
  buildFrame("ascii", ...pdus[0]).text,
  buildFrame("rtu", 1, [0x10, 0x00, 0x01, 0x00, 0x02, 0x04, 0x00, 0x0a, 0x01, 0x02]).text,
];
const ld = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: L.faq.map(([q, a]) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a } })),
};
---

<Base lang={lang} title={L.title} seoTitle={L.seo} description={L.desc} path={PATH} ads libText={["checksum", "modbusNames", "modbusDecode", "modbusConvert"]}>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <header class="page-head">
    <div class="wrap">
      <Crumbs lang={lang} items={[{ name: ui(lang).webTools, path: "tools/" }, { name: L.title, path: PATH }]} />
      <h1>{L.title}</h1>
      <p>{L.desc}</p>
    </div>
  </header>
  <div class="wrap" style="padding-top:24px">
    <form class="calc card" id="cv" data-lang={lang}>
      <label class="fld">
        {L.input}
        <textarea id="data" class="mono" rows="3" spellcheck="false" autocomplete="off">{EXAMPLES[0]}</textarea>
        <span class="note">{L.help}</span>
      </label>
      <div class="row">
        <label class="fld" style="flex:0 1 200px">
          {L.mode}
          <select id="mode">
            <option value="auto">{L.auto}</option>
            <option value="rtu">Modbus RTU</option>
            <option value="tcp">Modbus TCP</option>
            <option value="ascii">Modbus ASCII</option>
          </select>
        </label>
        <label class="fld" style="flex:1 1 260px">
          {L.tid}
          <input id="tid" class="mono" inputmode="numeric" value="1" spellcheck="false" autocomplete="off" />
          <span class="note">{L.tidHelp}</span>
        </label>
      </div>
      <div class="ex-row" role="group" aria-label={L.examples}>
        <span class="note">{L.examples}</span>
        {L.ex.map((name, i) => <button type="button" class="btn tight" data-ex={EXAMPLES[i]}>{name}</button>)}
      </div>
      <p class="err" id="err" role="alert"></p>
      <div id="out" aria-live="polite"></div>
      <p class="note">{L.how}</p>
    </form>

    <AdSlot />

    <section class="prose">
      <h2>{L.faqTitle}</h2>
      {
        L.faq.map(([q, a]) => (
          <>
            <h3>{q}</h3>
            <p>{a}</p>
          </>
        ))
      }
      <h2>{L.srcTitle}</h2>
      <ul>
        <li>Modbus Messaging on TCP/IP Implementation Guide V1.0b — {L.src[0]}</li>
        <li>Modbus over Serial Line Specification and Implementation Guide V1.02 — {L.src[1]}</li>
        <li>Modbus Application Protocol Specification V1.1b3 — {L.src[2]}</li>
      </ul>
      <p>
        {L.seeG[0]}
        <a href={link(lang, "guides/modbus-tcp-connection/")}>{L.guide}</a>{L.seeG[1]}
        <a href={link(lang, "guides/modbus-rtu-frame/")}>{L.guide2}</a>{L.seeG[2]}
      </p>
      <p>
        {L.seeT[0]}
        <a href={link(lang, "tools/modbus-decoder/")}>{L.seeT[1]}</a>{L.seeT[2]}
        <a href={link(lang, "tools/modbus-practice/")}>{L.seeT[3]}</a>{L.seeT[4]}
      </p>
    </section>
    <UseNotice lang={lang} />
    <WebToolLinks lang={lang} path={PATH} />
  </div>
  <style>
    .ex-row {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      align-items: center;
    }
    #out :global(.cv-box) {
      border: 1px solid var(--line);
      border-radius: 8px;
      padding: 12px 14px;
      margin-top: 12px;
    }
    #out :global(.cv-box h2) {
      font-size: 17px;
      margin: 0 0 8px;
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      align-items: center;
    }
    #out :global(.cv-strip) {
      display: flex;
      flex-wrap: wrap;
      gap: 4px;
      margin: 4px 0 10px;
      font-size: 15px;
    }
    #out :global(.cv-seg) {
      padding: 2px 6px;
      border-radius: 4px;
      border-bottom: 3px solid var(--c);
      background: color-mix(in srgb, var(--c) 16%, transparent);
      white-space: nowrap;
    }
    #out :global(.cv-key) {
      display: inline-block;
      width: 10px;
      height: 10px;
      border-radius: 2px;
      background: var(--c);
      margin-right: 6px;
    }
    #out :global(.cv-bad) {
      color: #b42318;
      font-size: 14px;
      margin: 6px 0 0;
      padding-left: 20px;
    }
    #out :global(.cv-notes) {
      font-size: 14px;
      margin: 6px 0 0;
      padding-left: 20px;
      color: var(--muted);
    }
    #out :global(.scroll) {
      overflow-x: auto;
    }
    @media (prefers-color-scheme: dark) {
      #out :global(.cv-bad) {
        color: #f97066;
      }
    }
  </style>
  <script>
    import { msg, type Lang } from "../lib/tr";
    import { buildFrame, convertNotes, parseFrame, type Format, type InFormat, type Segment } from "../lib/modbusConvert";
    import { decodePdu } from "../lib/modbusDecode";
    const form = document.getElementById("cv") as HTMLFormElement;
    const lang = (form.dataset.lang ?? "ko") as Lang;
    const t = (k: string, e: string) => msg(lang, k, e);
    const data = document.getElementById("data") as HTMLTextAreaElement;
    const mode = document.getElementById("mode") as HTMLSelectElement;
    const tidIn = document.getElementById("tid") as HTMLInputElement;
    const err = document.getElementById("err")!;
    const out = document.getElementById("out")!;
    const NAME: Record<Format, string> = { rtu: "Modbus RTU", tcp: "Modbus TCP", ascii: "Modbus ASCII" };
    const COLOR: Record<string, string> = { tid: "#7c3aed", proto: "#64748b", len: "#0891b2", unit: "#d97706", crc: "#dc2626", lrc: "#dc2626", start: "#64748b", end: "#64748b" };
    const PDU_COLORS = ["#2563eb", "#16a34a", "#db2777", "#0d9488", "#9333ea", "#65a30d", "#ea580c"];
    const colorOf = (s: Segment) => (s.kind === "pdu" ? PDU_COLORS[(s.part ?? 0) % PDU_COLORS.length] : COLOR[s.kind]);

    function el<K extends keyof HTMLElementTagNameMap>(tag: K, cls = "", text = "") {
      const e = document.createElement(tag);
      if (cls) e.className = cls;
      if (text) e.textContent = text;
      return e;
    }
    function list(items: string[], cls: string) {
      const ul = el("ul", cls);
      for (const i of items) ul.append(el("li", "", i));
      return ul;
    }
    /** 색 띠 + 항목 표 */
    function segView(segs: Segment[]) {
      const frag = document.createDocumentFragment();
      const strip = el("div", "cv-strip mono");
      for (const s of segs) {
        const sp = el("span", "cv-seg", s.raw);
        sp.style.setProperty("--c", colorOf(s));
        sp.title = s.name;
        strip.append(sp);
      }
      const box = el("div", "scroll");
      const tb = el("table", "t");
      const hr = el("tr");
      for (const h of [t("항목", "Field"), t("바이트", "Bytes"), t("값", "Value")]) hr.append(el("th", "", h));
      tb.append(el("thead"));
      tb.tHead!.append(hr);
      const body = el("tbody");
      for (const s of segs) {
        const tr = el("tr");
        const name = el("td");
        const key = el("span", "cv-key");
        key.style.setProperty("--c", colorOf(s));
        name.append(key, document.createTextNode(s.name));
        tr.append(name, el("td", "mono", s.raw), el("td", "", s.value));
        body.append(tr);
      }
      tb.append(body);
      box.append(tb);
      frag.append(strip, box);
      return frag;
    }
    function copyBtn(text: string) {
      const b = el("button", "btn tight", t("복사", "Copy")) as HTMLButtonElement;
      b.type = "button";
      b.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(text);
          b.textContent = t("복사함", "Copied");
        } catch {
          b.textContent = t("복사 못 함 — 직접 고르세요", "Copy failed — select it by hand");
        }
      });
      return b;
    }

    function run() {
      out.replaceChildren();
      err.textContent = "";
      if (!data.value.trim()) return;
      const tidText = tidIn.value.trim() || "1";
      const tid = /^0x[0-9a-f]+$/i.test(tidText) ? parseInt(tidText, 16) : /^\d+$/.test(tidText) ? Number(tidText) : NaN;
      if (!(tid >= 0 && tid <= 0xffff)) {
        err.textContent = t("트랜잭션 ID 는 0~65535 숫자입니다", "Transaction ID must be a number from 0 to 65535");
        return;
      }
      let p;
      try {
        p = parseFrame(data.value, mode.value as InFormat, lang);
      } catch (e) {
        err.textContent = (e as Error).message;
        return;
      }
      const src = el("section", "cv-box");
      const h = el("h2", "", `${t("입력", "Input")}: ${NAME[p.format]}`);
      src.append(h, el("p", "note", p.why));
      const kinds = decodePdu(p.pdu, lang).map((r) => r.title);
      src.append(el("p", "note", `PDU ${p.pdu.length} ${t("바이트", "bytes")} — ${kinds.join(" · ")}`));
      src.append(segView(p.segments));
      if (p.problems.length) src.append(list(p.problems, "cv-bad"));
      if (p.notes.length) src.append(list(p.notes, "cv-notes"));
      out.append(src);
      for (const f of (["tcp", "rtu", "ascii"] as Format[]).filter((x) => x !== p.format)) {
        const b = buildFrame(f, p.unit, p.pdu, tid, lang);
        const box = el("section", "cv-box");
        const head = el("h2", "", `→ ${NAME[f]}`);
        head.append(copyBtn(b.text));
        box.append(head);
        if (f === "ascii") box.append(el("p", "note", t(`선 위 바이트: ${b.bytes.map((x) => x.toString(16).toUpperCase().padStart(2, "0")).join(" ")}`, `Bytes on the wire: ${b.bytes.map((x) => x.toString(16).toUpperCase().padStart(2, "0")).join(" ")}`)));
        box.append(segView(b.segments));
        const notes = convertNotes(p, f, lang);
        if (notes.length) box.append(list(notes, "cv-notes"));
        out.append(box);
      }
    }
    for (const b of form.querySelectorAll<HTMLButtonElement>("button[data-ex]")) {
      b.addEventListener("click", () => {
        data.value = b.dataset.ex ?? "";
        mode.value = "auto";
        run();
      });
    }
    form.addEventListener("input", run);
    form.addEventListener("change", run);
    form.addEventListener("submit", (e) => e.preventDefault());
    run();
  </script>
</Base>
