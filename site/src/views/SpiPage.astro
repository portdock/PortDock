---
// 웹 도구: SPI 모드 도우미 — 모드 0~3(CPOL·CPHA) → SCK·MOSI·MISO·CS 파형 SVG(샘플·시프트 엣지), 바이트의 비트 파형, MSB/LSB first,
// 클럭·바이트 수 → 전송 시간, 제조사별 표기 표. 계산은 lib/spi.ts.
import Base from "../layouts/Base.astro";
import AdSlot from "../components/AdSlot.astro";
import Crumbs from "../components/Crumbs.astro";
import WebToolLinks from "../components/WebToolLinks.astro";
import UseNotice from "../components/UseNotice.astro";
import { modeInfo, notations } from "../lib/spi";
import { type Lang } from "../data/tools";
import { url } from "../lib/i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const ko = lang === "ko";
const PATH = "tools/spi/";
const edgeName = (e: string) => (ko ? (e === "rising" ? "상승 ↑" : "하강 ↓") : e === "rising" ? "rising ↑" : "falling ↓");
const L = ko
  ? {
      title: "SPI 모드 도우미 (CPOL·CPHA 파형)",
      desc: "SPI 모드 0~3 을 고르면 SCK·MOSI·MISO·CS 파형과 샘플·시프트 엣지를 그리고, 바이트의 비트(MSB/LSB first), 전송 시간, 제조사별 CPOL·CPHA 표기 차이를 보여 줍니다.",
      mode: "SPI 모드",
      mosi: "MOSI 바이트 (HEX, 최대 4)",
      miso: "MISO 바이트 (HEX, 비우면 모름)",
      order: "비트 순서",
      orders: ["MSB first (보통)", "LSB first"],
      clk: "SCK 클럭 (MHz)",
      n: "보낼 바이트 수",
      res: "결과",
      k: { cp: "CPOL · CPHA", idle: "SCK 쉼 레벨", sample: "샘플(데이터 읽는) 엣지", shift: "시프트(데이터 바꾸는) 엣지", first: "첫 비트가 나오는 때", time: "전송 시간 (바이트 사이 쉼 없음)", rate: "처리량" },
      legend: ["샘플 엣지", "시프트 엣지"],
      how: "그림과 계산은 이 브라우저 안에서만 하고, 입력한 값은 어디에도 보내지 않습니다.",
      mTitle: "모드 표",
      mHead: ["모드", "CPOL", "CPHA", "쉼 SCK", "샘플", "시프트"],
      nTitle: "제조사·환경별 표기",
      nHead: ["모드", "일반(CPOL/CPHA)", "Linux spidev", "Arduino SPI", "TI MSP430 USCI", "Microchip PIC MSSP"],
      nNote: "MSP430 의 UCCKPH 와 PIC 의 CKE 는 CPHA 와 뜻이 반대입니다 — UCCKPH = 1·CKE = 1 이 «첫 엣지에서 잡음(CPHA 0)». 데이터시트의 레지스터 설명(어느 엣지에서 잡고 어느 엣지에서 바꾸는지)으로 맞춰 볼 것.",
      wTitle: "CPHA 가 뜻하는 것",
      w: [
        "CPOL 은 쉬는 동안 SCK 의 레벨입니다(0 = Low, 1 = High). 쉼 → 활성으로 가는 엣지가 «앞 엣지», 돌아오는 엣지가 «뒤 엣지» 입니다.",
        "CPHA 0: 앞 엣지에서 샘플, 뒤 엣지에서 다음 비트로 바꿉니다. 그래서 첫 비트는 첫 엣지 전에 — CS 가 내려가자마자 — 놓여 있어야 합니다.",
        "CPHA 1: 앞 엣지에서 비트를 내놓고 뒤 엣지에서 샘플합니다.",
        "양쪽 모드가 다르면 비트가 한 칸 밀리거나(0x81 → 0x40·0xC0 처럼 반 칸 어긋남) 첫 바이트만 깨지는 식으로 보입니다. 장치 데이터시트의 타이밍 그림에서 SCK 쉼 레벨과 «데이터가 SCK 의 어느 엣지에서 latch 되는지» 를 보고 모드를 고릅니다.",
      ],
      faqTitle: "자주 묻는 것",
      faq: [
        ["가장 많이 쓰는 모드는?", "모드 0 과 모드 3 이 흔합니다. 둘 다 상승 엣지에서 샘플하므로 많은 장치가 두 모드를 모두 받습니다. 정확한 것은 그 장치 데이터시트의 타이밍 그림을 볼 것."],
        ["읽은 값이 한 비트씩 밀려 있습니다", "원인 후보: CPHA 가 장치와 다름, 클럭이 너무 빨라 MISO 가 늦게 바뀜(장치의 출력 지연), 긴 배선. 클럭을 낮춰 같은 증상인지 볼 것."],
        ["CS 는 바이트마다 올려야 하나요?", "장치마다 다릅니다. 여러 바이트를 한 명령으로 받는 장치(플래시 메모리 등)는 명령 내내 CS 를 Low 로 둬야 합니다. 이 그림은 CS 를 한 번 내린 채 이어 보냅니다."],
      ],
      srcTitle: "출처",
      more: "UART·I2C·CAN 은",
    }
  : {
      title: "SPI Mode Helper (CPOL/CPHA Waveforms)",
      desc: "Pick SPI mode 0–3 to draw SCK, MOSI, MISO and CS with sample and shift edges, a byte's bits (MSB/LSB first), transfer time and vendor names for CPOL/CPHA.",
      mode: "SPI mode",
      mosi: "MOSI bytes (hex, up to 4)",
      miso: "MISO bytes (hex, blank = unknown)",
      order: "Bit order",
      orders: ["MSB first (usual)", "LSB first"],
      clk: "SCK clock (MHz)",
      n: "Bytes to send",
      res: "Results",
      k: { cp: "CPOL · CPHA", idle: "SCK idle level", sample: "Sample (read) edge", shift: "Shift (change) edge", first: "First bit appears", time: "Transfer time (no gaps between bytes)", rate: "Throughput" },
      legend: ["Sample edge", "Shift edge"],
      how: "Drawing and maths run in your browser; nothing you type is sent anywhere.",
      mTitle: "Mode table",
      mHead: ["Mode", "CPOL", "CPHA", "Idle SCK", "Sample", "Shift"],
      nTitle: "Vendor notations",
      nHead: ["Mode", "Generic (CPOL/CPHA)", "Linux spidev", "Arduino SPI", "TI MSP430 USCI", "Microchip PIC MSSP"],
      nNote: "MSP430 UCCKPH and PIC CKE are the inverse of CPHA — UCCKPH = 1 or CKE = 1 means «capture on the first edge» (CPHA 0). Check against the register description in the datasheet (which edge captures, which edge changes).",
      wTitle: "What CPHA means",
      w: [
        "CPOL is the SCK level while idle (0 = low, 1 = high). The idle → active edge is the «leading edge», the return is the «trailing edge».",
        "CPHA 0: sample on the leading edge, change on the trailing edge. So the first bit must already be on the line before the first edge — as soon as CS goes low.",
        "CPHA 1: put the bit out on the leading edge and sample on the trailing edge.",
        "If the two sides use different modes, bits shift by one position or only the first byte is wrong. Pick the mode from the device datasheet timing diagram: SCK idle level and which SCK edge latches data.",
      ],
      faqTitle: "FAQ",
      faq: [
        ["Which mode is most common?", "Modes 0 and 3. Both sample on the rising edge, so many devices accept either. The device datasheet timing diagram is the authority."],
        ["My read data is shifted by one bit", "Likely causes: CPHA differs from the device, the clock is too fast for the device's output delay on MISO, long wiring. Lower the clock and see if it persists."],
        ["Do I raise CS after every byte?", "Depends on the device. Devices that take a multi-byte command (flash memory, for example) need CS held low for the whole command. This drawing keeps CS low across all bytes."],
      ],
      srcTitle: "Sources",
      more: "For UART, I2C and CAN:",
    };
const ld = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: L.faq.map(([q, a]) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a } })),
};
const SRC = [
  { name: "The Linux Kernel documentation, «Overview of Linux kernel SPI support» — CPOL, CPHA, SPI modes 0–3", href: "https://www.kernel.org/doc/html/latest/spi/spi-summary.html" },
  { name: "Texas Instruments SLAU208 «MSP430x5xx and MSP430x6xx Family User's Guide» — USCI SPI mode, UCCKPH/UCCKPL", href: "https://www.ti.com/lit/pdf/slau208" },
  { name: "Arduino AVR core, libraries/SPI/src/SPI.h — SPI_MODE0 to SPI_MODE3", href: "https://github.com/arduino/ArduinoCore-avr/blob/master/libraries/SPI/src/SPI.h" },
];
---

<Base lang={lang} title={L.title} seoTitle={ko ? "SPI 모드 0·1·2·3 — CPOL·CPHA 파형 그리기 — PortDock" : "SPI Modes 0–3: CPOL & CPHA Timing Diagram — PortDock"} description={L.desc} path={PATH} ads>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <header class="page-head">
    <div class="wrap">
      <Crumbs lang={lang} items={[{ name: ko ? "웹 도구" : "Web tools", path: "tools/" }, { name: L.title, path: PATH }]} />
      <h1>{L.title}</h1>
      <p>{L.desc}</p>
    </div>
  </header>
  <div class="wrap" style="padding-top:24px">
    <form class="calc card" id="sp">
      <div class="row">
        <label class="fld">{L.mode}<select id="mode">{[0, 1, 2, 3].map((m) => <option value={m} selected={m === 0}>{`${m} — CPOL ${m >> 1}, CPHA ${m & 1}`}</option>)}</select></label>
        <label class="fld">{L.order}<select id="order"><option value="msb" selected>{L.orders[0]}</option><option value="lsb">{L.orders[1]}</option></select></label>
      </div>
      <div class="row">
        <label class="fld">{L.mosi}<input id="mosi" class="mono" value="9F" spellcheck="false" autocomplete="off" /></label>
        <label class="fld">{L.miso}<input id="miso" class="mono" value="" spellcheck="false" autocomplete="off" /></label>
      </div>
      <p class="err" id="err" role="alert"></p>
      <div class="tbl spi-fig" id="fig" aria-live="polite"></div>
      <p class="note spi-legend"><span class="sw s"></span>{L.legend[0]} <span class="sw h"></span>{L.legend[1]}</p>
      <div class="row">
        <label class="fld">{L.clk}<input id="clk" class="mono" value="1" inputmode="decimal" spellcheck="false" autocomplete="off" /></label>
        <label class="fld">{L.n}<input id="n" class="mono" value="256" inputmode="numeric" spellcheck="false" autocomplete="off" /></label>
      </div>
      <div class="tbl">
        <table class="t kv">
          <caption class="note" style="text-align:left">{L.res}</caption>
          <tbody>{(["cp", "idle", "sample", "shift", "first", "time", "rate"] as const).map((id) => <tr><td>{L.k[id]}</td><td class="mono" data-k={id}></td></tr>)}</tbody>
        </table>
      </div>
      <p class="note">{L.how}</p>
    </form>

    <AdSlot />

    <section class="prose">
      <h2>{L.mTitle}</h2>
      <div class="tbl">
        <table class="t">
          <thead><tr>{L.mHead.map((h) => <th>{h}</th>)}</tr></thead>
          <tbody>
            {
              [0, 1, 2, 3].map((m) => {
                const i = modeInfo(m);
                return (
                  <tr>
                    <td class="mono">{m}</td>
                    <td class="mono">{i.cpol}</td>
                    <td class="mono">{i.cpha}</td>
                    <td>{i.cpol ? "High" : "Low"}</td>
                    <td>{edgeName(i.sample)}</td>
                    <td>{edgeName(i.shift)}</td>
                  </tr>
                );
              })
            }
          </tbody>
        </table>
      </div>
      <h2>{L.nTitle}</h2>
      <div class="tbl">
        <table class="t">
          <thead><tr>{L.nHead.map((h) => <th>{h}</th>)}</tr></thead>
          <tbody>
            {
              [0, 1, 2, 3].map((m) => {
                const n = notations(m);
                return (
                  <tr>
                    <td class="mono">{m}</td>
                    <td class="mono">{n.generic}</td>
                    <td class="mono">{n.linux}</td>
                    <td class="mono">{n.arduino}</td>
                    <td class="mono">{n.msp430}</td>
                    <td class="mono">{n.pic}</td>
                  </tr>
                );
              })
            }
          </tbody>
        </table>
      </div>
      <p>{L.nNote}</p>
      <h2>{L.wTitle}</h2>
      <ul>{L.w.map((x) => <li>{x}</li>)}</ul>
      <h2>{L.faqTitle}</h2>
      {
        L.faq.map(([q, a]) => (
          <>
            <h3>{q}</h3>
            <p>{a}</p>
          </>
        ))
      }
      <p>
        {L.more} <a href={url(lang, "tools/uart-waveform/")}>{ko ? "UART 파형 그리기" : "UART Waveform Drawer"}</a> · <a href={url(lang, "tools/i2c/")}>{ko ? "I2C 도구" : "I2C Tools"}</a> · <a href={url(lang, "tools/can-decoder/")}>{ko ? "CAN 프레임 해석기" : "CAN Frame Decoder"}</a>
      </p>
      <h2>{L.srcTitle}</h2>
      <ul>{SRC.map((s) => <li><a href={s.href} rel="noopener" target="_blank">{s.name}</a></li>)}</ul>
    </section>
    <UseNotice lang={lang} />
    <WebToolLinks lang={lang} path={PATH} />
  </div>
  <style>
    .spi-fig :global(svg) {
      display: block;
      min-width: 560px;
      width: 100%;
      height: auto;
      color: var(--ink);
    }
    .spi-legend .sw {
      display: inline-block;
      width: 14px;
      height: 3px;
      vertical-align: middle;
      margin: 0 4px 0 10px;
    }
    .spi-legend .sw.s {
      background: var(--accent);
    }
    .spi-legend .sw.h {
      background: var(--muted);
    }
  </style>
  <script>
    import { modeInfo, parseBytes, transferTime, wave } from "../lib/spi";
    const ko = document.documentElement.lang === "ko";
    const $ = <E extends HTMLElement = HTMLInputElement>(id: string) => document.getElementById(id) as E;
    const form = $<HTMLFormElement>("sp");
    const NS = "http://www.w3.org/2000/svg";
    const mk = (tag: string, attrs: Record<string, string | number>, text?: string) => {
      const e = document.createElementNS(NS, tag);
      for (const [k, v] of Object.entries(attrs)) e.setAttribute(k, String(v));
      if (text !== undefined) e.textContent = text;
      return e;
    };
    const set = (k: string, v: string) => {
      const td = form.querySelector<HTMLElement>(`td[data-k="${k}"]`);
      if (td) td.textContent = v;
    };
    const edge = (e: string) => (ko ? (e === "rising" ? "상승 ↑" : "하강 ↓") : e === "rising" ? "rising ↑" : "falling ↓");
    const si = (s: number) =>
      s >= 1 ? `${+s.toFixed(4)} s` : s >= 1e-3 ? `${+(s * 1e3).toFixed(4)} ms` : `${+(s * 1e6).toFixed(3)} µs`;

    function draw(mosi: number[], miso: number[] | null, mode: number, msb: boolean) {
      const w = wave(mosi, mode, msb);
      const wm = miso ? wave(miso, mode, msb) : null;
      const U = 14; // 반 주기 폭(px)
      const X0 = 60;
      const lead = 2; // 앞 여유(반 주기)
      const width = X0 + (w.len + lead + 1) * U;
      const rows = { cs: 30, sck: 80, mosi: 130, miso: 180 };
      const A = 26; // 높이
      const height = 210;
      const x = (t: number) => X0 + (t + lead) * U;
      const svg = mk("svg", { viewBox: `0 0 ${width} ${height}`, role: "img", "aria-label": ko ? `SPI 모드 ${mode} 파형` : `SPI mode ${mode} waveform` });
      svg.append(mk("rect", { x: 0, y: 0, width, height, fill: "none" }));
      // 엣지 세로선
      for (const e of w.edges) {
        svg.append(
          mk("line", {
            x1: x(e.t), x2: x(e.t), y1: rows.cs - A - 4, y2: rows.miso + 6,
            stroke: e.action === "sample" ? "var(--accent)" : "var(--muted)",
            "stroke-width": e.action === "sample" ? 1.4 : 1,
            "stroke-dasharray": e.action === "sample" ? "" : "3 3",
            opacity: e.action === "sample" ? 0.8 : 0.6,
          }),
        );
      }
      const label = (y: number, s: string) => svg.append(mk("text", { x: 6, y: y - A / 2 + 5, "font-size": 13, fill: "currentColor", "font-family": "monospace" }, s));
      const step = (pts: [number, number][], y: number, endT: number) => {
        // pts: (t, level) — 레벨 0 = y, 1 = y − A
        let d = "";
        const yy = (l: number) => y - l * A;
        pts.forEach(([t, l], i) => {
          d += i === 0 ? `M${x(-lead)},${yy(l)} ` : `L${x(t)},${yy(pts[i - 1][1])} L${x(t)},${yy(l)} `;
        });
        d += `L${x(endT)},${yy(pts[pts.length - 1][1])}`;
        svg.append(mk("path", { d, fill: "none", stroke: "currentColor", "stroke-width": 1.8 }));
      };
      const end = w.len + 1;
      // CS
      label(rows.cs, "CS");
      step([[-lead, 1], [0, 0], [w.csUp, 1]], rows.cs, end);
      // SCK
      label(rows.sck, "SCK");
      step(w.sck.map(([t, l]) => [t === 0 ? -lead : t, l] as [number, number]), rows.sck, end);
      // 데이터 줄: 비트 칸마다 레벨, 바깥은 Hi-Z(가운데 선)
      const data = (y: number, name: string, ww: typeof w | null) => {
        label(y, name);
        const mid = y - A / 2;
        if (!ww) {
          // 모름 — 비트 칸만 육각으로
          for (const b of w.bits) {
            const x0 = x(b.t0);
            const x1 = x(b.t1);
            svg.append(mk("path", { d: `M${x0},${mid} L${x0 + 3},${y - A} L${x1 - 3},${y - A} L${x1},${mid} L${x1 - 3},${y} L${x0 + 3},${y} Z`, fill: "none", stroke: "currentColor", "stroke-width": 1.2, opacity: 0.5 }));
          }
          svg.append(mk("line", { x1: x(-lead), x2: x(w.bits[0].t0), y1: mid, y2: mid, stroke: "currentColor", "stroke-dasharray": "2 3", opacity: 0.6 }));
          svg.append(mk("line", { x1: x(w.bits[w.bits.length - 1].t1), x2: x(end), y1: mid, y2: mid, stroke: "currentColor", "stroke-dasharray": "2 3", opacity: 0.6 }));
          return;
        }
        svg.append(mk("line", { x1: x(-lead), x2: x(ww.bits[0].t0), y1: mid, y2: mid, stroke: "currentColor", "stroke-dasharray": "2 3", opacity: 0.6 }));
        let d = "";
        ww.bits.forEach((b, i) => {
          const yy = y - b.v * A;
          const prev = i ? y - ww.bits[i - 1].v * A : mid;
          d += `${i ? "L" : "M"}${x(b.t0)},${prev} L${x(b.t0)},${yy} L${x(b.t1)},${yy} `;
          svg.append(mk("text", { x: (x(b.t0) + x(b.t1)) / 2, y: y + 13, "font-size": 10, "text-anchor": "middle", fill: "currentColor", opacity: 0.75, "font-family": "monospace" }, String(b.v)));
        });
        const lastB = ww.bits[ww.bits.length - 1];
        d += `L${x(lastB.t1)},${mid}`;
        svg.append(mk("path", { d, fill: "none", stroke: "currentColor", "stroke-width": 1.8 }));
        svg.append(mk("line", { x1: x(lastB.t1), x2: x(end), y1: mid, y2: mid, stroke: "currentColor", "stroke-dasharray": "2 3", opacity: 0.6 }));
      };
      data(rows.mosi, "MOSI", w);
      data(rows.miso, "MISO", wm);
      // 바이트 경계 표시
      for (let k = 1; k * 8 < w.bits.length; k++) {
        const b = w.bits[k * 8];
        svg.append(mk("text", { x: x(b.t0) + 2, y: rows.cs - A - 6, "font-size": 10, fill: "currentColor", opacity: 0.7 }, ko ? `${k + 1}번째 바이트` : `byte ${k + 1}`));
      }
      return svg;
    }

    function run() {
      const fig = $("fig");
      fig.replaceChildren();
      try {
        const mode = Number($<HTMLSelectElement>("mode").value);
        const msb = $<HTMLSelectElement>("order").value === "msb";
        let mosi = parseBytes($("mosi").value);
        if (!mosi.length) mosi = [0];
        mosi = mosi.slice(0, 4);
        const misoIn = parseBytes($("miso").value).slice(0, 4);
        const miso = misoIn.length ? Array.from({ length: mosi.length }, (_, i) => misoIn[i] ?? 0) : null;
        fig.append(draw(mosi, miso, mode, msb));
        const m = modeInfo(mode);
        set("cp", `${m.cpol} · ${m.cpha}`);
        set("idle", m.cpol ? "High" : "Low");
        set("sample", edge(m.sample));
        set("shift", edge(m.shift));
        set("first", m.cpha === 0 ? (ko ? "CS 가 내려갈 때(첫 엣지 전)" : "When CS goes low (before the first edge)") : ko ? "첫 SCK 엣지에서" : "On the first SCK edge");
        const hz = Number($("clk").value.replace(",", ".")) * 1e6;
        const n = Number($("n").value);
        if (hz > 0 && n >= 0 && Number.isFinite(hz) && Number.isFinite(n)) {
          const t = transferTime(n, hz);
          set("time", si(t));
          set("rate", `${+(hz / 8 / 1000).toFixed(3)} kB/s`);
        } else {
          set("time", "");
          set("rate", "");
        }
        $("err").textContent = "";
      } catch {
        $("err").textContent = ko ? "HEX 바이트를 확인하세요(예: 9F 00 00)" : "Check the hex bytes (e.g. 9F 00 00)";
      }
    }
    form.addEventListener("input", run);
    form.addEventListener("change", run);
    form.addEventListener("submit", (e) => e.preventDefault());
    run();
  </script>
</Base>
