---
// 웹 도구: 분압 저항 계산기 — 출력 전압·R 풀기·E12/E24/E96 표준 값 조합·부하·허용차(lib/divider.ts).
// 표준 값은 Vishay 28372(IEC 60063 표)에서 옮긴 것만, ADC 입력 권장 임피던스는 ATmega328P §23.6.1 문장 그대로.
import Base from "../layouts/Base.astro";
import AdSlot from "../components/AdSlot.astro";
import Crumbs from "../components/Crumbs.astro";
import WebToolLinks from "../components/WebToolLinks.astro";
import UseNotice from "../components/UseNotice.astro";
import { E_BASE } from "../lib/divider";
import { type Lang } from "../data/tools";
import { url } from "../lib/i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const ko = lang === "ko";
const PATH = "tools/voltage-divider/";
const L = ko
  ? {
      title: "분압 저항 계산기 (E12·E24·E96)",
      desc: "입력·출력 전압으로 분압 저항을 구하고 E12·E24·E96 표준 저항 값 조합을 오차순으로 고릅니다. 부하 저항, 흐르는 전류·전력, 출력 저항, 허용차 범위까지.",
      vin: "입력 전압 Vin (V)",
      vout: "원하는 출력 Vout (V)",
      ser: "저항 계열",
      tot: "합계 저항 대략 (kΩ) — 조합을 찾을 범위",
      pairs: "표준 값 조합 (오차가 작은 순)",
      pHead: ["R1 (위)", "R2 (아래)", "출력", "오차"],
      chk: "고른 저항으로 확인",
      r1: "R1 위, 입력 쪽 (kΩ)",
      r2: "R2 아래, GND 쪽 (kΩ)",
      rl: "부하 저항 RL (kΩ, 없으면 비움)",
      tol: "허용차 ± % (저항 데이터시트)",
      res: "결과",
      k: { r2i: "R1 에 맞는 이상적인 R2", vout: "출력 전압 (부하 없음)", vl: "출력 전압 (부하 RL)", ratio: "분압비 Vout ÷ Vin", i: "흐르는 전류", p: "저항 전력 R1 / R2", rout: "출력 저항 R1 ∥ R2", tol: "허용차로 본 출력 범위" },
      example: "기본값(10 V → 3.3 V, 합계 약 10 kΩ)은 0–10 V 신호를 3.3 V ADC 로 받는 예시입니다. 실제 회로에서는 ADC 입력 임피던스·보호 소자·필터 콘덴서도 함께 봅니다.",
      how: "값을 바꾸면 바로 다시 계산합니다. 계산은 이 브라우저 안에서만 하고, 입력한 값은 어디에도 보내지 않습니다.",
      fTitle: "계산식",
      formula: [
        "Vout = Vin × R2 ÷ (R1 + R2)",
        "R2 = R1 × Vout ÷ (Vin − Vout),   R1 = R2 × (Vin − Vout) ÷ Vout",
        "부하가 있으면 R2 자리에 R2 ∥ RL = R2 × RL ÷ (R2 + RL)",
        "전류 I = Vin ÷ (R1 + R2),   전력 P = I² × R",
        "출력 저항(테브난) = R1 ∥ R2",
      ],
      eTitle: "E12·E24·E96 표준 저항 값",
      e: [
        "저항은 아무 값이나 팔지 않고, 한 decade(10배 구간)를 등비로 나눈 표준 값으로 나옵니다. IEC 60063 이 정한 계열이며 E12 는 12개, E24 는 24개, E96 은 96개 값입니다. 계열이 촘촘할수록 이웃 값의 간격이 좁아 원하는 값에 가까운 저항을 고를 수 있습니다. 어느 계열을 어떤 허용차로 파는지는 저항 제조사의 데이터시트에서 확인합니다.",
        "E96 의 값은 모두 10^(i/96) 를 세 자리로 반올림한 값과 같지만, E24 는 27·30·33·36·39·43·47·82 가 계산값(26·29·32·35·38·42·46·83)과 다릅니다. 그래서 계산으로 만들지 말고 표를 그대로 써야 합니다 — 이 계산기는 Vishay 의 IEC 60063 표에서 옮긴 값을 씁니다.",
        "두 표준 값으로는 원하는 비가 정확히 나오지 않는 경우가 많습니다. 위 «표준 값 조합» 은 R2 를 표준 값으로 훑으면서 필요한 R1 의 바로 위·아래 표준 값을 맞춰 보고 오차가 작은 순으로 보여 줍니다.",
      ],
      e24Title: "E24 값 (E12 는 굵게)",
      e96Title: "E96 값",
      lTitle: "부하와 ADC 입력",
      l: [
        "분압 출력에 무언가를 이으면 그 입력 저항이 R2 와 병렬이 되어 출력이 내려갑니다. 부하 저항이 R2 보다 충분히 크지 않으면 «부하 RL» 칸에 넣어 확인합니다.",
        "MCU ADC 는 샘플링 순간에 내부 콘덴서를 충전해야 합니다. ATmega328P 데이터시트(§23.6.1)는 ADC 가 «출력 임피던스 약 10 kΩ 이하» 의 신호에 맞춰져 있고, 더 높으면 샘플링 시간이 소스가 S/H 콘덴서(14 pF)를 충전하는 시간에 달려 크게 달라진다고 적습니다. 분압의 출력 저항(R1 ∥ R2)을 이 범위로 두거나, 출력에 콘덴서·버퍼를 둡니다.",
        "합계 저항을 낮추면 출력 저항은 작아지지만 전류와 발열이 늘어납니다. 24 V 를 1 kΩ + 1 kΩ 으로 나누면 12 mA, 저항 하나에 144 mW 입니다 — 저항의 정격 전력도 봅니다.",
      ],
      tTitle: "허용차",
      t: "저항 두 개가 허용차 끝에서 서로 반대로 어긋나면 출력이 가장 크게 바뀝니다. 같은 값 두 개(1/2 분압)를 ±1 % 로 쓰면 출력은 약 ±1 % 흔들립니다. 그보다 정밀해야 하면 더 좁은 허용차의 저항을 쓰거나, 소프트웨어에서 실측값으로 보정합니다.",
      faqTitle: "자주 묻는 것",
      faq: [
        ["10 V 를 3.3 V 로 줄이려면 어떤 저항을 쓰나요?", "E12 에서는 R1 6.8 kΩ, R2 3.3 kΩ 이 약 3.267 V(−1.0 %)로 가장 가깝습니다. E96 이면 R1 10.2 kΩ, R2 4.99 kΩ 처럼 오차 0.5 % 안의 조합이 여럿 나옵니다."],
        ["5 V 를 3.3 V 로 바꿀 때도 분압을 쓰나요?", "느리게 변하는 신호(아날로그 전압)라면 분압으로 충분합니다. 빠른 디지털 신호나 양방향 신호는 분압의 출력 저항과 입력 용량 때문에 모서리가 무뎌지므로 레벨 변환 소자를 쓰는 경우가 많습니다."],
        ["E 계열 값은 왜 1, 1.2, 1.5, 1.8 … 처럼 나가나요?", "한 decade 를 같은 비율로 나눈 등비 수열이라, 이웃한 값 사이가 늘 비슷한 % 간격이 되기 때문입니다. E12 는 이웃 값이 약 21 %, E96 은 약 2.4 % 차이입니다."],
        ["분압 대신 저항 하나로 전류 신호를 전압으로 바꿀 수 있나요?", "4–20 mA 는 션트 저항 하나로 바꿉니다(250 Ω → 1–5 V). 그 경우 ADC 쪽 환산은 ADC 분해능 계산기에서 볼 수 있습니다."],
      ],
      adcNote: "ADC 코드와 공학값 환산은",
      adcLink: "ADC 분해능·스케일링 계산기",
      ntcNote: "NTC 서미스터 분압은",
      ntcLink: "NTC 서미스터 계산기",
      rpNote: "비가 아니라 저항 하나의 값을 두 개로 맞추려면",
      rpLink: "합성 저항 계산기 (직렬·병렬)",
      srcTitle: "출처",
    }
  : {
      title: "Voltage Divider Calculator (E12, E24, E96)",
      desc: "Divider resistors for a target output voltage and the closest E12, E24 or E96 standard pairs. Load resistance, current, power, output impedance, tolerance.",
      vin: "Input voltage Vin (V)",
      vout: "Target output Vout (V)",
      ser: "Resistor series",
      tot: "Approximate total resistance (kΩ) — search range",
      pairs: "Standard-value pairs (smallest error first)",
      pHead: ["R1 (top)", "R2 (bottom)", "Output", "Error"],
      chk: "Check the chosen resistors",
      r1: "R1 top, input side (kΩ)",
      r2: "R2 bottom, GND side (kΩ)",
      rl: "Load resistance RL (kΩ, blank for none)",
      tol: "Tolerance ± % (resistor datasheet)",
      res: "Results",
      k: { r2i: "Ideal R2 for this R1", vout: "Output voltage (no load)", vl: "Output voltage (with RL)", ratio: "Ratio Vout ÷ Vin", i: "Current", p: "Resistor power R1 / R2", rout: "Output impedance R1 ∥ R2", tol: "Output range from tolerance" },
      example: "The defaults (10 V → 3.3 V, about 10 kΩ total) are an example: a 0–10 V signal into a 3.3 V ADC. In a real circuit also consider the ADC input impedance, protection parts and any filter capacitor.",
      how: "Results update as you type. Everything runs in your browser; nothing you type is sent anywhere.",
      fTitle: "Formulas",
      formula: [
        "Vout = Vin × R2 ÷ (R1 + R2)",
        "R2 = R1 × Vout ÷ (Vin − Vout),   R1 = R2 × (Vin − Vout) ÷ Vout",
        "With a load, replace R2 by R2 ∥ RL = R2 × RL ÷ (R2 + RL)",
        "Current I = Vin ÷ (R1 + R2),   power P = I² × R",
        "Output (Thévenin) impedance = R1 ∥ R2",
      ],
      eTitle: "E12, E24 and E96 standard resistor values",
      e: [
        "Resistors come in standard values that split each decade geometrically. The series are defined in IEC 60063: E12 has 12 values, E24 has 24, E96 has 96. The denser the series, the closer neighbours are, so you can get nearer the value you want. Which series a maker sells in which tolerance is in the resistor datasheet.",
        "Every E96 value equals 10^(i/96) rounded to three digits, but in E24 the values 27, 30, 33, 36, 39, 43, 47 and 82 differ from the computed ones (26, 29, 32, 35, 38, 42, 46, 83). So use the table, not a formula — this calculator uses the values from Vishay's IEC 60063 table.",
        "Two standard values rarely give the exact ratio. «Standard-value pairs» above sweeps R2 through the series, tries the standard values just below and above the R1 it needs, and lists the pairs by error.",
      ],
      e24Title: "E24 values (E12 in bold)",
      e96Title: "E96 values",
      lTitle: "Loading and ADC inputs",
      l: [
        "Whatever you connect to the output appears in parallel with R2 and pulls the output down. If the load is not much larger than R2, enter it under «Load resistance RL».",
        "An MCU ADC must charge an internal capacitor at each sample. The ATmega328P datasheet (§23.6.1) says its ADC «is optimized for analog signals with an output impedance of approximately 10 kΩ or less»; above that, the sampling time depends on how long the source takes to charge the 14 pF S/H capacitor. Keep the divider's output impedance (R1 ∥ R2) in that range, or add a capacitor or buffer at the output.",
        "A lower total resistance lowers the output impedance but raises current and heat: 24 V across 1 kΩ + 1 kΩ is 12 mA and 144 mW per resistor — check the power rating too.",
      ],
      tTitle: "Tolerance",
      t: "The output moves most when the two resistors sit at opposite ends of their tolerance. Two equal ±1 % resistors (a 1/2 divider) give about ±1 % on the output. For better accuracy use tighter parts or calibrate in software with measured values.",
      faqTitle: "FAQ",
      faq: [
        ["Which resistors turn 10 V into 3.3 V?", "In E12, R1 6.8 kΩ and R2 3.3 kΩ give about 3.267 V (−1.0 %), the closest pair. In E96 several pairs land within 0.5 %, for example R1 10.2 kΩ and R2 4.99 kΩ."],
        ["Can I use a divider for 5 V to 3.3 V?", "For slowly changing analog voltages, yes. Fast or bidirectional digital signals suffer from the divider's output impedance and the input capacitance, so a level shifter is common there."],
        ["Why do E-series values go 1, 1.2, 1.5, 1.8…?", "They are a geometric sequence across a decade, so neighbours are always a similar percentage apart: about 21 % in E12 and about 2.4 % in E96."],
        ["Can one resistor turn a current signal into a voltage?", "A 4–20 mA signal uses a single shunt resistor (250 Ω → 1–5 V). For the ADC side of that, use the ADC resolution calculator."],
      ],
      adcNote: "For ADC counts and engineering units, use the",
      adcLink: "ADC Resolution & Scaling Calculator",
      ntcNote: "For NTC thermistor dividers, use the",
      ntcLink: "NTC Thermistor Calculator",
      rpNote: "To make one resistance value from two resistors (rather than a ratio), use the",
      rpLink: "Parallel & Series Resistor Calculator",
      srcTitle: "Sources",
    };
const ld = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: L.faq.map(([q, a]) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a } })),
};
const SRC = [
  { name: "Vishay, Standard Series Values in a Decade for Resistances and Capacitances, E3 to E192, according to IEC 60063 (Document 28372, Rev. 22-Aug-12)", href: "https://www.vishay.com/docs/28372/e-series.pdf" },
  { name: "Microchip, ATmega328P datasheet (7810D, 01/2015): §23.6.1 Analog Input Circuitry", href: "https://ww1.microchip.com/downloads/en/DeviceDoc/Atmel-7810-Automotive-Microcontrollers-ATmega328P_Datasheet.pdf" },
];
const e12 = new Set(E_BASE.E12);
const e96rows: number[][] = [];
for (let i = 0; i < 96; i += 12) e96rows.push(E_BASE.E96.slice(i, i + 12).map((v) => v / 100));
---

<Base lang={lang} title={L.title} seoTitle={ko ? "분압 저항 계산기 — E12·E24·E96 표준값·부하 — PortDock" : "Voltage Divider Calculator: E12, E24, E96 Resistors — PortDock"} description={L.desc} path={PATH} ads>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <header class="page-head">
    <div class="wrap">
      <Crumbs lang={lang} items={[{ name: ko ? "웹 도구" : "Web tools", path: "tools/" }, { name: L.title, path: PATH }]} />
      <h1>{L.title}</h1>
      <p>{L.desc}</p>
    </div>
  </header>
  <div class="wrap" style="padding-top:24px">
    <form class="calc card" id="vd">
      <div class="row">
        <label class="fld">{L.vin}<input id="vin" class="mono" value="10" inputmode="decimal" spellcheck="false" autocomplete="off" /></label>
        <label class="fld">{L.vout}<input id="vout" class="mono" value="3.3" inputmode="decimal" spellcheck="false" autocomplete="off" /></label>
        <label class="fld">{L.ser}<select id="ser"><option value="E12">E12</option><option value="E24" selected>E24</option><option value="E96">E96</option></select></label>
        <label class="fld">{L.tot}<input id="tot" class="mono" value="10" inputmode="decimal" spellcheck="false" autocomplete="off" /></label>
      </div>
      <p class="err" id="err" role="alert"></p>
      <div class="tbl" aria-live="polite">
        <table class="t">
          <caption class="note" style="text-align:left">{L.pairs}</caption>
          <thead><tr>{L.pHead.map((h) => <th>{h}</th>)}</tr></thead>
          <tbody id="pairs"></tbody>
        </table>
      </div>
      <h2>{L.chk}</h2>
      <div class="row">
        <label class="fld">{L.r1}<input id="r1" class="mono" value="6.8" inputmode="decimal" spellcheck="false" autocomplete="off" /></label>
        <label class="fld">{L.r2}<input id="r2" class="mono" value="3.3" inputmode="decimal" spellcheck="false" autocomplete="off" /></label>
        <label class="fld">{L.rl}<input id="rl" class="mono" value="" inputmode="decimal" spellcheck="false" autocomplete="off" /></label>
        <label class="fld">{L.tol}<input id="tol" class="mono" value="5" inputmode="decimal" spellcheck="false" autocomplete="off" /></label>
      </div>
      <p class="err" id="err2" role="alert"></p>
      <div class="tbl" aria-live="polite">
        <table class="t kv">
          <caption class="note" style="text-align:left">{L.res}</caption>
          <tbody>{Object.entries(L.k).map(([id, name]) => <tr><td>{name}</td><td class="mono" data-k={id}></td></tr>)}</tbody>
        </table>
      </div>
      <p class="note">{L.example}</p>
      <p class="note">{L.how}</p>
    </form>

    <AdSlot />

    <section class="prose">
      <h2>{L.fTitle}</h2>
      <ul>{L.formula.map((f) => <li class="mono">{f}</li>)}</ul>
      <h2>{L.eTitle}</h2>
      <ul>{L.e.map((x) => <li>{x}</li>)}</ul>
      <h3>{L.e24Title}</h3>
      <p class="mono">{E_BASE.E24.map((v, i) => <>{i > 0 && " · "}{e12.has(v) ? <b>{(v / 10).toFixed(1)}</b> : (v / 10).toFixed(1)}</>)}</p>
      <h3>{L.e96Title}</h3>
      <div class="tbl">
        <table class="t">
          <tbody>{e96rows.map((r) => <tr>{r.map((c) => <td class="mono">{c.toFixed(2)}</td>)}</tr>)}</tbody>
        </table>
      </div>
      <h2>{L.lTitle}</h2>
      <ul>{L.l.map((x) => <li>{x}</li>)}</ul>
      <h2>{L.tTitle}</h2>
      <p>{L.t}</p>
      <h2>{L.faqTitle}</h2>
      {
        L.faq.map(([q, a]) => (
          <>
            <h3>{q}</h3>
            <p>{a}</p>
          </>
        ))
      }
      <p>
        {L.adcNote} <a href={url(lang, "tools/adc/")}>{L.adcLink}</a>. {L.ntcNote} <a href={url(lang, "tools/ntc/")}>{L.ntcLink}</a>. {L.rpNote} <a href={url(lang, "tools/parallel-resistor/")}>{L.rpLink}</a>.
      </p>
      <h2>{L.srcTitle}</h2>
      <ul>{SRC.map((s) => <li><a href={s.href} rel="noopener" target="_blank">{s.name}</a></li>)}</ul>
    </section>
    <UseNotice lang={lang} />
    <WebToolLinks lang={lang} path={PATH} />
  </div>
  <script>
    import { bestPairs, divOut, solveR2, tolRange, type ESeries } from "../lib/divider";
    const ko = document.documentElement.lang === "ko";
    const form = document.getElementById("vd") as HTMLFormElement;
    const $ = <E extends HTMLElement = HTMLInputElement>(id: string) => document.getElementById(id) as E;
    const num = (id: string) => {
      const s = $(id).value.trim().replace(",", ".");
      // 빈칸·글자·아주 큰 수(1e12 넘음)는 «값 없음» 으로 — 결과에 Infinity·NaN 이 보이지 않게
      const n = s === "" ? NaN : Number(s);
      return Math.abs(n) > 1e12 ? NaN : n;
    };
    const set = (k: string, v: string) => {
      const td = form.querySelector<HTMLElement>(`td[data-k="${k}"]`);
      if (td) td.textContent = v;
    };
    const fx = (x: number, d: number) => {
      const s = x.toFixed(d);
      return s.includes(".") ? s.replace(/\.?0+$/, "") : s;
    };
    const ohm = (r: number) => (r >= 1e6 ? `${fx(r / 1e6, 3)} MΩ` : r >= 1e3 ? `${fx(r / 1e3, 3)} kΩ` : `${fx(r, 2)} Ω`);
    const amp = (i: number) => (i >= 1e-3 ? `${fx(i * 1e3, 3)} mA` : `${fx(i * 1e6, 2)} µA`);
    const watt = (p: number) => (p >= 1 ? `${fx(p, 3)} W` : `${fx(p * 1e3, 3)} mW`);
    function run() {
      const vin = num("vin");
      const vout = num("vout");
      const tbody = $("pairs");
      tbody.textContent = "";
      try {
        const ps = bestPairs(vin, vout, $<HTMLSelectElement>("ser").value as ESeries, num("tot") * 1000, 6);
        for (const p of ps) {
          const tr = document.createElement("tr");
          for (const c of [ohm(p.r1), ohm(p.r2), `${fx(p.vout, 4)} V`, `${p.err >= 0 ? "+" : ""}${fx(p.err, 2)} %`]) {
            const td = document.createElement("td");
            td.className = "mono";
            td.textContent = c;
            tr.append(td);
          }
          tbody.append(tr);
        }
        // 비가 아주 작거나 크면(예: 1000 V → 1 mV) 합계 범위 안에 조합이 없다 — 빈 표만 남기지 않는다(10/23)
        $("err").textContent = ps.length ? "" : ko ? "이 합계 저항 범위(⅓ ~ 3배)에서는 맞는 조합이 없습니다 — 합계 저항이나 전압을 바꿔 보세요" : "No pair fits this total-resistance range (⅓ to 3×) — change the total or the voltages";
      } catch {
        $("err").textContent = ko ? "숫자를 확인하세요 — 출력은 0 보다 크고 입력보다 작아야 합니다" : "Check the numbers — the output must be above 0 and below the input";
      }
      try {
        const r1 = num("r1") * 1000;
        const r2 = num("r2") * 1000;
        const rlk = num("rl");
        const rl = Number.isFinite(rlk) && rlk > 0 ? rlk * 1000 : Infinity;
        const r = divOut(vin, r1, r2);
        try {
          set("r2i", ohm(solveR2(vin, vout, r1)));
        } catch {
          set("r2i", "");
        }
        set("vout", `${fx(r.vout, 4)} V`);
        set("vl", Number.isFinite(rl) ? `${fx(divOut(vin, r1, r2, rl).vout, 4)} V` : "");
        set("ratio", fx(r.ratio, 5));
        set("i", amp(r.current));
        set("p", `${watt(r.p1)} / ${watt(r.p2)}`);
        set("rout", ohm(r.rout));
        // 허용차는 0 이상 100 미만만 — 100 % 이상이면 그 칸만 비운다(옛 판은 저항 오류로 표 전체를 지웠다, 10/23)
        const tol = num("tol");
        if (tol >= 0 && tol < 100) {
          const [lo, hi] = tolRange(vin, r1, r2, tol);
          set("tol", `${fx(lo, 4)} ~ ${fx(hi, 4)} V`);
        } else set("tol", "");
        $("err2").textContent = "";
      } catch {
        $("err2").textContent = ko ? "입력 전압과 저항 값을 확인하세요 — 저항은 0 보다 커야 합니다" : "Check the input voltage and resistor values — resistors must be above 0";
        for (const td of form.querySelectorAll<HTMLElement>("td[data-k]")) td.textContent = "";
      }
    }
    form.addEventListener("input", run);
    form.addEventListener("change", run);
    form.addEventListener("submit", (e) => e.preventDefault());
    run();
  </script>
</Base>
