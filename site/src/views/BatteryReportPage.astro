---
// 웹 도구: 노트북 배터리 리포트 해석기 — powercfg /batteryreport 가 만든 battery-report.html 을 끌어 놓으면
// 설계 대비 완전 충전 용량(남은 비율)·충전 횟수·용량 이력 그래프·최근 사용을 보여 준다. 풀이는 lib/batteryReport.ts(시험 있음).
// 파일은 브라우저 안에서만 읽는다(업로드·전송 없음). 리포트 머리(컴퓨터 이름 등)·배터리 이름·일련번호는 읽지도 보이지도 않는다. 광고는 본문 아래에만.
import Base from "../layouts/Base.astro";
import AdSlot from "../components/AdSlot.astro";
import Crumbs from "../components/Crumbs.astro";
import WebToolLinks from "../components/WebToolLinks.astro";
import UseNotice from "../components/UseNotice.astro";
import type { SiteLang } from "../i18n/langs";
import { page3 } from "../i18n";
import { ui, link } from "../lib/i18n";

interface Props {
  lang: SiteLang;
}
const { lang } = Astro.props;
const PATH = "tools/battery-report/";
const CMD = 'powercfg /batteryreport /output "%USERPROFILE%\\Downloads\\battery-report.html"';
const PS = 'powercfg /batteryreport /output "$env:USERPROFILE\\Downloads\\battery-report.html"';
const L =
  lang === "ko"
  ? {
      title: "노트북 배터리 리포트 해석기",
      seo: "배터리 리포트 해석기 — 노트북 배터리 수명 확인 — PortDock",
      desc: "powercfg /batteryreport 로 만든 배터리 리포트(HTML)를 끌어 놓으면 설계 용량 대비 남은 비율·충전 횟수·용량 이력 그래프를 보여 줍니다. 파일은 브라우저 안에서만.",
      step1: "1. 리포트 만들기",
      step1Note: "시작 → «터미널» 또는 «명령 프롬프트» 를 열고(관리자 권한 없이) 아래 명령을 붙여 넣습니다. 다운로드 폴더에 battery-report.html 이 생깁니다.",
      cmd: "명령 프롬프트(cmd)",
      ps: "PowerShell·터미널",
      copy: "복사",
      copied: "복사함",
      step2: "2. 리포트 열기",
      drop: "battery-report.html 을 여기에 끌어 놓거나 눌러서 고르세요",
      dropNote: ".html — 한국어·영어 Windows 리포트",
      sample: "가짜 예시 리포트로 보기",
      sampleKo: "한국어 예시(배터리 2개)",
      privacy: "파일은 이 브라우저 안에서만 읽고 어디에도 보내지 않습니다. 리포트 머리의 컴퓨터 이름·BIOS·OS 와 배터리 이름·제조사·일련번호는 읽지 않습니다.",
      readTitle: "숫자 읽는 법",
      read: [
        ["설계 용량(DESIGN CAPACITY)", "배터리가 새것일 때 담도록 만든 에너지(mWh)입니다."],
        ["완전 충전 용량(FULL CHARGE CAPACITY)", "지금 100 % 로 충전했을 때 실제로 담기는 에너지입니다. 쓰면서 조금씩 줄어듭니다."],
        ["남은 비율", "완전 충전 ÷ 설계 × 100. 노트북이 «100 %» 로 보여도 실제 사용 시간은 이 비율만큼 줄어 있습니다."],
        ["충전 횟수(CYCLE COUNT)", "완전 방전 1회 분량을 1사이클로 셉니다. 배터리가 알려 주지 않으면 «-» 로 나옵니다."],
      ] as [string, string][],
      appTitle: "PortDock 앱으로 더",
      app1: "노트북을 장비·현장 PC 로 쓸 때, 절전·USB 선택적 절전·빠른 시작·업데이트 재시작 정책은",
      app2: "«이 PC» 탭의 «이 PC 설정 읽기» 로 관리자 권한 없이 읽을 수 있습니다(읽기 전용).",
      faqTitle: "자주 묻는 것",
      faq: [
        ["몇 % 면 바꿔야 하나요?", "정해진 기준은 없습니다. 노트북 제조사의 보증·교체 기준을 보세요. 남은 비율과 함께 실제 사용 시간이 일에 충분한지를 보는 것이 현실적입니다."],
        ["«배터리가 없습니다» 라고 나옵니다", "데스크톱처럼 배터리가 없는 PC 에서 만든 리포트이거나, 배터리를 Windows 가 읽지 못한 경우입니다. 리포트 HTML 을 브라우저로 직접 열어 «Installed batteries(설치된 배터리)» 표가 비어 있는지 보세요."],
        ["남은 비율이 100 % 를 넘습니다", "새 배터리는 설계 값보다 조금 크게 측정되기도 합니다. 문제의 표시가 아닙니다."],
        ["며칠 사이에 크게 오르내립니다", "완전 충전 용량은 배터리 관리 칩의 추정치라, 완전히 비우고 채우는 일이 한동안 없으면 값이 갱신되며 출렁일 수 있습니다. 이력 그래프의 큰 흐름을 보세요."],
        ["파일을 어딘가에 올리나요?", "아니요. 파일은 이 브라우저 안에서 글로 읽어 표를 찾을 뿐이고, 서버로 보내지 않습니다."],
      ] as [string, string][],
      msg: {
        notReport: "배터리 리포트로 읽을 표를 찾지 못했습니다 — powercfg /batteryreport 로 만든 HTML 인지, 배터리가 있는 PC 에서 만들었는지 보세요.",
        tooBig: "파일이 너무 큽니다(20 MB 까지).",
        health: "남은 비율(설계 대비)",
        design: "설계 용량",
        full: "완전 충전 용량",
        cycles: "충전 횟수",
        noCycles: "알려 주지 않음",
        battery: "배터리",
        total: "합계",
        histTitle: "용량 이력",
        histNote: "기간마다 완전 충전 용량(실선)과 설계 용량(점선). 가로축은 리포트의 기간 순서입니다(간격이 고르지 않을 수 있음).",
        recentTitle: "최근 사용 (마지막 20개)",
        cols: ["날짜", "시각", "상태", "전원", "남은 %", "mWh"],
        noRecent: "최근 사용 기록이 없습니다.",
        loaded: "읽은 파일",
        sampleNote: "지어낸 예시입니다 — 실제 노트북 값이 아닙니다.",
      },
    }
  : lang === "en"
  ? {
      title: "Laptop Battery Report Reader",
      seo: "Battery Report Reader: Laptop Battery Health Check — PortDock",
      desc: "Drop the powercfg /batteryreport HTML to see remaining capacity vs design, cycle count and a capacity history chart. The file stays in your browser.",
      step1: "1. Create the report",
      step1Note: "Open «Terminal» or «Command Prompt» from Start (no admin rights needed) and paste the command. battery-report.html appears in your Downloads folder.",
      cmd: "Command Prompt (cmd)",
      ps: "PowerShell / Terminal",
      copy: "Copy",
      copied: "Copied",
      step2: "2. Open the report",
      drop: "Drop battery-report.html here, or click to choose it",
      dropNote: ".html — reports from English or Korean Windows",
      sample: "Try a made-up sample report",
      sampleKo: "Korean-format sample (2 batteries)",
      privacy: "The file is read inside this browser and never sent anywhere. The computer name, BIOS and OS in the report header and the battery name, maker and serial number are not read.",
      readTitle: "Reading the numbers",
      read: [
        ["Design capacity", "The energy (mWh) the battery was built to hold when new."],
        ["Full charge capacity", "The energy it actually holds at 100 % today. It shrinks slowly with use."],
        ["Remaining", "Full charge ÷ design × 100. Even when the laptop shows «100 %», runtime is reduced by this ratio."],
        ["Cycle count", "One cycle is one full discharge's worth of use. Shown as «-» when the battery does not report it."],
      ] as [string, string][],
      appTitle: "More with the PortDock apps",
      app1: "When a laptop serves as an equipment or field PC, sleep, USB selective suspend, Fast Startup and the update restart policy can be read without admin rights in",
      app2: "under «This PC» → «Read this PC's settings» (read-only).",
      faqTitle: "FAQ",
      faq: [
        ["At what percentage should I replace it?", "There is no single threshold. Check your laptop maker's warranty and replacement terms. In practice, look at whether the actual runtime is still enough for your work."],
        ["It says there is no battery", "The report was made on a PC without a battery (such as a desktop), or Windows could not read the battery. Open the HTML in a browser and see whether the «Installed batteries» table is empty."],
        ["Remaining is above 100 %", "New batteries sometimes measure slightly above the design value. That is not a sign of a problem."],
        ["It jumps up and down within days", "Full charge capacity is an estimate from the battery's management chip; without an occasional full discharge and charge the value is updated in jumps. Look at the overall trend in the history chart."],
        ["Is the file uploaded?", "No. The file is read as text inside this browser to find the tables; the file is not sent to any server."],
      ] as [string, string][],
      msg: {
        notReport: "No battery tables found — check that this is the HTML from powercfg /batteryreport and that it was made on a PC with a battery.",
        tooBig: "The file is too large (20 MB max).",
        health: "Remaining (vs design)",
        design: "Design capacity",
        full: "Full charge capacity",
        cycles: "Cycle count",
        noCycles: "not reported",
        battery: "Battery",
        total: "Total",
        histTitle: "Capacity history",
        histNote: "Full charge capacity (solid) and design capacity (dashed) per period. The horizontal axis follows the report's periods in order (spacing may be uneven).",
        recentTitle: "Recent usage (last 20)",
        cols: ["Date", "Time", "State", "Source", "Remaining %", "mWh"],
        noRecent: "No recent usage records.",
        loaded: "File",
        sampleNote: "Made-up sample — not real laptop values.",
      },
    }
  : page3(lang, "batteryReport");
const ld = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: L.faq.map(([q, a]) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a } })),
};
---

<Base lang={lang} title={L.title} seoTitle={L.seo} description={L.desc} path={PATH} ads libText={["batteryReport"]}>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <header class="page-head">
    <div class="wrap">
      <Crumbs lang={lang} items={[{ name: ui(lang).webTools, path: "tools/" }, { name: L.title, path: PATH }]} />
      <h1>{L.title}</h1>
      <p>{L.desc}</p>
    </div>
  </header>
  <div class="wrap" style="padding-top:24px">
    <form class="calc card" id="br" data-lang={lang} data-msg={JSON.stringify(L.msg)} onsubmit="return false">
      <h2 class="br-h">{L.step1}</h2>
      <p class="note" style="margin:0">{L.step1Note}</p>
      <div class="cmd-row">
        <span class="note">{L.cmd}</span>
        <code class="mono" id="cmd1">{CMD}</code>
        <button type="button" class="btn tight" data-copy="cmd1" data-done={L.copied}>{L.copy}</button>
      </div>
      <div class="cmd-row">
        <span class="note">{L.ps}</span>
        <code class="mono" id="cmd2">{PS}</code>
        <button type="button" class="btn tight" data-copy="cmd2" data-done={L.copied}>{L.copy}</button>
      </div>
      <h2 class="br-h">{L.step2}</h2>
      <label class="drop" id="drop">
        <input type="file" id="file" accept=".html,.htm,text/html" />
        <b id="drop-title">{L.drop}</b>
        <span class="note">{L.dropNote}</span>
      </label>
      <p class="sample-row">
        <button type="button" class="btn tight" id="sample">{L.sample}</button>
        <button type="button" class="btn tight" id="sampleKo">{L.sampleKo}</button>
      </p>
      <p class="note" style="margin:0">{L.privacy}</p>
      <p class="err" id="err" role="alert"></p>
      <div id="out" aria-live="polite"></div>
    </form>

    <AdSlot />

    <section class="prose">
      <h2>{L.readTitle}</h2>
      <ul>{L.read.map(([k, v]) => <li><b>{k}</b> — {v}</li>)}</ul>
      <h2>{L.appTitle}</h2>
      <p>
        {L.app1} <a href={link(lang, "port-inspector/")}>PortDock Port Inspector</a> {L.app2}
      </p>
      <h2>{L.faqTitle}</h2>
      {
        L.faq.map(([q, a]) => (
          <>
            <h3>{q}</h3>
            <p>{a}</p>
          </>
        ))
      }
    </section>
    <UseNotice lang={lang} />
    <WebToolLinks lang={lang} path={PATH} />
  </div>
  <style>
    .br-h {
      font-size: 17px;
      margin: 4px 0 0;
    }
    .cmd-row {
      display: flex;
      flex-wrap: wrap;
      gap: 6px 10px;
      align-items: center;
    }
    .cmd-row .note {
      flex: 0 0 150px;
    }
    .cmd-row code {
      flex: 1 1 300px;
      padding: 6px 8px;
      background: var(--code-bg);
      border-radius: 6px;
      font-size: 13px;
      overflow-wrap: anywhere;
    }
    .drop {
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 4px;
      min-height: 110px;
      border: 2px dashed var(--line);
      border-radius: var(--radius);
      text-align: center;
      padding: 16px;
      cursor: pointer;
    }
    .drop:hover,
    .drop:global(.over) {
      border-color: var(--accent);
      background: var(--soft);
    }
    .drop input {
      position: absolute;
      width: 1px;
      height: 1px;
      opacity: 0;
    }
    .drop:focus-within {
      outline: 2px solid var(--accent);
    }
    .sample-row {
      display: flex;
      gap: 6px 12px;
      flex-wrap: wrap;
      margin: 0;
    }
    #out :global(.tiles) {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
      gap: 8px;
      margin-top: 8px;
    }
    #out :global(.tile) {
      background: var(--soft);
      border-radius: 8px;
      padding: 8px 10px;
    }
    #out :global(.tile b) {
      display: block;
      font-size: 20px;
      font-variant-numeric: tabular-nums;
    }
    #out :global(.tile span) {
      font-size: 12px;
      color: var(--muted);
    }
    #out :global(.meter) {
      height: 10px;
      background: var(--code-bg);
      border-radius: 5px;
      overflow: hidden;
      margin-top: 6px;
    }
    #out :global(.meter i) {
      display: block;
      height: 100%;
      background: var(--accent);
    }
    #out :global(h3) {
      font-size: 16px;
      margin: 16px 0 6px;
    }
    #out :global(.chart) {
      width: 100%;
      height: auto;
      display: block;
      background: var(--code-bg);
      border-radius: 8px;
    }
    #out :global(.chart .full) {
      fill: none;
      stroke: var(--accent);
      stroke-width: 2.5;
    }
    #out :global(.chart .design) {
      fill: none;
      stroke: var(--muted);
      stroke-width: 1.5;
      stroke-dasharray: 5 4;
    }
    #out :global(.chart text) {
      fill: var(--muted);
      font-size: 11px;
    }
    #out :global(.scroll) {
      overflow-x: auto;
    }
    #out :global(table.t) {
      font-size: 14px;
    }
    #out :global(td.num) {
      text-align: right;
      font-variant-numeric: tabular-nums;
    }
  </style>
  <script>
    import { parseBatteryReport, totalHealth, chart, trend, NotBatteryReport, type BatteryReport } from "../lib/batteryReport";
    import { REPORT_EN, REPORT_KO } from "../lib/batteryFixture";
    import { msg, type Lang } from "../lib/tr";
    const form = document.getElementById("br") as HTMLFormElement;
    const lang = (form.dataset.lang ?? "ko") as Lang;
    const M = JSON.parse(form.dataset.msg ?? "{}");
    const out = document.getElementById("out")!;
    const err = document.getElementById("err")!;
    const drop = document.getElementById("drop") as HTMLLabelElement;
    const fileIn = document.getElementById("file") as HTMLInputElement;
    const nf = new Intl.NumberFormat(lang === "ko" ? "ko-KR" : lang === "en" ? "en-US" : lang);
    const pct = (x: number) => (Number.isFinite(x) ? x.toFixed(1) : "–");

    function el<K extends keyof HTMLElementTagNameMap>(tag: K, cls = "", text = "") {
      const e = document.createElement(tag);
      if (cls) e.className = cls;
      if (text) e.textContent = text;
      return e;
    }
    function tile(value: string, label: string, meter?: number) {
      const t = el("div", "tile");
      t.append(el("b", "", value), el("span", "", label));
      if (meter !== undefined && Number.isFinite(meter)) {
        const m = el("div", "meter");
        const i = el("i");
        i.style.width = Math.max(0, Math.min(100, meter)) + "%";
        m.append(i);
        t.append(m);
      }
      return t;
    }
    const SVGNS = "http://www.w3.org/2000/svg";
    function svg<K extends keyof SVGElementTagNameMap>(tag: K, attrs: Record<string, string>, text = "") {
      const e = document.createElementNS(SVGNS, tag);
      for (const [k, v] of Object.entries(attrs)) e.setAttribute(k, v);
      if (text) e.textContent = text;
      return e;
    }

    function show(r: BatteryReport, note = "") {
      out.replaceChildren();
      if (note) out.append(el("p", "note", note));
      const tiles = el("div", "tiles");
      const many = r.batteries.length > 1;
      if (r.batteries.length) {
        tiles.append(tile(pct(totalHealth(r.batteries)) + " %", M.health + (many ? ` (${M.total})` : ""), totalHealth(r.batteries)));
        r.batteries.forEach((b, i) => {
          const tag = many ? ` — ${M.battery} ${i + 1}` : "";
          if (many) tiles.append(tile(pct(b.health) + " %", M.health + tag, b.health));
          tiles.append(tile(nf.format(b.design) + " mWh", M.design + tag), tile(nf.format(b.full) + " mWh", M.full + tag), tile(b.cycles === null ? M.noCycles : nf.format(b.cycles), M.cycles + tag));
        });
        out.append(tiles);
      }
      if (r.history.length) {
        out.append(el("h3", "", M.histTitle));
        const W = 600;
        const H = 180;
        const padX = 46;
        const c = chart(r.history, W - padX - 10, H - 30);
        const s = svg("svg", { class: "chart", viewBox: `0 0 ${W} ${H}`, role: "img", "aria-label": M.histTitle });
        const g = svg("g", { transform: `translate(${padX},4)` });
        g.append(svg("polyline", { class: "design", points: c.design }), svg("polyline", { class: "full", points: c.full }));
        s.append(g);
        s.append(svg("text", { x: "4", y: "16" }, nf.format(Math.round(c.max / 1000)) + "Wh"), svg("text", { x: "4", y: String(H - 30) }, nf.format(Math.round(c.min / 1000)) + "Wh"));
        s.append(svg("text", { x: String(padX), y: String(H - 6) }, r.history[0].start));
        const last = r.history[r.history.length - 1];
        s.append(svg("text", { x: String(W - 10), y: String(H - 6), "text-anchor": "end" }, last.end ?? last.start));
        out.append(s, el("p", "note", M.histNote));
        const t = trend(r.history);
        if (t) out.append(el("p", "", msg(lang, `${t.from} → ${t.to}: 설계 대비 ${pct(t.startPct)} % → ${pct(t.endPct)} %`, `${t.from} → ${t.to}: ${pct(t.startPct)} % → ${pct(t.endPct)} % of design`)));
      }
      out.append(el("h3", "", M.recentTitle));
      if (!r.recent.length) out.append(el("p", "note", M.noRecent));
      else {
        const box = el("div", "scroll");
        const tb = el("table", "t");
        const hr = el("tr");
        for (const c of M.cols as string[]) hr.append(el("th", "", c));
        const th = el("thead");
        th.append(hr);
        const body = el("tbody");
        for (const u of r.recent.slice(-20)) {
          const tr = el("tr");
          tr.append(el("td", "mono", u.date ?? ""), el("td", "mono", u.time), el("td", "", u.state), el("td", "", u.source), el("td", "num", u.percent === null ? "–" : String(u.percent)), el("td", "num", u.mWh === null ? "–" : nf.format(u.mWh)));
          body.append(tr);
        }
        tb.append(th, body);
        box.append(tb);
        out.append(box);
      }
    }
    function readText(text: string, note = "") {
      err.textContent = "";
      try {
        show(parseBatteryReport(text), note);
      } catch (e) {
        out.replaceChildren();
        err.textContent = e instanceof NotBatteryReport ? M.notReport : String(e);
      }
    }
    async function readFile(f: File) {
      if (f.size > 20 * 1024 * 1024) {
        err.textContent = M.tooBig;
        return;
      }
      readText(await f.text());
      document.getElementById("drop-title")!.textContent = `${M.loaded}: ${f.name}`;
    }
    fileIn.addEventListener("change", () => {
      if (fileIn.files?.[0]) void readFile(fileIn.files[0]);
    });
    for (const ev of ["dragenter", "dragover"])
      drop.addEventListener(ev, (e) => {
        e.preventDefault();
        drop.classList.add("over");
      });
    for (const ev of ["dragleave", "drop"]) drop.addEventListener(ev, () => drop.classList.remove("over"));
    drop.addEventListener("drop", (e) => {
      e.preventDefault();
      const f = (e as DragEvent).dataTransfer?.files?.[0];
      if (f) void readFile(f);
    });
    document.getElementById("sample")!.addEventListener("click", () => readText(REPORT_EN, M.sampleNote));
    document.getElementById("sampleKo")!.addEventListener("click", () => readText(REPORT_KO, M.sampleNote));
    for (const b of form.querySelectorAll<HTMLButtonElement>("[data-copy]"))
      b.addEventListener("click", async () => {
        const text = document.getElementById(b.dataset.copy ?? "")?.textContent ?? "";
        try {
          await navigator.clipboard.writeText(text);
          const old = b.textContent;
          b.textContent = b.dataset.done ?? "";
          setTimeout(() => (b.textContent = old), 1500);
        } catch {
          /* 클립보드를 막은 브라우저 — 글을 직접 고르면 된다 */
        }
      });
  </script>
</Base>
