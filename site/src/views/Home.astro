---
import Base from "../layouts/Base.astro";
import { TOOLS, REPO, type Lang } from "../data/tools";
import { GUIDES } from "../data/guides";
import { DEVICES } from "../data/devices";
import { UI, url } from "../lib/i18n";
import { WEB_TOOLS, webToolByPath } from "../data/webTools";
import { POPULAR_WEB_TOOLS } from "../data/webToolGroups";
import { appIcon } from "../lib/appIcons";
import { toolById } from "../data/tools";
import { CONTACT_EMAIL } from "@shared/links";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = UI[lang];
const ko = lang === "ko";
const home = new URL(url(lang), Astro.site).href;
const root = new URL("/", Astro.site).href;
// 첫 화면은 짧게 — 웹 도구·가이드는 몇 개만 보이고 «모두 보기» 로 잇는다
const popular = POPULAR_WEB_TOOLS.map(webToolByPath);
const FEATURED_GUIDES = ["modbus-no-response", "rs485-wiring", "modbus-address-notation", "4-20ma-loop", "usb-serial-disconnects", "modbus-float-word-order"];
const featured = FEATURED_GUIDES.map((s) => GUIDES.find((g) => g.slug === s)).filter((g) => g !== undefined);
const sub = ko
  ? `시리얼(COM)·Modbus·TCP/UDP 장비를 시험하는 무료 윈도우 프로그램 ${TOOLS.length}종, 그리고 설치 없이 브라우저에서 쓰는 현장 계산기 ${WEB_TOOLS.length}개.`
  : `${TOOLS.length} free Windows programs for testing serial (COM), Modbus and TCP/UDP devices — plus ${WEB_TOOLS.length} field calculators that run in your browser.`;
// 사이트·만든 곳 정보(검색 결과의 사이트 이름·로고 후보)
const ld = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "PortDock",
    url: home,
    inLanguage: lang,
    description: t.siteDesc,
    publisher: { "@type": "Organization", name: "PortDock", url: root },
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "PortDock",
    url: root,
    logo: new URL("/favicon.svg", Astro.site).href,
    email: CONTACT_EMAIL,
    sameAs: [REPO],
  },
];
---

<Base
  lang={lang}
  title="PortDock"
  seoTitle={ko ? "PortDock — 무료 시리얼·Modbus·TCP 통신 테스트 프로그램" : "PortDock — Free Serial, Modbus, TCP/UDP Test Tools for Windows"}
  description={ko
    ? "시리얼 통신 프로그램, Modbus 마스터·슬레이브 시뮬레이터, TCP·UDP, SCPI, 실시간 그래프, COM 포트 점검까지 무료 윈도우 도구 10종. 오픈소스, 프로그램에 광고 없음."
    : "Ten free Windows hardware test tools: serial terminal, Modbus master/slave, TCP, UDP, SCPI, live plotter, COM port inspector. Open source, no ads in the apps."}
  path=""
>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <section class="hero">
    <div class="wrap">
      <div>
        <h1>{t.heroTitle}</h1>
        <p class="sub">{sub}</p>
        <div class="btns hero-btns">
          <a class="btn primary big" href={url(lang, "download/")}>{ko ? "프로그램 내려받기" : "Download the programs"} <small>{ko ? "무료 · 윈도우 10·11" : "free · Windows 10/11"}</small></a>
          <a class="btn big" href={url(lang, "tools/")}>{ko ? "웹 도구 바로 쓰기" : "Use the web tools"} <small>{ko ? "설치 없이" : "no install"}</small></a>
        </div>
        <ul class="trust">{t.trust.map((x) => <li>{x}</li>)}</ul>
      </div>
      <figure class="shot hero-shot">
        <img src={`/img/apps/serial.${lang}.webp`} width="1200" height="760" alt={ko ? "PortDock Serial 화면 — 받은 바이트 기록과 Modbus 응답 풀이" : "PortDock Serial screen — received bytes and a decoded Modbus reply"} fetchpriority="high" decoding="async" />
        <figcaption>{ko ? "PortDock Serial — 화면 예시(가짜 데이터)" : "PortDock Serial — example screen (sample data)"}</figcaption>
      </figure>
    </div>
  </section>

  <section class="block" id="tools">
    <div class="wrap">
      <h2>{ko ? `윈도우 프로그램 ${TOOLS.length}종` : `${TOOLS.length} Windows programs`}</h2>
      <p class="lead">{ko ? "목적별로 나뉜 작은 프로그램입니다. 필요한 것만 받아 쓰세요." : "One small program per job — get only what you need."}</p>
      <div class="shots3">
        {["modbus-master", "netscan", "plot"].map((id) => {
          const x = toolById(id);
          return (
            <a class="shot-card" href={url(lang, `${x.id}/`)}>
              <img src={`/img/apps/${x.id}.${lang}.webp`} width="1200" height="760" alt={ko ? `${x.name} 화면` : `${x.name} screen`} loading="lazy" decoding="async" />
              <span>{x.name.replace("PortDock ", "")} — {x.tagline[lang]}</span>
            </a>
          );
        })}
      </div>
      <div class="grid apps">
        {
          TOOLS.map((x) => (
            <a class="card app-card" href={url(lang, `${x.id}/`)}>
              {appIcon(x.id) && <img class="app-icon" src={appIcon(x.id)} alt="" width="40" height="40" loading="lazy" decoding="async" />}
              <div>
                <h3>{x.name.replace("PortDock ", "")}</h3>
                <p>{x.tagline[lang]}</p>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="block alt" id="web-tools">
    <div class="wrap">
      <h2>{ko ? "웹 도구 — 설치 없이 바로" : "Web tools — no install"}</h2>
      <p class="lead">{ko ? "브라우저에서 바로 계산합니다. 입력한 값은 어디에도 보내지 않습니다." : "Calculate right in your browser. Nothing you type is sent anywhere."}</p>
      <div class="grid compact">
        {
          popular.map((w) => (
            <a class="card" href={url(lang, w.path)}>
              <h3>{w.name[lang]}</h3>
              <p>{w.blurb[lang]}</p>
            </a>
          ))
        }
      </div>
      <p class="more-link"><a class="btn" href={url(lang, "tools/")}>{ko ? `웹 도구 ${WEB_TOOLS.length}개 모두 보기` : `All ${WEB_TOOLS.length} web tools`} →</a></p>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <h2>{t.whyTitle}</h2>
      <div class="grid">
        {
          t.why.map(([h, p]) => (
            <div class="card">
              <h3>{h}</h3>
              <p>{p}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <h2>{ko ? "가이드와 장비 레지스터 맵" : "Guides and device register maps"}</h2>
      <div class="grid">
        {
          featured.map((g) => (
            <a class="card" href={url(lang, `guides/${g.slug}/`)}>
              <h3>{g.title[lang]}</h3>
              <span class="go">{ko ? "읽기" : "Read"} →</span>
            </a>
          ))
        }
        <a class="card" href={url(lang, "devices/")}>
          <h3>{ko ? `산업 장비 Modbus 레지스터 맵 ${DEVICES.length}종` : `Modbus register maps for ${DEVICES.length} industrial devices`}</h3>
          <p>{ko ? "인버터·온도 조절기·전력 미터 — 매뉴얼 출처, JSON" : "Inverters, temperature controllers, power meters — sources, JSON"}</p>
          <span class="go">{t.more} →</span>
        </a>
      </div>
      <p class="more-link"><a class="btn" href={url(lang, "guides/")}>{ko ? `가이드 ${GUIDES.length}편 모두 보기` : `All ${GUIDES.length} guides`} →</a></p>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="cta">
        <div>
          <h2>{t.ctaTitle}</h2>
          <p>{t.ctaBody}</p>
        </div>
        <a class="btn" href={url(lang, "contact/")}>{t.ctaBtn}</a>
      </div>
    </div>
  </section>
</Base>
