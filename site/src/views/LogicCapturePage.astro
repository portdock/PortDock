---
// 웹 도구: 로직 분석기 캡처 해석기 — sigrok/PulseView CSV, Saleae Logic 2 «Export raw data» CSV, VCD 를 끌어 놓으면
// 채널을 골라 UART·SPI·I2C·CAN 을 풀고, 시간축 미니 파형(SVG)과 해석 표(시각·종류·값·오류)를 보인다. CSV·글 복사·CSV 저장.
// 읽기는 lib/logicCapture.ts(Web Worker 에서 조각으로), 풀이는 lib/logicDecode.ts. 이 도구 코드가 하는 네트워크 요청은
// «예시로 해 보기» 를 누를 때 이 사이트의 예시 파일(빌드 때 lib/logicSample.ts 로 만든 합성 캡처)을 받는 것뿐이다. 광고는 본문 아래에만(AdSlot).
import Base from "../layouts/Base.astro";
import AdSlot from "../components/AdSlot.astro";
import Crumbs from "../components/Crumbs.astro";
import WebToolLinks from "../components/WebToolLinks.astro";
import UseNotice from "../components/UseNotice.astro";
import type { SiteLang } from "../i18n/langs";
import { page4 } from "../i18n";
import { pageName } from "../i18n/names";
import { ui, link } from "../lib/i18n";
import { sampleUartCsv, sampleI2cCsv, sampleCanVcd } from "../lib/logicSample";

interface Props {
  lang: SiteLang;
}
const { lang } = Astro.props;
const PATH = "tools/logic-capture/";
const kb = (s: string) => Math.max(1, Math.round(s.length / 1024));
const REL = ["tools/uart-baud/", "tools/can-bit-timing/", "tools/pinouts/", "tools/multimeter-check/", "tools/troubleshoot/"];
const SAMPLES = [
  {
    href: "/tools/logic-capture/sample-uart.csv",
    file: "portdock-sample-uart.csv",
    size: kb(sampleUartCsv()),
    preset: { dec: "uart", "uart-ch": "Channel 0", "uart-ch2": "Channel 1", baud: "9600", parity: "even" },
    label: "UART (Saleae CSV)",
  },
  {
    href: "/tools/logic-capture/sample-i2c.csv",
    file: "portdock-sample-i2c.csv",
    size: kb(sampleI2cCsv()),
    preset: { dec: "i2c", "i2c-scl": "SCL", "i2c-sda": "SDA" },
    label: "I2C (sigrok CSV)",
  },
  {
    href: "/tools/logic-capture/sample-can-spi.vcd",
    file: "portdock-sample-can-spi.vcd",
    size: kb(sampleCanVcd()),
    preset: { dec: "can", "can-ch": "CAN_RX", bitrate: "500000", "spi-sck": "SCK", "spi-mosi": "MOSI", "spi-miso": "MISO", "spi-cs": "CS" },
    label: "CAN + SPI (VCD)",
  },
];
const L =
  lang === "ko"
  ? {
      title: "로직 분석기 캡처 해석기 (UART·SPI·I2C·CAN)",
      seo: "로직 분석기 캡처 해석기 — UART·SPI·I2C·CAN — PortDock",
      desc: "sigrok·PulseView CSV, Saleae Logic 2 CSV, VCD 캡처를 끌어 놓고 채널을 골라 UART·SPI·I2C·CAN 을 풉니다. 파형과 해석 표, CSV 복사. 브라우저 안에서만.",
      drop: "캡처 파일을 여기에 끌어 놓거나 눌러서 고르세요",
      dropNote: ".csv(sigrok·PulseView·Saleae Logic 2) · .vcd — 200MB 까지",
      privacy: "파일은 이 브라우저 안에서만 처리하고 어디에도 올리지 않습니다(전송 0).",
      picked: "다른 파일은 여기를 누르거나 끌어 놓아 다시 고르기",
      sampleTitle: "예시로 해 보기",
      sampleNote: "직접 만든 합성 파일입니다(실제 장비에서 뜬 것 아님). 누르면 받아서 바로 풀고, 링크로 내려받을 수도 있습니다.",
      rate: "샘플 속도 Hz (시간 열 없는 CSV)",
      rateHelp: "sigrok 주석의 Samplerate 가 있으면 그 값을 씁니다",
      thr: "아날로그 열 문턱 (V)",
      thrHelp: "0/1 이 아닌 숫자 열은 이 값보다 크면 1",
      cancel: "취소",
      sampleNotes: ["9600 8E1, 요청·응답 두 채널, 패리티 틀린 바이트 하나", "100 kHz, 쓰기 → 반복 시작 → 읽기, 없는 주소 NACK", "CAN 500 kbit/s 세 프레임(하나는 ACK 없음), SPI 모드 0 JEDEC ID 읽기"],
      dl: (kb: number) => `내려받기 ${kb}KB`,
      u: { decoder: "해석기", ch2: "둘째 채널 (선택)", baud: "보율", detect: "자동 추정", dataBits: "데이터 비트", parity: "패리티", pN: "없음 (N)", pE: "짝수 (E)", pO: "홀수 (O)", pM: "마크 (M)", pS: "스페이스 (S)", stopBits: "정지 비트", invert: "반전(쉴 때 0 — RS-232 레벨 그대로 뜬 선)", mode: "모드 (CPOL·CPHA)", order: "비트 순서", msb: "MSB 먼저", lsb: "LSB 먼저", wordBits: "워드 비트", csLow: "CS 는 0 일 때 켜짐", canCh: "RX 채널 (트랜시버 ↔ 컨트롤러)", bitrate: "비트 속도 (bit/s)", sp: "샘플 포인트 %", canInv: "반전(우성이 1 로 뜬 선)", zIn: "확대", zOut: "축소", fit: "전체", left: "왼쪽으로", right: "오른쪽으로", hint: "끌어서 옮기기 · Ctrl + 휠로 확대·축소 · 표의 줄을 누르면 그 자리로", decoded: "해석 결과", copyText: "글 복사", copyCsv: "CSV 복사", saveCsv: "CSV 저장", onlyErr: "오류만", more: "더 보기", faqTitle: "자주 묻는 것", relTitle: "함께 쓰는 도구", srcTitle: "근거", notAffiliated: "Saleae 는 Saleae, Inc. 의 상표이며, PortDock 은 Saleae·sigrok 프로젝트와 제휴 관계가 아닙니다. 예시 파일은 이 페이지용으로 만든 합성 파형입니다.", channel: "채널", head: ["시각", "채널", "종류", "값", "오류"] },
      relNames: ["UART 보율 오차 계산기", "CAN 비트 타이밍 계산기", "커넥터 핀 배치", "멀티미터 점검", "통신 고장 찾기"],
      relNotes: ["추정한 보율이 표준과 얼마나 다른지, MCU 분주비로 맞는지", "샘플 포인트·TQ 설정", "어느 핀에 프로브를 댈지", "파형 전에 전압·저항부터", "UART 를 USB-시리얼로 직접 주고받기"],
      refNotes: [
        "디지털 채널은 값이 바뀔 때만 한 줄, 마지막 샘플도 한 줄",
        "주석 문자 «;», 머리 주석, 1열 시간 선택",
        "§3.1.3~3.1.6 데이터·시작/정지·바이트·ACK, §3.1.10·3.1.11 주소·R/W·10비트 주소",
        "표 1-3 모드 0~3 의 CPOL·CPHA, 읽는 가장자리",
        "시작 비트·5~9 데이터 비트(LSB 먼저)·패리티·정지 비트",
        "§3 표준·확장 프레임 칸, §4.4 스터핑·오류 프레임(우성 6비트)",
        "§5 비트 타이밍·재동기화, §6 CRC·ACK·형식·스터핑 오류",
      ],
    }
  : lang === "en"
  ? {
      title: "Logic Analyzer Capture Decoder (UART, SPI, I2C, CAN)",
      seo: "Logic Analyzer Capture Decoder: UART, SPI, I2C, CAN — PortDock",
      desc: "Drop a sigrok/PulseView CSV, Saleae Logic 2 CSV or VCD capture and decode UART, SPI, I2C or CAN. Waveform, decode table, CSV copy. In your browser only.",
      drop: "Drop a capture file here, or click to choose one",
      dropNote: ".csv (sigrok, PulseView, Saleae Logic 2) · .vcd — up to 200 MB",
      privacy: "The file is processed only inside this browser and is not uploaded anywhere (nothing is sent).",
      picked: "Click here or drop another file to choose again",
      sampleTitle: "Try a sample",
      sampleNote: "Synthetic files made for this page (not captured from real devices). Click to load and decode, or download with the link.",
      rate: "Sample rate Hz (CSV without a time column)",
      rateHelp: "a sigrok «Samplerate» comment wins if present",
      thr: "Analog column threshold (V)",
      thrHelp: "numeric columns other than 0/1 read 1 above this",
      cancel: "Cancel",
      sampleNotes: ["9600 8E1, request and reply channels, one byte with a parity error", "100 kHz, write → repeated start → read, NACK from a missing address", "CAN 500 kbit/s, three frames (one without ACK); SPI mode 0 JEDEC ID read"],
      dl: (kb: number) => `download ${kb} KB`,
      u: { decoder: "Decoder", ch2: "Second channel (optional)", baud: "Baud rate", detect: "Detect", dataBits: "Data bits", parity: "Parity", pN: "None (N)", pE: "Even (E)", pO: "Odd (O)", pM: "Mark (M)", pS: "Space (S)", stopBits: "Stop bits", invert: "Inverted (idle low — e.g. a raw RS-232 level line)", mode: "Mode (CPOL, CPHA)", order: "Bit order", msb: "MSB first", lsb: "LSB first", wordBits: "Word bits", csLow: "CS active low", canCh: "RX channel (transceiver ↔ controller)", bitrate: "Bit rate (bit/s)", sp: "Sample point %", canInv: "Inverted (dominant captured as 1)", zIn: "Zoom in", zOut: "Zoom out", fit: "Fit", left: "Pan left", right: "Pan right", hint: "Drag to pan · Ctrl + wheel to zoom · click a table row to jump there", decoded: "Decoded", copyText: "Copy text", copyCsv: "Copy CSV", saveCsv: "Save CSV", onlyErr: "Errors only", more: "Show more", faqTitle: "FAQ", relTitle: "Tools that go with it", srcTitle: "References", notAffiliated: "Saleae is a trademark of Saleae, Inc.; PortDock is not affiliated with Saleae or the sigrok project. The sample files are synthetic waveforms made for this page.", channel: "Channel", head: ["Time", "Ch.", "Kind", "Value", "Error"] },
      relNames: ["UART Baud Rate Error Calculator", "CAN Bit Timing Calculator", "Connector pinouts", "Multimeter checks", "Communication troubleshooter"],
      relNotes: ["how far a detected baud rate is from standard, and whether an MCU divisor can hit it", "sample point and TQ settings", "where to clip the probes", "voltage and resistance before waveforms", "talk to the UART directly through a USB-serial adapter"],
      refNotes: [
        "digital channels get a row only when data changes; the last sample always gets a row",
        "comment character «;», header comments, optional time column",
        "§3.1.3–3.1.6 data, START/STOP, byte format, ACK; §3.1.10–3.1.11 address, R/W, 10-bit addressing",
        "table 1-3: CPOL, CPHA and capture edge for modes 0–3",
        "start bit, 5–9 data bits (LSB first), parity, stop bits",
        "§3 standard and extended frame fields, §4.4 stuffing and error frames (6 dominant bits)",
        "§5 bit timing and resynchronization, §6 CRC, ACK, form and stuff errors",
      ],
    }
  : { ...page4(lang, "logicCapture"), relNames: REL.map((p) => pageName(lang, p)) };
const FAQ: [string, string][] =
  lang === "ko"
  ? [
      ["어떤 파일을 읽나요?", "Saleae Logic 2 의 «Export raw data» CSV(첫 열 Time [s], 채널마다 한 열, 값이 바뀔 때만 한 줄), sigrok-cli·PulseView 의 CSV(«;» 주석, 시간 열이 있거나 없거나 — 없으면 주석의 Samplerate 나 위 칸의 샘플 속도로 시각을 셈), VCD(Value Change Dump: $timescale·$var 와 #시각 값 바뀜)를 읽습니다. VCD 의 여러 비트 변수는 비트마다 채널로 나누고, x 는 앞 값, z 는 1(풀업)로 봅니다. 200MB, 변화 2천만 개까지."],
      ["보율 자동 추정은 어떻게 하나요?", "그 채널에서 가장 짧은 펄스 무리를 1비트로 보고, 12비트보다 짧은 펄스 전체를 비트 수로 나눠 다듬은 뒤 표준 보율과 3% 안이면 그 값을 넣습니다. 캡처에 0·1 이 한 비트씩 바뀌는 곳이 없으면(예: 같은 글자만 반복) 실제의 절반으로 잡힐 수 있으니, 해석 결과에 프레임 오류가 많으면 두 배 보율도 넣어 보세요."],
      ["샘플 속도는 얼마나 높아야 하나요?", "변화 시각은 샘플 하나 길이만큼 어긋날 수 있습니다. 비트 하나에 샘플 10개면 최대 0.1비트, 4개면 0.25비트입니다. 이 도구는 UART 를 비트 가운데에서, CAN 을 샘플 포인트에서 읽으므로 어긋남이 그보다 작아야 합니다. I2C 는 SCL 과 SDA 가 같은 샘플에서 바뀌면 시작·정지를 놓칠 수 있습니다."],
      ["CAN 은 어느 선을 떠야 하나요?", "CAN 트랜시버와 컨트롤러 사이의 RX(논리 0·1) 선을 뜹니다. 우성 = 0, 열성 = 1 입니다. CAN_H·CAN_L 은 차동 신호라 한 선만 로직 분석기로 뜨면 문턱이 맞지 않습니다. 비트 속도를 넣어야 하고(«자동 추정» 은 가장 짧은 펄스 기준), CAN FD 프레임은 «CAN FD — 풀지 않음» 으로만 표시합니다."],
      ["SPI 에 CS 선이 없으면요?", "CS 를 «없음» 으로 두면 캡처 처음부터 비트를 세어 워드로 묶습니다. 캡처가 워드 중간에서 시작하면 묶음이 어긋나므로 CS 를 함께 뜨는 것이 좋습니다. CS 를 켤 때 SCK 수준이 고른 모드의 CPOL 과 다르면 표에 알림이 붙습니다."],
      ["파일이 서버로 가나요?", "아니요. 파일은 이 브라우저의 Web Worker 에서 읽고 풀며, 이 페이지는 «예시로 해 보기» 를 누를 때 이 사이트의 예시 파일을 받는 것 말고는 네트워크 요청을 하지 않습니다."],
    ]
  : lang === "en"
  ? [
      ["Which files can it read?", "Saleae Logic 2 «Export raw data» CSV (first column Time [s], one column per channel, a row only when a value changes), sigrok-cli / PulseView CSV («;» comments, with or without a time column — without one, times come from the Samplerate comment or the sample rate field above) and VCD (Value Change Dump: $timescale, $var and #time value changes). Multi-bit VCD variables are split into one channel per bit; x keeps the previous value and z reads as 1 (pulled up). Up to 200 MB and 20 million transitions."],
      ["How does baud rate detection work?", "It takes the shortest group of pulses on the channel as one bit, refines it over all pulses shorter than 12 bits, and fills in a standard baud rate if one is within 3 %. If the capture never toggles one bit at a time (for example the same character repeated) it can land on half the real rate, so if the result shows many framing errors, try double the baud rate."],
      ["How fast must the sample rate be?", "A transition can be off by up to one sample. With 10 samples per bit that is 0.1 bit, with 4 samples 0.25 bit. This tool reads UART at the middle of each bit and CAN at the sample point, so the error has to stay well below that. For I2C, if SCL and SDA change in the same sample a start or stop can be missed."],
      ["Which CAN line should I capture?", "Capture the RX line between the CAN transceiver and the controller (logic 0/1). Dominant = 0, recessive = 1. CAN_H and CAN_L are differential, so capturing one of them with a logic analyzer does not give proper thresholds. Enter the bit rate (or use «Detect», based on the shortest pulse). CAN FD frames are only marked «CAN FD — not decoded»."],
      ["What if my SPI capture has no CS line?", "With CS set to «none», bits are counted from the start of the capture and grouped into words. If the capture starts mid-word the grouping is off, so capture CS too. If SCK is not at the selected mode's CPOL level when CS turns on, the table marks it."],
      ["Is the file sent to a server?", "No. The file is read and decoded by a Web Worker in this browser. The page makes no network request except fetching this site's sample file when you click «Try a sample»."],
    ]
  : page4(lang, "logicCapture").faq;
const REFS = [
  { title: "Saleae — Exporting Data (Logic 2)", url: "https://www.saleae.com/support/logic-software/saving-and-exporting-data/exporting-data" },
  { title: "sigrok wiki — File format:Csv", url: "https://sigrok.org/wiki/File_format:Csv" },
  { title: "NXP UM10204 I2C-bus specification and user manual Rev. 7.0", url: "https://www.nxp.com/docs/en/user-guide/UM10204.pdf" },
  { title: "Microchip AVR151: Setup and Use of the SPI — 1.4 SPI Timing", url: "https://onlinedocs.microchip.com/oxy/GUID-6F1B86DC-C230-43D1-A405-0CC2E7EDF7EE-en-US-2/GUID-EAC2D943-F395-4D47-98C8-4EEBC798BFA2.html" },
  { title: "Microchip ATmega328P datasheet (7810D) — USART Frame Formats", url: "https://ww1.microchip.com/downloads/en/DeviceDoc/Atmel-7810-Automotive-Microcontrollers-ATmega328P_Datasheet.pdf" },
  { title: "TI SLOA101B — Introduction to the Controller Area Network (CAN)", url: "https://www.ti.com/lit/an/sloa101b/sloa101b.pdf" },
  { title: "Microchip MCP2515 datasheet DS20001801J", url: "https://ww1.microchip.com/downloads/en/DeviceDoc/MCP2515-Stand-Alone-CAN-Controller-with-SPI-20001801J.pdf" },
].map((r, i) => ({ ...r, note: L.refNotes[i] }));
const ld = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: FAQ.map(([q, a]) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a } })),
};
const opt = (v: string | number, label?: string) => ({ v: String(v), label: label ?? String(v) });
const BITRATES = [10000, 20000, 50000, 83333, 100000, 125000, 250000, 500000, 800000, 1000000];
---

<Base lang={lang} title={L.title} seoTitle={L.seo} description={L.desc} path={PATH} ads libText={["logic"]}>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <header class="page-head">
    <div class="wrap">
      <Crumbs lang={lang} items={[{ name: ui(lang).webTools, path: "tools/" }, { name: L.title, path: PATH }]} />
      <h1>{L.title}</h1>
      <p>{L.desc}</p>
    </div>
  </header>
  <div class="wrap" style="padding-top:24px">
    <form class="calc card" id="lc" data-lang={lang} data-picked={L.picked}>
      <label class="drop" id="drop">
        <input type="file" id="file" accept=".csv,.vcd,.txt,text/csv" />
        <b id="drop-title">{L.drop}</b>
        <span class="note" id="drop-note">{L.dropNote}</span>
      </label>
      <div class="samples">
        <b>{L.sampleTitle}</b>
        {
          SAMPLES.map((s, i) => (
            <span class="sample">
              <button type="button" class="btn tight" data-sample={s.href} data-name={s.file} data-preset={JSON.stringify(s.preset)}>
                {s.label}
              </button>
              <span class="note">
                {L.sampleNotes[i]} · <a href={s.href} download={s.file}>{L.dl(s.size)}</a>
              </span>
            </span>
          ))
        }
        <span class="note">{L.sampleNote}</span>
      </div>
      <p class="note privacy">{L.privacy}</p>
      <div class="row">
        <label class="fld">
          {L.rate}
          <input id="rate" class="mono" value="1000000" inputmode="numeric" autocomplete="off" />
          <span class="note">{L.rateHelp}</span>
        </label>
        <label class="fld">
          {L.thr}
          <input id="thr" class="mono" value="0.5" inputmode="decimal" autocomplete="off" />
          <span class="note">{L.thrHelp}</span>
        </label>
      </div>
      <div id="busy" hidden>
        <progress id="prog" max="1" value="0"></progress>
        <span id="busy-text" class="note"></span>
        <button type="button" class="btn tight" id="cancel">{L.cancel}</button>
      </div>
      <p class="err" id="err" role="alert"></p>
    </form>

    <section id="res" class="card" hidden>
      <p id="info" class="note"></p>
      <div id="warns"></div>
      <div class="row">
        <label class="fld">
          {L.u.decoder}
          <select id="dec">
            <option value="uart">UART</option>
            <option value="spi">SPI</option>
            <option value="i2c">I2C</option>
            <option value="can">CAN</option>
          </select>
        </label>
      </div>
      <div class="dec row" data-dec="uart">
        <label class="fld">{L.u.channel}<select class="chsel" id="uart-ch"></select></label>
        <label class="fld">{L.u.ch2}<select class="chsel" id="uart-ch2" data-none="1"></select></label>
        <label class="fld">
          {L.u.baud}
          <span class="inl"><input id="baud" class="mono" value="9600" inputmode="numeric" autocomplete="off" /><button type="button" class="btn tight" id="baud-auto">{L.u.detect}</button></span>
          <span class="note" id="baud-note"></span>
        </label>
        <label class="fld">
          {L.u.dataBits}
          <select id="bits">{[5, 6, 7, 8, 9].map((n) => <option value={n} selected={n === 8}>{n}</option>)}</select>
        </label>
        <label class="fld">
          {L.u.parity}
          <select id="parity">
            <option value="none">{L.u.pN}</option>
            <option value="even">{L.u.pE}</option>
            <option value="odd">{L.u.pO}</option>
            <option value="mark">{L.u.pM}</option>
            <option value="space">{L.u.pS}</option>
          </select>
        </label>
        <label class="fld">
          {L.u.stopBits}
          <select id="stop"><option value="1">1</option><option value="1.5">1.5</option><option value="2">2</option></select>
        </label>
        <label class="chk"><input type="checkbox" id="invert" /> {L.u.invert}</label>
      </div>
      <div class="dec row" data-dec="spi" hidden>
        <label class="fld">SCK<select class="chsel" id="spi-sck"></select></label>
        <label class="fld">MOSI<select class="chsel" id="spi-mosi" data-none="1"></select></label>
        <label class="fld">MISO<select class="chsel" id="spi-miso" data-none="1"></select></label>
        <label class="fld">CS<select class="chsel" id="spi-cs" data-none="1"></select></label>
        <label class="fld">
          {L.u.mode}
          <select id="spi-mode">
            <option value="0">0 (0,0)</option>
            <option value="1">1 (0,1)</option>
            <option value="2">2 (1,0)</option>
            <option value="3">3 (1,1)</option>
          </select>
        </label>
        <label class="fld">
          {L.u.order}
          <select id="spi-order"><option value="msb">{L.u.msb}</option><option value="lsb">{L.u.lsb}</option></select>
        </label>
        <label class="fld">{L.u.wordBits}<input id="spi-bits" class="mono" value="8" inputmode="numeric" /></label>
        <label class="chk"><input type="checkbox" id="spi-cslow" checked /> {L.u.csLow}</label>
      </div>
      <div class="dec row" data-dec="i2c" hidden>
        <label class="fld">SCL<select class="chsel" id="i2c-scl"></select></label>
        <label class="fld">SDA<select class="chsel" id="i2c-sda"></select></label>
      </div>
      <div class="dec row" data-dec="can" hidden>
        <label class="fld">{L.u.canCh}<select class="chsel" id="can-ch"></select></label>
        <label class="fld">
          {L.u.bitrate}
          <span class="inl"><input id="bitrate" class="mono" list="bitrates" value="500000" inputmode="numeric" autocomplete="off" /><button type="button" class="btn tight" id="br-auto">{L.u.detect}</button></span>
          <datalist id="bitrates">{BITRATES.map((b) => <option value={opt(b).v} />)}</datalist>
          <span class="note" id="br-note"></span>
        </label>
        <label class="fld">{L.u.sp}<input id="sp" class="mono" value="75" inputmode="decimal" /></label>
        <label class="chk"><input type="checkbox" id="can-inv" /> {L.u.canInv}</label>
      </div>
      <p class="err" id="dec-err" role="alert"></p>
    </section>

    <div id="out" aria-live="polite" hidden>
      <div class="wavebar">
        <button type="button" class="btn tight" data-z="in" aria-label={L.u.zIn}>＋</button>
        <button type="button" class="btn tight" data-z="out" aria-label={L.u.zOut}>－</button>
        <button type="button" class="btn tight" data-z="all">{L.u.fit}</button>
        <button type="button" class="btn tight" data-z="left" aria-label={L.u.left}>◀</button>
        <button type="button" class="btn tight" data-z="right" aria-label={L.u.right}>▶</button>
        <span class="note" id="span"></span>
      </div>
      <div id="wavebox"></div>
      <p class="note">{L.u.hint}</p>
      <h2 id="sum-h" tabindex="-1">{L.u.decoded}</h2>
      <p id="sum"></p>
      <div class="wavebar">
        <button type="button" class="btn tight" id="copy-text">{L.u.copyText}</button>
        <button type="button" class="btn tight" id="copy-csv">{L.u.copyCsv}</button>
        <button type="button" class="btn tight" id="save-csv">{L.u.saveCsv}</button>
        <label class="chk"><input type="checkbox" id="only-err" /> {L.u.onlyErr}</label>
        <span class="note" id="copied" role="status"></span>
      </div>
      <div class="scroll"><table class="t" id="tbl"><thead><tr><th class="num">{L.u.head[0]}</th><th>{L.u.head[1]}</th><th>{L.u.head[2]}</th><th>{L.u.head[3]}</th><th>{L.u.head[4]}</th></tr></thead><tbody></tbody></table></div>
      <button type="button" class="btn tight" id="more" hidden>{L.u.more}</button>
    </div>

    <AdSlot />

    <section class="prose">
      <h2>{L.u.faqTitle}</h2>
      {
        FAQ.map(([q, a]) => (
          <>
            <h3>{q}</h3>
            <p>{a}</p>
          </>
        ))
      }
      <h2>{L.u.relTitle}</h2>
      <ul>
        <li><a href={link(lang, REL[0])}>{L.relNames[0]}</a> — {L.relNotes[0]}</li>
        <li><a href={link(lang, REL[1])}>{L.relNames[1]}</a> — {L.relNotes[1]}</li>
        <li><a href={link(lang, REL[2])}>{L.relNames[2]}</a> — {L.relNotes[2]}</li>
        <li><a href={link(lang, REL[3])}>{L.relNames[3]}</a> — {L.relNotes[3]}</li>
        <li><a href={link(lang, REL[4])}>{L.relNames[4]}</a></li>
        <li><a href={link(lang, "serial/")}>PortDock Serial</a> — {L.relNotes[4]}</li>
      </ul>
      <h2>{L.u.srcTitle}</h2>
      <ul>
        {
          REFS.map((r) => (
            <li>
              <a href={r.url} rel="noopener">{r.title}</a> — {r.note}
            </li>
          ))
        }
      </ul>
      <p class="note">{L.u.notAffiliated}</p>
    </section>
    <UseNotice lang={lang} />
    <WebToolLinks lang={lang} path={PATH} />
  </div>
  <style>
    .drop {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 4px;
      min-height: 120px;
      border: 2px dashed var(--line);
      border-radius: var(--radius);
      text-align: center;
      padding: 16px;
      cursor: pointer;
    }
    .drop:hover,
    .drop.over {
      border-color: var(--accent);
      background: var(--soft);
    }
    .drop.has-file {
      border-style: solid;
      border-color: var(--accent);
    }
    .drop input {
      position: absolute;
      width: 1px;
      height: 1px;
      opacity: 0;
    }
    .drop:focus-within {
      outline: 2px solid var(--accent);
    }
    .samples {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .sample {
      display: flex;
      gap: 6px 12px;
      align-items: center;
      flex-wrap: wrap;
    }
    .chk {
      display: flex;
      gap: 8px;
      align-items: flex-start;
      font-size: 14px;
    }
    .chk input {
      width: auto;
      margin-top: 4px;
    }
    .inl {
      display: flex;
      gap: 6px;
    }
    .inl input {
      flex: 1 1 auto;
      min-width: 0;
    }
    #busy {
      display: flex;
      gap: 10px;
      align-items: center;
      flex-wrap: wrap;
    }
    #busy[hidden],
    .dec[hidden],
    #res[hidden],
    #out[hidden],
    #more[hidden] {
      display: none;
    }
    #busy progress {
      flex: 1 1 200px;
      height: 14px;
    }
    #res {
      margin-top: 16px;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    #out {
      margin-top: 16px;
      --lc-err: #b42318;
      --lc-ann: #2e6fd8;
    }
    @media (prefers-color-scheme: dark) {
      #out {
        --lc-err: #f97066;
        --lc-ann: #7aa7ff;
      }
    }
    .wavebar {
      display: flex;
      gap: 8px;
      align-items: center;
      flex-wrap: wrap;
      margin: 8px 0;
    }
    #wavebox {
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: var(--panel);
      overflow: hidden;
      touch-action: pan-y;
      cursor: grab;
      user-select: none;
    }
    #wavebox :global(svg) {
      display: block;
      width: 100%;
    }
    #wavebox :global(.lbl) {
      fill: var(--ink);
      font-size: 12px;
    }
    #wavebox :global(.tick) {
      fill: var(--muted);
      font-size: 11px;
    }
    #wavebox :global(.grid) {
      stroke: var(--line);
    }
    #wavebox :global(.sig) {
      stroke: var(--accent);
      stroke-width: 1.4;
      fill: none;
    }
    #wavebox :global(.ann) {
      fill: color-mix(in srgb, var(--lc-ann) 18%, transparent);
      stroke: var(--lc-ann);
    }
    #wavebox :global(.ann.bad) {
      fill: color-mix(in srgb, var(--lc-err) 18%, transparent);
      stroke: var(--lc-err);
    }
    #wavebox :global(.mark) {
      stroke: var(--lc-ann);
      stroke-dasharray: 3 3;
    }
    #wavebox :global(.atxt) {
      fill: var(--ink);
      font-size: 11px;
      font-family: "Cascadia Mono", Consolas, monospace;
    }
    .scroll {
      overflow-x: auto;
      max-height: 560px;
      overflow-y: auto;
    }
    table.t {
      font-size: 14px;
      border-collapse: collapse;
      width: 100%;
    }
    table.t th,
    table.t td {
      padding: 4px 8px;
      border-bottom: 1px solid var(--line);
      text-align: left;
    }
    table.t th {
      position: sticky;
      top: 0;
      background: var(--panel);
    }
    table.t td.num,
    table.t th.num {
      text-align: right;
      white-space: nowrap;
      font-variant-numeric: tabular-nums;
    }
    table.t :global(td.v) {
      font-family: "Cascadia Mono", Consolas, monospace;
    }
    table.t :global(tr.bad td) {
      color: var(--lc-err);
    }
    table.t :global(tbody tr) {
      cursor: pointer;
    }
    table.t :global(tbody tr:hover) {
      background: var(--soft);
    }
    #out :global(.warn),
    #res :global(.warn) {
      border-left: 4px solid #b54708;
      background: var(--soft);
      padding: 6px 12px;
      margin: 4px 0;
      font-size: 14px;
    }
  </style>
  <script>
    import type { Capture, Channel } from "../lib/logicCapture";
    import { wavePath, edgeCount } from "../lib/logicCapture";
    import { decodeUart, decodeSpi, decodeI2c, decodeCan, estimateBaud, kindText, valueText, errText, itemsCsv, itemsText, type Item, type Parity } from "../lib/logicDecode";
    import type { WorkerOut } from "../lib/logicWorker";
    import { saveText } from "../lib/fileSave";
    import { msg, type Lang } from "../lib/tr";

    const form = document.getElementById("lc") as HTMLFormElement;
    const lang = (form.dataset.lang ?? "ko") as Lang;
    const t = (k: string, e: string) => msg(lang, k, e);
    const MAX = 200 * 1024 * 1024;
    const g = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
    const fileIn = g<HTMLInputElement>("file");
    const drop = g<HTMLLabelElement>("drop");
    const err = g<HTMLElement>("err");
    const busy = g<HTMLElement>("busy");
    const prog = g<HTMLProgressElement>("prog");
    const busyText = g<HTMLElement>("busy-text");
    const res = g<HTMLElement>("res");
    const out = g<HTMLElement>("out");
    const decSel = g<HTMLSelectElement>("dec");
    const decErr = g<HTMLElement>("dec-err");
    const wavebox = g<HTMLElement>("wavebox");
    const tbody = g<HTMLTableElement>("tbl").tBodies[0];
    const nf = new Intl.NumberFormat(lang === "ko" ? "ko-KR" : lang === "en" ? "en-US" : lang);
    const size = (b: number) => (b >= 1048576 ? `${(b / 1048576).toFixed(1)} MB` : `${Math.max(1, Math.round(b / 1024))} KB`);

    let worker: Worker | null = null;
    let cap: Capture | null = null;
    let items: Item[] = [];
    let shown: Item[] = [];
    let wordBits = 8;
    let view = { v0: 0, v1: 1 };
    let preset: Record<string, string> | null = null;
    let fileName = "capture";
    const PAGE = 1000;
    let limit = PAGE;

    /** 시각 글 — 크기에 맞는 단위 */
    function fmtT(s: number, span = Math.abs(s)) {
      const a = Math.max(Math.abs(span), 1e-15);
      if (a >= 1) return `${s.toFixed(3)} s`;
      if (a >= 1e-3) return `${(s * 1e3).toFixed(3)} ms`;
      if (a >= 1e-6) return `${(s * 1e6).toFixed(3)} µs`;
      return `${(s * 1e9).toFixed(1)} ns`;
    }

    // ---------------------------------------------------------------- 파일 읽기
    function stop() {
      worker?.terminate();
      worker = null;
      busy.hidden = true;
    }

    function load(f: File) {
      err.textContent = "";
      drop.classList.add("has-file");
      g("drop-title").textContent = `${f.name} · ${size(f.size)}`;
      g("drop-note").textContent = form.dataset.picked ?? "";
      fileName = f.name.replace(/\.[^.]+$/, "") || "capture";
      if (f.size > MAX) {
        err.textContent = t(
          `파일이 ${(f.size / 1048576).toFixed(0)}MB 입니다 — 200MB 까지 읽습니다. 로직 분석기 프로그램에서 필요한 구간·채널만 내보내 주세요.`,
          `The file is ${(f.size / 1048576).toFixed(0)} MB — the limit is 200 MB. Export only the time range and channels you need from the logic analyzer software.`,
        );
        return;
      }
      const rate = Number(g<HTMLInputElement>("rate").value.trim());
      const thr = Number(g<HTMLInputElement>("thr").value.trim());
      stop();
      busy.hidden = false;
      prog.value = 0;
      busyText.textContent = t("파일 읽는 중…", "Reading the file…");
      const w = new Worker(new URL("../lib/logicWorker.ts", import.meta.url), { type: "module" });
      worker = w;
      w.onmessage = (e: MessageEvent<WorkerOut>) => {
        const m = e.data;
        if (m.type === "progress") {
          prog.value = m.f;
          busyText.textContent = `${t("읽는 중", "Reading")} ${Math.round(m.f * 100)}%`;
        } else if (m.type === "error") {
          stop();
          err.textContent =
            m.code === "empty"
              ? t("읽을 줄이 없습니다.", "Nothing to read in the file.")
              : m.code === "unsorted"
                ? t(`시각이 거꾸로 가는 줄이 있습니다(${m.message}) — 시간순으로 내보낸 파일인지 보세요.`, `A row goes back in time (${m.message}) — export in time order.`)
                : m.code === "too-many-edges"
                  ? t("변화가 너무 많습니다(2천만 개 넘음) — 구간을 줄여 내보내 주세요.", "Too many transitions (over 20 million) — export a shorter range.")
                  : m.code === "time"
                    ? t(`시간 단위를 읽지 못했습니다: ${m.message}`, `Could not read the time unit: ${m.message}`)
                    : m.code === "format" || m.code === "no-channels"
                      ? t("CSV·VCD 형식이 아니거나 채널이 없습니다.", "Not a CSV or VCD file, or no channels.")
                      : t(`파일을 읽다가 멈췄습니다: ${m.message}`, `Stopped while reading the file: ${m.message}`);
        } else {
          stop();
          loaded(m.capture);
        }
      };
      w.onerror = (e) => {
        stop();
        err.textContent = t(`처리 중 오류: ${e.message}`, `Error while processing: ${e.message}`);
      };
      w.postMessage({ file: f, opts: { sampleRate: rate > 0 ? rate : undefined, threshold: Number.isFinite(thr) ? thr : 0.5 } });
    }

    fileIn.addEventListener("change", () => {
      const f = fileIn.files?.[0];
      preset = null;
      if (f) load(f);
      fileIn.value = "";
    });
    for (const ev of ["dragenter", "dragover"])
      drop.addEventListener(ev, (e) => {
        e.preventDefault();
        drop.classList.add("over");
      });
    for (const ev of ["dragleave", "drop"]) drop.addEventListener(ev, () => drop.classList.remove("over"));
    drop.addEventListener("drop", (e) => {
      e.preventDefault();
      const f = (e as DragEvent).dataTransfer?.files?.[0];
      preset = null;
      if (f) load(f);
    });
    g<HTMLButtonElement>("cancel").addEventListener("click", () => {
      stop();
      err.textContent = t("취소했습니다.", "Cancelled.");
    });
    for (const b of form.querySelectorAll<HTMLButtonElement>("button[data-sample]")) {
      b.addEventListener("click", async () => {
        err.textContent = "";
        b.disabled = true;
        try {
          const r = await fetch(b.dataset.sample!);
          if (!r.ok) throw new Error(String(r.status));
          preset = JSON.parse(b.dataset.preset ?? "null");
          load(new File([await r.arrayBuffer()], b.dataset.name ?? "sample.csv"));
        } catch (e) {
          err.textContent = t(`예시 파일을 받지 못했습니다: ${(e as Error).message}`, `Could not load the sample file: ${(e as Error).message}`);
        } finally {
          b.disabled = false;
        }
      });
    }
    form.addEventListener("submit", (e) => e.preventDefault());

    // ---------------------------------------------------------------- 채널·해석기 설정
    const chSels = [...document.querySelectorAll<HTMLSelectElement>("select.chsel")];
    function loaded(c: Capture) {
      cap = c;
      const fmt = c.format === "saleae-csv" ? "Saleae Logic CSV" : c.format === "sigrok-csv" ? "sigrok CSV" : c.format === "vcd" ? "VCD" : "CSV";
      g("info").textContent = [
        fmt,
        `${t("채널", "channels")} ${c.channels.length}`,
        `${t("길이", "length")} ${fmtT(c.end - c.start)}`,
        `${t("변화", "transitions")} ${nf.format(edgeCount(c))}`,
        c.rate ? `${t("샘플 속도", "sample rate")} ${nf.format(c.rate)} Hz` : "",
      ]
        .filter(Boolean)
        .join(" · ");
      const warns = g("warns");
      warns.replaceChildren();
      const W: Record<string, string> = {
        "rate-assumed": t("시간 열도 샘플 속도 주석도 없어 위 칸의 샘플 속도로 시각을 셉니다.", "No time column and no sample rate comment — times use the sample rate field above."),
        analog: t("0/1 이 아닌 숫자 열을 문턱으로 잘라 읽었습니다.", "Numeric columns other than 0/1 were cut at the threshold."),
        "x-values": t("VCD 의 x(모름) 값은 앞 값으로 두었습니다.", "VCD x (unknown) values keep the previous value."),
        "real-skipped": t("VCD 의 실수 변수는 뺐습니다.", "VCD real variables were skipped."),
      };
      for (const w of c.warnings) if (W[w]) warns.append(Object.assign(document.createElement("p"), { className: "warn", textContent: W[w] }));
      const names = c.channels.map((x) => x.name);
      chSels.forEach((s, k) => {
        const prev = s.value;
        s.replaceChildren();
        if (s.dataset.none) s.append(new Option(t("없음", "none"), ""));
        names.forEach((n, i) => s.append(new Option(n, String(i))));
        // 처음 값: 이전 선택 이름 → 역할 이름이 들어간 채널 → 순서대로
        const role = s.id.split("-").pop()!.toUpperCase();
        const byRole = names.findIndex((n) => n.toUpperCase().includes(role === "CH" ? "RX" : role));
        if (prev && names[Number(prev)] !== undefined) s.value = prev;
        else if (byRole >= 0) s.value = String(byRole);
        else if (s.dataset.none) s.value = "";
        else s.value = String(Math.min(k % 4, names.length - 1));
      });
      if (preset) {
        for (const [k, v] of Object.entries(preset)) {
          const el = document.getElementById(k) as HTMLSelectElement | HTMLInputElement | null;
          if (k === "dec") decSel.value = v;
          else if (el instanceof HTMLSelectElement && el.classList.contains("chsel")) {
            const i = names.indexOf(v);
            if (i >= 0) el.value = String(i);
          } else if (el) el.value = v;
        }
      }
      showDec();
      res.hidden = false;
      view = { v0: c.start, v1: c.end > c.start ? c.end : c.start + 1e-6 };
      run(true);
    }

    function showDec() {
      for (const d of document.querySelectorAll<HTMLElement>(".dec")) d.hidden = d.dataset.dec !== decSel.value;
    }
    const sig = (id: string): Channel | null => {
      const v = g<HTMLSelectElement>(id).value;
      return v === "" || !cap ? null : (cap.channels[Number(v)] ?? null);
    };
    const num = (id: string) => Number(g<HTMLInputElement>(id).value.trim());

    function decode(): { items: Item[]; chans: number[] } | string {
      const c = cap!;
      const dec = decSel.value;
      const used = (ids: string[]) => ids.map((id) => g<HTMLSelectElement>(id).value).filter((v) => v !== "").map(Number);
      wordBits = 8;
      if (dec === "uart") {
        const baud = num("baud");
        if (!(baud >= 1 && baud <= 1e8)) return t("보율을 숫자로 넣어 주세요.", "Enter the baud rate as a number.");
        const o = { baud, dataBits: num("bits"), parity: g<HTMLSelectElement>("parity").value as Parity, stopBits: Number(g<HTMLSelectElement>("stop").value) as 1 | 1.5 | 2, invert: g<HTMLInputElement>("invert").checked };
        const a = sig("uart-ch")!;
        const b = sig("uart-ch2");
        let r = decodeUart(a, c.start, c.end, { ...o, ch: a.name });
        if (b && b !== a) r = r.concat(decodeUart(b, c.start, c.end, { ...o, ch: b.name })).sort((x, y) => x.t0 - y.t0);
        return { items: r, chans: used(["uart-ch", "uart-ch2"]) };
      }
      if (dec === "spi") {
        const bits = num("spi-bits");
        if (!(bits >= 1 && bits <= 32)) return t("워드 비트는 1~32 입니다.", "Word bits are 1 to 32.");
        wordBits = bits;
        const sck = sig("spi-sck")!;
        const r = decodeSpi(sck, sig("spi-mosi"), sig("spi-miso"), sig("spi-cs"), c.start, c.end, { mode: num("spi-mode") as 0 | 1 | 2 | 3, msbFirst: g<HTMLSelectElement>("spi-order").value === "msb", bits, csActiveLow: g<HTMLInputElement>("spi-cslow").checked });
        return { items: r, chans: used(["spi-cs", "spi-sck", "spi-mosi", "spi-miso"]) };
      }
      if (dec === "i2c") {
        const scl = sig("i2c-scl")!;
        const sda = sig("i2c-sda")!;
        if (scl === sda) return t("SCL 과 SDA 를 다른 채널로 골라 주세요.", "Pick different channels for SCL and SDA.");
        return { items: decodeI2c(scl, sda, c.start, c.end), chans: used(["i2c-scl", "i2c-sda"]) };
      }
      const br = num("bitrate");
      const sp = num("sp");
      if (!(br >= 1000 && br <= 1e7)) return t("비트 속도는 1000~10000000 bit/s 입니다.", "The bit rate is 1000 to 10000000 bit/s.");
      if (!(sp >= 5 && sp <= 95)) return t("샘플 포인트는 5~95 % 입니다.", "The sample point is 5 to 95 %.");
      return { items: decodeCan(sig("can-ch")!, c.start, c.end, { bitrate: br, samplePoint: sp / 100, invert: g<HTMLInputElement>("can-inv").checked }), chans: used(["can-ch"]) };
    }

    let chans: number[] = [];
    function run(scroll = false) {
      if (!cap) return;
      decErr.textContent = "";
      const r = decode();
      if (typeof r === "string") {
        decErr.textContent = r;
        return;
      }
      items = r.items;
      chans = r.chans.length ? [...new Set(r.chans)] : cap.channels.slice(0, 8).map((_, i) => i);
      out.hidden = false;
      const errs = items.filter((x) => x.err.length).length;
      const kinds = new Map<string, number>();
      for (const it of items) kinds.set(kindText(it, lang), (kinds.get(kindText(it, lang)) ?? 0) + 1);
      g("sum").textContent = items.length
        ? `${[...kinds].map(([k, n]) => `${k} ${nf.format(n)}`).join(" · ")} · ${t("오류", "errors")} ${nf.format(errs)}`
        : t("풀린 것이 없습니다 — 채널·보율(비트 속도)·모드를 확인해 보세요.", "Nothing decoded — check the channels, baud (bit) rate and mode.");
      limit = PAGE;
      table();
      draw();
      if (scroll) {
        const h = g("sum-h");
        h.focus({ preventScroll: true });
        out.scrollIntoView({ block: "start", behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" });
      }
    }

    decSel.addEventListener("change", () => {
      showDec();
      run();
    });
    for (const el of res.querySelectorAll<HTMLInputElement | HTMLSelectElement>("select, input")) {
      if (el === decSel) continue;
      el.addEventListener("change", () => run());
    }
    function auto(chId: string, inputId: string, noteId: string, list: number[] | null) {
      const s = sig(chId);
      const note = g(noteId);
      if (!s || !cap) return;
      const e = estimateBaud(s, view.v0, view.v1);
      if (!e) {
        note.textContent = t("펄스가 너무 적어 추정하지 못했습니다.", "Too few pulses to detect.");
        return;
      }
      let v = e.std;
      if (list) {
        v = null;
        for (const x of list) if (Math.abs(e.raw / x - 1) <= 0.03) v = x;
      }
      g<HTMLInputElement>(inputId).value = String(v ?? Math.round(e.raw));
      note.textContent = `${t("가장 짧은 펄스 기준", "from the shortest pulses")} ≈ ${nf.format(Math.round(e.raw))}${v ? ` → ${nf.format(v)}` : ""} (${t("펄스", "pulses")} ${nf.format(e.pulses)})`;
      run();
    }
    g("baud-auto").addEventListener("click", () => auto("uart-ch", "baud", "baud-note", null));
    g("br-auto").addEventListener("click", () => auto("can-ch", "bitrate", "br-note", [10000, 20000, 33333, 50000, 83333, 100000, 125000, 250000, 500000, 800000, 1000000]));

    // ---------------------------------------------------------------- 표
    function table() {
      const only = g<HTMLInputElement>("only-err").checked;
      shown = only ? items.filter((x) => x.err.length) : items;
      const frag = document.createDocumentFragment();
      const span = cap ? cap.end - cap.start : 1;
      for (const it of shown.slice(0, limit)) {
        const tr = document.createElement("tr");
        if (it.err.length) tr.className = "bad";
        const cells = [fmtT(it.t0 - (cap?.start ?? 0), span), it.ch ?? "", kindText(it, lang), valueText(it, lang, wordBits), errText(it, lang)];
        cells.forEach((v, i) => {
          const td = document.createElement("td");
          td.textContent = v;
          if (i === 0) td.className = "num";
          if (i === 3) td.className = "v";
          tr.append(td);
        });
        tr.addEventListener("click", () => focusItem(it));
        frag.append(tr);
      }
      tbody.replaceChildren(frag);
      const more = g<HTMLButtonElement>("more");
      more.hidden = shown.length <= limit;
      more.textContent = t(`더 보기 (${nf.format(shown.length - limit)}개 남음)`, `Show more (${nf.format(shown.length - limit)} left)`);
    }
    g("more").addEventListener("click", () => {
      limit += PAGE * 5;
      table();
    });
    g("only-err").addEventListener("change", () => {
      limit = PAGE;
      table();
    });

    async function copy(text: string) {
      const msg = g("copied");
      try {
        await navigator.clipboard.writeText(text);
        msg.textContent = t("복사했습니다.", "Copied.");
      } catch {
        msg.textContent = t("복사하지 못했습니다 — CSV 저장을 쓰세요.", "Could not copy — use Save CSV.");
      }
      setTimeout(() => (msg.textContent = ""), 2500);
    }
    g("copy-text").addEventListener("click", () => copy(itemsText(shown, lang, wordBits)));
    g("copy-csv").addEventListener("click", () => copy(itemsCsv(shown, lang, wordBits)));
    g("save-csv").addEventListener("click", () => saveText("﻿" + itemsCsv(shown, lang, wordBits), `${fileName}-${decSel.value}.csv`, "text/csv"));

    // ---------------------------------------------------------------- 파형
    const LBL = 92;
    const ROW = 30;
    const TOP = 22;
    function draw() {
      if (!cap) return;
      const W = Math.max(320, Math.round(wavebox.clientWidth || 800));
      const plotW = W - LBL - 8;
      const rows = chans.length;
      const H = TOP + rows * ROW + 34;
      const { v0, v1 } = view;
      const span = v1 - v0;
      const X = (tt: number) => LBL + ((tt - v0) / span) * plotW;
      const esc = (s: string) => s.replace(/[&<>"]/g, (ch) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[ch]!);
      let s = `<svg viewBox="0 0 ${W} ${H}" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="${esc(t("파형", "Waveform"))}">`;
      // 눈금 — 1·2·5 간격
      const raw = span / 8;
      const p = 10 ** Math.floor(Math.log10(raw));
      const step = [1, 2, 5, 10].map((m) => m * p).find((x) => x >= raw) ?? raw;
      for (let tt = Math.ceil((v0 - cap.start) / step) * step + cap.start; tt <= v1; tt += step) {
        const x = X(tt);
        s += `<line class="grid" x1="${x.toFixed(1)}" y1="${TOP - 4}" x2="${x.toFixed(1)}" y2="${H - 30}"/><text class="tick" x="${(x + 3).toFixed(1)}" y="12">${esc(fmtT(tt - cap.start, step))}</text>`;
      }
      chans.forEach((ci, r) => {
        const ch = cap!.channels[ci];
        const y0 = TOP + r * ROW;
        s += `<text class="lbl" x="6" y="${y0 + 18}">${esc(ch.name.length > 12 ? ch.name.slice(0, 11) + "…" : ch.name)}</text>`;
        s += `<path class="sig" transform="translate(${LBL} 0)" d="${wavePath(ch, v0, v1, plotW, y0 + 5, y0 + ROW - 5)}"/>`;
      });
      // 해석 띠
      const ay = TOP + rows * ROW + 4;
      s += `<text class="lbl" x="6" y="${ay + 17}">${esc(decSel.value.toUpperCase())}</text>`;
      const a = lower(items, v0);
      let drawn = 0;
      for (let k = a; k < items.length && drawn < 4000; k++) {
        const it = items[k];
        if (it.t0 > v1) break;
        if (it.t1 < v0) continue;
        drawn++;
        const x0 = Math.max(LBL, X(it.t0));
        const x1 = Math.min(W - 8, X(it.t1));
        const bad = it.err.length ? " bad" : "";
        if (it.t1 === it.t0) {
          s += `<line class="mark${bad}" x1="${x0.toFixed(1)}" y1="${TOP}" x2="${x0.toFixed(1)}" y2="${ay + 24}"/>`;
          if (drawn < 400) s += `<text class="atxt" x="${(x0 + 2).toFixed(1)}" y="${ay + 34}">${esc(it.kind === "cs" ? (it.on ? "CS↓" : "CS↑") : it.kind === "start" ? "S" : it.kind === "restart" ? "Sr" : it.kind === "stop" ? "P" : "")}</text>`;
          continue;
        }
        const w = Math.max(2, x1 - x0);
        s += `<rect class="ann${bad}" x="${x0.toFixed(1)}" y="${ay}" width="${w.toFixed(1)}" height="24" rx="3"/>`;
        const short = shortText(it);
        if (w > short.length * 7 + 6) s += `<text class="atxt" x="${(x0 + 4).toFixed(1)}" y="${ay + 16}">${esc(short)}</text>`;
      }
      s += "</svg>";
      wavebox.innerHTML = s;
      g("span").textContent = `${t("보이는 구간", "visible")} ${fmtT(span)}`;
    }
    function shortText(it: Item) {
      const h = (v: number | undefined, w = 2) => (v === undefined ? "" : v.toString(16).toUpperCase().padStart(w, "0"));
      switch (it.kind) {
        case "byte":
        case "break":
          return (it.ch && chans.length > 1 ? it.ch.slice(-1) + ":" : "") + h(it.v);
        case "word":
          return [h(it.v, Math.ceil(wordBits / 4)), h(it.miso, Math.ceil(wordBits / 4))].filter(Boolean).join("/");
        case "addr":
          return `${h(it.addr)}${it.rw ? "R" : "W"}${it.ack ? "" : "!"}`;
        case "data":
          return `${h(it.v)}${it.ack === false ? "!" : ""}`;
        case "frame":
          return it.id === undefined ? "?" : `${it.ext ? h(it.id, 8) : h(it.id, 3)} [${it.dlc ?? "?"}] ${(it.data ?? []).map((x) => h(x)).join(" ")}`;
        default:
          return "";
      }
    }
    function lower(a: Item[], tt: number) {
      // t1 이 tt 보다 앞인 것 건너뛰기(t0 순서라 대략) — 긴 항목을 놓치지 않게 조금 앞에서 시작
      let lo = 0;
      let hi = a.length;
      while (lo < hi) {
        const m = (lo + hi) >>> 1;
        if (a[m].t0 < tt) lo = m + 1;
        else hi = m;
      }
      return Math.max(0, lo - 1);
    }
    function setView(v0: number, v1: number) {
      if (!cap) return;
      const full = Math.max(cap.end - cap.start, 1e-9);
      let span = Math.min(Math.max(v1 - v0, full / 1e7, 1e-12), full);
      let a = v0;
      if (a < cap.start) a = cap.start;
      if (a + span > cap.end) a = Math.max(cap.start, cap.end - span);
      span = Math.min(span, full);
      view = { v0: a, v1: a + span };
      draw();
    }
    function zoom(f: number, at = (view.v0 + view.v1) / 2) {
      setView(at - (at - view.v0) * f, at + (view.v1 - at) * f);
    }
    function focusItem(it: Item) {
      const w = Math.max((it.t1 - it.t0) * 6, (view.v1 - view.v0) / 50);
      setView(it.t0 - w / 2, it.t0 + w / 2);
      wavebox.scrollIntoView({ block: "nearest" });
    }
    for (const b of document.querySelectorAll<HTMLButtonElement>(".wavebar button[data-z]")) {
      b.addEventListener("click", () => {
        const s = view.v1 - view.v0;
        if (b.dataset.z === "in") zoom(0.5);
        else if (b.dataset.z === "out") zoom(2);
        else if (b.dataset.z === "all" && cap) setView(cap.start, cap.end);
        else if (b.dataset.z === "left") setView(view.v0 - s * 0.5, view.v1 - s * 0.5);
        else if (b.dataset.z === "right") setView(view.v0 + s * 0.5, view.v1 + s * 0.5);
      });
    }
    let drag: { x: number; v0: number; v1: number } | null = null;
    const toT = (clientX: number) => {
      const r = wavebox.getBoundingClientRect();
      const W = Math.max(320, Math.round(wavebox.clientWidth || 800));
      const scale = W / r.width;
      return view.v0 + (((clientX - r.left) * scale - LBL) / (W - LBL - 8)) * (view.v1 - view.v0);
    };
    wavebox.addEventListener("pointerdown", (e) => {
      drag = { x: e.clientX, v0: view.v0, v1: view.v1 };
      wavebox.setPointerCapture(e.pointerId);
    });
    wavebox.addEventListener("pointermove", (e) => {
      if (!drag) return;
      const r = wavebox.getBoundingClientRect();
      const dt = ((e.clientX - drag.x) / Math.max(1, r.width - LBL)) * (drag.v1 - drag.v0);
      setView(drag.v0 - dt, drag.v1 - dt);
    });
    wavebox.addEventListener("pointerup", () => (drag = null));
    wavebox.addEventListener("pointercancel", () => (drag = null));
    wavebox.addEventListener(
      "wheel",
      (e) => {
        if (!e.ctrlKey) return;
        e.preventDefault();
        zoom(e.deltaY > 0 ? 1.5 : 1 / 1.5, toT(e.clientX));
      },
      { passive: false },
    );
    let rt = 0;
    addEventListener("resize", () => {
      clearTimeout(rt);
      rt = window.setTimeout(draw, 150);
    });
  </script>
</Base>
