---
// 웹 도구: 제어반 발열·환기 팬 계산기 — 장비 발열 합, 외함 유효 표면적(IEC TR 60890 표면 계수), 자연 방열, 팬 풍량(해발 보정), 쿨러·히터 출력.
// 계산은 lib/panelHeat.ts(node --test — Rittal 백서의 설치 방식 식과 맞춰 봄). 모두 브라우저 안 — 서버로 보내지 않는다.
import FaqBlock from "../components/FaqBlock.astro";
import Base from "../layouts/Base.astro";
import AdSlot from "../components/AdSlot.astro";
import Crumbs from "../components/Crumbs.astro";
import WebToolLinks from "../components/WebToolLinks.astro";
import UseNotice from "../components/UseNotice.astro";
import { ADVICE, ALTITUDE_F, INSTALL_TYPES, K_STEEL } from "../lib/panelHeat";
import type { SiteLang } from "../i18n/langs";
import { page7 } from "../i18n";
import { pageName } from "../i18n/names";
import { ui, link } from "../lib/i18n";
import { tx } from "../lib/tr";

interface Props {
  lang: SiteLang;
}
const { lang } = Astro.props;
const PATH = "tools/panel-heat/";
const L =
  lang === "ko"
  ? {
      h1: "제어반 발열·환기 팬 계산기",
      desc: "장비 발열(W) 합과 외함 크기·설치 방식으로 자연 방열을 계산하고, 모자라는 열을 빼는 팬 풍량(m³/h, 해발 보정)과 쿨러·히터 출력을 봅니다.",
      seo: "제어반 발열 계산·환기 팬 풍량 계산기 (IEC 60890) — PortDock",
      s1: "외함",
      w: "너비 W (mm)",
      h: "높이 H (mm)",
      d: "깊이 D (mm)",
      inst: "설치 방식 (IEC 60890)",
      k: "열전달 계수 k (W/m²K)",
      kNote: "강판 5.5 (Rittal)",
      s2: "장비 발열",
      loads: "한 줄에 장비 하나 — 이름과 열 손실(W). 정격 출력(kW)이 아니라 매뉴얼의 «손실·발열» 값을 넣을 것. «×4» 로 개수",
      loadsPh: "PLC CPU 12\nSMPS 24V 손실 25 W\n인버터 2.2kW 손실 90 W\n서보 앰프 35 ×2\n릴레이 0.5 ×16",
      s3: "온도",
      tAmb: "외기 최고 온도 Tu (°C)",
      tIn: "허용 내부 온도 Ti (°C)",
      alt: "해발 고도 (m)",
      tMin: "겨울 최저 외기 (°C, 히터)",
      k1: {
        pt: "장비 발열 합 Pt",
        a: "유효 표면적 A",
        dt: "ΔT = Ti − Tu",
        pc: "자연 방열 Pc = k·A·ΔT",
        pa: "팬으로 뺄 열 Pa = Pt − Pc",
        f: "팬 계수 f (해발)",
        v: "필요한 팬 풍량 V = f·Pa/ΔT",
        pn: "쿨러 출력 Pn = Pt − Pc",
        qw: "공기/공기 열교환기 Qw = Pa/ΔT",
        pv: "히터 출력 Pv = k·A·ΔT(겨울)",
        pv2: "히터 — 장비 발열을 뺀 값",
      },
      bad: "읽지 못한 줄",
      none: "—",
      privacy: "넣은 값은 이 브라우저 안에서만 계산하며 어디에도 보내지 않습니다.",
      fTitle: "계산식",
      formula: [
        "유효 표면적 A = Σ(면 넓이 × 표면 계수 b) — 노출된 윗면 1.4, 덮인 윗면 0.7, 노출된 옆면(앞·뒤·좌우) 0.9, 벽에 붙은 뒷면 0.5, 옆 외함과 붙은 면 0.5, 바닥 0 (IEC TR 60890 표 3)",
        "자연 방열 Pc = k × A × ΔT,   ΔT = Ti − Tu,   강판 k = 5.5 W/m²K",
        "팬 풍량 V(m³/h) = f × (Pt − Pc) ÷ ΔT,   f = 3.1 (해발 0 m) … 5.2 (3500 m)",
        "쿨러 출력 Pn = Pt − Pc (외기가 더 뜨거우면 Pc 가 음수라 들어오는 열이 더해짐)",
        "히터 출력 Pv = k × A × (Ti − 최저 외기)",
      ],
      aTitle: "설치 방식별 식 (W·H·D = m)",
      fTable: "해발 고도별 팬 계수 f",
      fHead: ["해발 (m)", "f (m³·K/Wh)"],
      fNote: "표의 칸 사이 고도는 높은 쪽 값(바람이 더 필요한 쪽)을 씁니다. 공기가 엷어지면 같은 부피의 공기가 나르는 열이 줄기 때문입니다.",
      lTitle: "읽는 법",
      l: [
        "장비 손실(W)은 장비 매뉴얼의 «손실·발열(power loss, heat dissipation)» 값을 넣습니다. 전원 장치는 출력이 아니라 손실(출력 × (1/효율 − 1)), 인버터는 매뉴얼의 손실 값입니다.",
        "외기는 여름 최고 온도, 내부 허용 온도는 가장 약한 장비의 허용 주위 온도(보통 매뉴얼에 적힌 40 °C·45 °C·55 °C 등)로 잡습니다.",
        "팬 풍량은 필터·그릴을 단 상태의 실제 풍량이어야 합니다. 필터 팬 카탈로그의 «필터 포함 풍량» 을 보고, 필터가 막히면 줄어드는 것도 생각합니다. 들어오는 쪽은 아래, 나가는 쪽은 위가 좋습니다(Rittal).",
        "외기가 허용 내부 온도보다 높거나 차이가 작으면 팬만으로는 안 됩니다 — 쿨러(에어컨)나 열교환기를 봅니다. 먼지·기름이 많은 곳은 바깥 공기를 넣지 않는 열교환기·쿨러가 맞습니다.",
        "이 계산은 공기가 고르게 섞인다고 본 대략값입니다. 직사광선·외함 색·장비 배치(핫스팟)는 들어 있지 않으니 여유를 둡니다.",
      ],
      srcTitle: "출처",
      see: ["히터 전류·전선은 ", ". 전원 장치까지의 전선은 ", "."],
      seeLinks: ["히터 용량 계산기", "전압 강하 계산기"],
      faqTitle: "자주 묻는 것",
      faq: [
        ["장비 발열에는 무엇을 넣나요?", "정격 출력(kW)이 아니라 매뉴얼의 «손실·발열(W)» 값을 넣습니다. 인버터는 정격의 몇 % 가 열로 나오고, 전원 장치는 효율에서 손실을 구합니다. 같은 장비가 여럿이면 «×4» 처럼 개수를 붙입니다."],
        ["외기가 허용 내부 온도보다 높으면?", "ΔT 가 음수라 자연 방열 대신 열이 들어오므로 팬(외기 환기)으로는 식힐 수 없습니다. 쿨러 출력 Pn 을 봅니다."],
        ["해발 고도는 왜 넣나요?", "높은 곳은 공기가 옅어 같은 풍량으로 빼는 열이 줄어듭니다. 팬 계수 f 가 해발 0 m 3.1 에서 3500 m 5.2 까지 커져 필요한 풍량이 늘어납니다."],
      ] as [string, string][],
    }
  : lang === "en"
  ? {
      h1: "Enclosure Heat & Fan Sizing Calculator",
      desc: "Sum device heat loss, get natural dissipation from enclosure size and installation, then fan airflow (m³/h, altitude-corrected) and cooler or heater output.",
      seo: "Enclosure Heat Load & Fan Sizing Calculator (IEC 60890) — PortDock",
      s1: "Enclosure",
      w: "Width W (mm)",
      h: "Height H (mm)",
      d: "Depth D (mm)",
      inst: "Installation (IEC 60890)",
      k: "Heat transfer coefficient k (W/m²K)",
      kNote: "sheet steel 5.5 (Rittal)",
      s2: "Device heat loss",
      loads: "One device per line — name and heat loss (W). Enter the manual's «power loss / heat dissipation», not the rated output (kW). «×4» for quantity",
      loadsPh: "PLC CPU 12\n24V PSU loss 25 W\nVFD 2.2kW loss 90 W\nServo amp 35 ×2\nRelay 0.5 ×16",
      s3: "Temperatures",
      tAmb: "Max ambient Tu (°C)",
      tIn: "Allowed internal Ti (°C)",
      alt: "Altitude (m)",
      tMin: "Min winter ambient (°C, heater)",
      k1: {
        pt: "Total heat loss Pt",
        a: "Effective surface area A",
        dt: "ΔT = Ti − Tu",
        pc: "Natural dissipation Pc = k·A·ΔT",
        pa: "Heat for the fan Pa = Pt − Pc",
        f: "Fan factor f (altitude)",
        v: "Required fan airflow V = f·Pa/ΔT",
        pn: "Cooling unit output Pn = Pt − Pc",
        qw: "Air/air heat exchanger Qw = Pa/ΔT",
        pv: "Heater output Pv = k·A·ΔT (winter)",
        pv2: "Heater — minus device heat",
      },
      bad: "Lines not read",
      none: "—",
      privacy: "Values you enter are calculated inside this browser and sent nowhere.",
      fTitle: "Formulas",
      formula: [
        "Effective area A = Σ(face area × surface factor b) — exposed top 1.4, covered top 0.7, exposed sides (front, rear, sides) 0.9, rear against a wall 0.5, faces joined to another enclosure 0.5, floor 0 (IEC TR 60890 Table 3)",
        "Natural dissipation Pc = k × A × ΔT,   ΔT = Ti − Tu,   sheet steel k = 5.5 W/m²K",
        "Fan airflow V (m³/h) = f × (Pt − Pc) ÷ ΔT,   f = 3.1 (sea level) … 5.2 (3500 m)",
        "Cooling unit output Pn = Pt − Pc (with a hotter ambient Pc is negative, so the heat coming in is added)",
        "Heater output Pv = k × A × (Ti − min ambient)",
      ],
      aTitle: "Formula by installation (W, H, D in m)",
      fTable: "Fan factor f by altitude",
      fHead: ["Altitude (m)", "f (m³·K/Wh)"],
      fNote: "Between rows the higher value (more air) is used. Thinner air carries less heat per cubic metre.",
      lTitle: "How to read it",
      l: [
        "Enter each device's «power loss» or «heat dissipation» from its manual. For power supplies use the loss (output × (1/efficiency − 1)), not the output; for drives use the manual's loss figure.",
        "Use the summer maximum for the ambient, and for the internal limit the allowed ambient of the most sensitive device (often 40, 45 or 55 °C in the manual).",
        "The fan airflow must be the real airflow with filters and grilles fitted — use the «with filter» airflow from the filter fan catalogue and allow for clogging. Air in at the bottom, out at the top (Rittal).",
        "If the ambient is above the internal limit, or only slightly below, a fan alone will not do — look at a cooling unit or heat exchanger. Where there is dust or oil, a heat exchanger or cooling unit keeps outside air out.",
        "This is an estimate that assumes well-mixed air. Sunlight, enclosure colour and hot spots from device layout are not included, so leave margin.",
      ],
      srcTitle: "Sources",
      see: ["For heater current and wiring, use the ", ". For the cable to the power supply, use the ", "."],
      seeLinks: ["heater power calculator", "voltage drop calculator"],
      faqTitle: "FAQ",
      faq: [
        ["What do I enter as equipment heat?", "The «power loss / heat dissipation (W)» from the manual, not the rated output (kW). Drives lose a few percent of their rating as heat, and power supplies lose what their efficiency leaves. Add «×4» for several identical devices."],
        ["What if the outside air is hotter than the allowed inside temperature?", "ΔT is negative, so heat flows in instead of out and fan ventilation cannot cool the cabinet. Look at the cooler output Pn."],
        ["Why does altitude matter?", "Thinner air at altitude removes less heat for the same airflow. The fan factor f grows from 3.1 at 0 m to 5.2 at 3500 m, so more airflow is needed."],
      ] as [string, string][],
    }
  : { ...page7(lang, "panelHeat"), seeLinks: ["tools/heater-power/", "tools/voltage-drop/"].map((p) => pageName(lang, p)) };
const AREA_F: Record<number, string> = {
  1: "1.8·H·(W+D) + 1.4·W·D",
  2: "1.4·W·(H+D) + 1.8·D·H",
  3: "1.8·W·H + 1.4·W·D + 1.4·D·H",
  4: "1.4·H·(W+D) + 1.4·W·D",
  5: "1.8·W·H + 1.4·W·D + D·H",
  6: "1.4·W·(H+D) + D·H",
  7: "1.4·W·H + 0.7·W·D + D·H",
};
const T = { k1: L.k1, bad: L.bad, none: L.none, advice: Object.fromEntries(Object.entries(ADVICE).map(([k, v]) => [k, tx(v, lang)])) };
const SRC = [
  { name: "IEC TR 60890:2014 — Temperature-rise verification by calculation (5.2.2, Table 3 surface factor b)", href: "https://webstore.iec.ch/en/publication/20257" },
  { name: "Rittal — The Perfect Climate Inside Your Enclosure (US573-WP-TR): installation formulas, k = 5.5 W/m²K, fan factor f by altitude", href: "https://www.rittal.com/us_en/apps/download/img/uploads/US573-WP-TR%20Perfect%20Climate%20Inside%20Your%20Enclosure.pdf" },
];
// 자주 묻는 것(FAQPage) — components/FaqBlock.astro
const FAQ = L.faq as [string, string][];
---

<Base lang={lang} title={L.h1} seoTitle={L.seo} description={L.desc} path={PATH} ads libText={["panelHeat"]}>
  <header class="page-head">
    <div class="wrap">
      <Crumbs lang={lang} items={[{ name: ui(lang).webTools, path: "tools/" }, { name: L.h1, path: PATH }]} />
      <h1>{L.h1}</h1>
      <p>{L.desc}</p>
    </div>
  </header>
  <div class="wrap" style="padding-top:24px">
    <form class="calc card" id="ph" data-t={JSON.stringify(T)} data-lang={lang}>
      <h2>{L.s1}</h2>
      <div class="row">
        <label class="fld">{L.w}<input id="w" class="mono" value="600" inputmode="decimal" autocomplete="off" /></label>
        <label class="fld">{L.h}<input id="h" class="mono" value="1800" inputmode="decimal" autocomplete="off" /></label>
        <label class="fld">{L.d}<input id="d" class="mono" value="400" inputmode="decimal" autocomplete="off" /></label>
        <label class="fld">{L.k} — {L.kNote}<input id="k" class="mono" value={K_STEEL} inputmode="decimal" autocomplete="off" /></label>
      </div>
      <div class="row">
        <label class="fld">{L.inst}<select id="inst">{INSTALL_TYPES.map((x) => <option value={String(x.id)} selected={x.id === 2}>{x.id}. {tx(x.name, lang)}</option>)}</select></label>
      </div>
      <h2>{L.s2}</h2>
      <label class="fld" style="display:block">{L.loads}<textarea id="loads" rows="6" class="mono" spellcheck="false">{L.loadsPh}</textarea></label>
      <h2>{L.s3}</h2>
      <div class="row">
        <label class="fld">{L.tAmb}<input id="tAmb" class="mono" value="35" inputmode="decimal" autocomplete="off" /></label>
        <label class="fld">{L.tIn}<input id="tIn" class="mono" value="45" inputmode="decimal" autocomplete="off" /></label>
        <label class="fld">{L.alt}<input id="alt" class="mono" value="0" inputmode="decimal" autocomplete="off" /></label>
        <label class="fld">{L.tMin}<input id="tMin" class="mono" value="-10" inputmode="decimal" autocomplete="off" /></label>
      </div>
      <p class="err" id="err" role="alert"></p>
      <p class="ph-adv" id="adv" aria-live="polite"></p>
      <div class="tbl" aria-live="polite">
        <table class="t kv"><tbody>{Object.entries(L.k1).map(([id, name]) => <tr><td>{name}</td><td data-k={id}></td></tr>)}</tbody></table>
      </div>
      <p class="note">{L.privacy}</p>
    </form>

    <AdSlot />

    <section class="prose">
      <h2>{L.fTitle}</h2>
      <ul>{L.formula.map((f) => <li>{f}</li>)}</ul>
      <h2>{L.aTitle}</h2>
      <div class="tbl">
        <table class="t">
          <tbody>{INSTALL_TYPES.map((x) => <tr><td>{x.id}. {tx(x.name, lang)}</td><td class="mono">A = {AREA_F[x.id]}</td></tr>)}</tbody>
        </table>
      </div>
      <h2>{L.fTable}</h2>
      <div class="tbl">
        <table class="t">
          <thead><tr>{L.fHead.map((x) => <th>{x}</th>)}</tr></thead>
          <tbody>{ALTITUDE_F.map(([m, f]) => <tr><td class="mono">{m}</td><td class="mono">{f}</td></tr>)}</tbody>
        </table>
      </div>
      <p>{L.fNote}</p>
      <h2>{L.lTitle}</h2>
      <ul>{L.l.map((x) => <li>{x}</li>)}</ul>
      <p>{L.see[0]}<a href={link(lang, "tools/heater-power/")}>{L.seeLinks[0]}</a>{L.see[1]}<a href={link(lang, "tools/voltage-drop/")}>{L.seeLinks[1]}</a>{L.see[2]}</p>
      <FaqBlock lang={lang} items={FAQ} title={L.faqTitle} />
      <h2>{L.srcTitle}</h2>
      <ul>{SRC.map((s) => <li><a href={s.href} rel="noopener" target="_blank">{s.name}</a></li>)}</ul>
    </section>
    <UseNotice lang={lang} />
    <WebToolLinks lang={lang} path={PATH} />
  </div>
  <style>
    textarea {
      width: 100%;
    }
    .ph-adv {
      font-weight: 600;
      margin: 10px 0;
    }
  </style>
  <script>
    import { INSTALL_TYPES, effectiveArea, heatBalance, heaterPower, parseLoads } from "../lib/panelHeat";
    const form = document.getElementById("ph") as HTMLFormElement;
    const T = JSON.parse(form.dataset.t ?? "{}") as { bad: string; none: string; advice: Record<string, string> };
    const $ = <E extends HTMLElement = HTMLInputElement>(id: string) => document.getElementById(id) as unknown as E;
    const num = (id: string) => Number(($(id) as HTMLInputElement).value.trim().replace(",", "."));
    const r0 = (v: number) => (Math.abs(v) >= 100 ? v.toFixed(0) : v.toFixed(1));
    const set = (k: string, v: string) => {
      const td = form.querySelector<HTMLElement>(`[data-k="${k}"]`);
      if (td) td.textContent = v;
    };

    function render() {
      const err = $<HTMLElement>("err");
      const [w, h, d, k, tAmb, tIn, alt, tMin] = ["w", "h", "d", "k", "tAmb", "tIn", "alt", "tMin"].map(num);
      if (![w, h, d, k, tAmb, tIn, alt, tMin].every(Number.isFinite) || w <= 0 || h <= 0 || d <= 0 || k <= 0) {
        err.textContent = "W·H·D·k > 0";
        return;
      }
      const inst = INSTALL_TYPES.find((x) => String(x.id) === ($("inst") as unknown as HTMLSelectElement).value)!.i;
      const loads = parseLoads(($("loads") as unknown as HTMLTextAreaElement).value);
      err.textContent = loads.bad.length ? `${T.bad}: ${loads.bad.join(", ")}` : "";
      const area = effectiveArea(w / 1000, h / 1000, d / 1000, inst);
      const r = heatBalance({ pt: loads.total, area, k, tAmb, tIn, altitude: alt });
      const hp = heaterPower(area, k, tMin, tIn, loads.total);
      set("pt", `${r0(loads.total)} W`);
      set("a", `${area.toFixed(3)} m²`);
      set("dt", `${r0(r.dT)} K`);
      set("pc", `${r0(r.pc)} W`);
      set("pa", `${r0(r.pa)} W`);
      set("f", Number.isNaN(r.f) ? T.none : String(r.f));
      set("v", r.airflow === null || !Number.isFinite(r.airflow) ? T.none : `${r0(r.airflow)} m³/h`);
      set("pn", r.pn > 0 ? `${r0(r.pn)} W` : T.none);
      set("qw", r.qw === null || r.qw <= 0 ? T.none : `${r0(r.qw)} W/K`);
      set("pv", hp.pv > 0 ? `${r0(hp.pv)} W` : T.none);
      set("pv2", hp.pv > 0 ? `${r0(hp.pvMinusLoad)} W` : T.none);
      $<HTMLElement>("adv").textContent = T.advice[r.advice] + (Number.isNaN(r.f) && r.advice !== "natural" && r.advice !== "cooler" ? " (> 3500 m)" : "");
    }
    form.addEventListener("input", render);
    form.addEventListener("change", render);
    form.addEventListener("submit", (e) => e.preventDefault());
    render();
  </script>
</Base>
