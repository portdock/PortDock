---
import Base from "../layouts/Base.astro";
import Crumbs from "../components/Crumbs.astro";
import { type Lang } from "../data/tools";
import { WEB_TOOLS } from "../data/webTools";
import { url } from "../lib/i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const ko = lang === "ko";
const name = ko ? "웹 도구" : "Web tools";
---

<Base
  lang={lang}
  title={name}
  seoTitle={ko ? "온라인 CRC·Modbus·HEX 계산기 (설치 없이) — PortDock" : "Online CRC, Modbus and HEX Calculators — PortDock"}
  description={ko
    ? "설치 없이 브라우저에서 쓰는 통신 계산기: CRC16 Modbus·체크섬 계산, CRC 붙은 Modbus RTU 요청 만들기, HEX↔ASCII 변환. 입력은 어디에도 보내지 않습니다."
    : "Communication calculators that run in your browser: CRC16 Modbus and other checksums, Modbus RTU requests with CRC, HEX to ASCII. Nothing leaves the page."}
  path="tools/"
>
  <header class="page-head">
    <div class="wrap">
      <Crumbs lang={lang} items={[{ name, path: "tools/" }]} />
      <h1>{name}</h1>
      <p>{ko ? "설치 없이 브라우저에서 바로 씁니다. 입력한 데이터는 어디에도 보내지 않습니다." : "Run right in your browser. Nothing you type is sent anywhere."}</p>
    </div>
  </header>
  <div class="wrap grid" style="padding-top:24px">
    {
      WEB_TOOLS.map((x) => (
        <a class="card" href={url(lang, x.path)}>
          <h2>{x.name[lang]}</h2>
          <p>{x.blurb[lang]}</p>
          <span class="go">{ko ? "열기" : "Open"} →</span>
        </a>
      ))
    }
  </div>
</Base>
