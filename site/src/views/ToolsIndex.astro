---
import Base from "../layouts/Base.astro";
import Crumbs from "../components/Crumbs.astro";
import { type Lang } from "../data/tools";
import { WEB_TOOLS } from "../data/webTools";
import { groupedWebTools } from "../data/webToolGroups";
import ListFilter from "../components/ListFilter.astro";
import { url } from "../lib/i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const ko = lang === "ko";
const name = ko ? "웹 도구" : "Web tools";
const groups = groupedWebTools();
---

<Base
  lang={lang}
  title={name}
  seoTitle={ko ? "온라인 Modbus·CRC·4–20mA·모터·단위 변환 계산기 — PortDock" : "Online Modbus, CRC, 4–20 mA, Motor & Unit Calculators — PortDock"}
  description={ko
    ? "브라우저 현장 계산기: Modbus 해석·실수, CRC16, 웹 시리얼, RS485, 4–20mA, Pt100·NTC, 전압 강하, 서브넷, 단위, 모터, CAN·UART 보율, ASCII·HEX."
    : "Browser field calculators: Modbus decoder, CRC16, web serial, RS-485, 4–20 mA, RTD and NTC, voltage drop, subnets, units, motors, CAN and UART timing, ASCII."}
  path="tools/"
>
  <header class="page-head">
    <div class="wrap">
      <Crumbs lang={lang} items={[{ name, path: "tools/" }]} />
      <h1>{name}</h1>
      <p>{ko ? `설치 없이 브라우저에서 바로 쓰는 현장 계산기 ${WEB_TOOLS.length}개. 입력한 값은 어디에도 보내지 않습니다.` : `${WEB_TOOLS.length} field calculators that run right in your browser. Nothing you type is sent anywhere.`}</p>
    </div>
  </header>
  <div class="wrap list-page" id="wt-list">
    <ListFilter lang={lang} target="wt-list" total={WEB_TOOLS.length} placeholder={ko ? "도구 찾기 — 예: crc, 4-20, 모터, 서브넷" : "Find a tool — e.g. crc, 4-20, motor, subnet"} />
    <nav class="chips" aria-label={ko ? "종류" : "Categories"}>
      {groups.map((g) => <a href={`#g-${g.id}`}>{g.name[lang]} <small>{g.tools.length}</small></a>)}
    </nav>
    {
      groups.map((g) => (
        <section class="list-group" id={`g-${g.id}`} data-filter-group>
          <h2>{g.name[lang]}</h2>
          <div class="grid">
            {g.tools.map((x) => (
              <a class="card" href={url(lang, x.path)} data-filter-item>
                <h3>{x.name[lang]}</h3>
                <p>{x.blurb[lang]}</p>
                <span class="go">{ko ? "열기" : "Open"} →</span>
              </a>
            ))}
          </div>
        </section>
      ))
    }
  </div>
</Base>
