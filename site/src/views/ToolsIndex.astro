---
import Base from "../layouts/Base.astro";
import Crumbs from "../components/Crumbs.astro";
import { type Lang } from "../data/tools";
import { WEB_TOOLS } from "../data/webTools";
import { url } from "../lib/i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const ko = lang === "ko";
const name = ko ? "웹 도구" : "Web tools";
---

<Base
  lang={lang}
  title={name}
  seoTitle={ko ? "온라인 Modbus·CRC·4–20mA·온도 계산기 (설치 없이) — PortDock" : "Online Modbus, CRC, 4–20 mA and RTD Calculators — PortDock"}
  description={ko
    ? "브라우저에서 쓰는 현장 계산기: Modbus 프레임 해석·실수 변환·요청 만들기, CRC16, 웹 시리얼 터미널, 4–20mA 환산, Pt100·열전대 온도 환산. 입력은 보내지 않습니다."
    : "Field calculators in your browser: Modbus frame decoder, float converter, request builder, CRC16, web serial terminal, 4–20 mA scaling, Pt100 and thermocouples."}
  path="tools/"
>
  <header class="page-head">
    <div class="wrap">
      <Crumbs lang={lang} items={[{ name, path: "tools/" }]} />
      <h1>{name}</h1>
      <p>{ko ? "설치 없이 브라우저에서 바로 씁니다. 입력한 데이터는 어디에도 보내지 않습니다." : "Run right in your browser. Nothing you type is sent anywhere."}</p>
    </div>
  </header>
  <div class="wrap grid" style="padding-top:24px">
    {
      WEB_TOOLS.map((x) => (
        <a class="card" href={url(lang, x.path)}>
          <h2>{x.name[lang]}</h2>
          <p>{x.blurb[lang]}</p>
          <span class="go">{ko ? "열기" : "Open"} →</span>
        </a>
      ))
    }
  </div>
</Base>
