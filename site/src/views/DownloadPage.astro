---
import Base from "../layouts/Base.astro";
import Crumbs from "../components/Crumbs.astro";
import { TOOLS, RELEASED, REPO, RELEASES, downloadable, latest, type Lang } from "../data/tools";
import { UI, url } from "../lib/i18n";
import { SPONSOR_URL } from "@shared/links";
import { appIcon } from "../lib/appIcons";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = UI[lang];
const ko = lang === "ko";
---

<Base
  lang={lang}
  title={t.download}
  seoTitle={ko ? "내려받기 — 무료 통신 테스트 도구 10종 (윈도우) — PortDock" : "Download — Ten Free Hardware Test Tools for Windows — PortDock"}
  description={ko
    ? "시리얼·Modbus 마스터/슬레이브·TCP·UDP·시뮬레이터·Net Scan·SCPI·Plot·Port Inspector 10개 도구의 설치판·오프라인 설치판·휴대판. 무료, 윈도우 10·11."
    : "Installer, offline installer or portable zip — Serial, Modbus Master/Slave, TCP, UDP, Simulator, Net Scan, SCPI, Plot, Port Inspector. Free, Windows 10/11."}
  path="download/"
>
  <header class="page-head">
    <div class="wrap">
      <Crumbs lang={lang} items={[{ name: t.download, path: "download/" }]} />
      <h1>{t.download}</h1>
      <p>{t.dlNote}</p>
      {!RELEASED && <p><b>{t.dlSoon}</b> — {t.dlSoonNote} <a href={REPO}>GitHub →</a></p>}
    </div>
  </header>
  <div class="wrap" style="padding-top:28px">
    {/* 어느 걸 받을지 — 질문 2개. 스크립트가 없어도 세 줄 안내는 그대로 읽힌다 */}
    <section class="pick card" id="pick" aria-labelledby="pick-h">
      <h2 id="pick-h">{ko ? "어느 걸 받아야 하나요?" : "Which one should I get?"}</h2>
      <ul class="pick-list">
        <li data-pick="setup"><b>{t.dlSetup}</b> — {ko ? "대부분은 이것. 인터넷이 되는 PC 에 설치합니다(관리자 권한 필요 없음)." : "Most people. Installs on a PC with internet (no admin rights needed)."}</li>
        <li data-pick="offline"><b>{t.dlOffline}</b> — {ko ? "인터넷이 없는 PC(현장·폐쇄망). 실행에 필요한 WebView2 를 함께 넣었습니다." : "PCs without internet (plant floor, closed networks). WebView2 is bundled."}</li>
        <li data-pick="portable"><b>{t.dlPortable}</b> — {ko ? "설치하지 않고 USB 로 들고 다니며 쓸 때. 압축을 풀어 바로 실행합니다." : "No install — carry it on a USB stick. Unzip and run."}</li>
      </ul>
      <form class="pick-q" hidden>
        <fieldset>
          <legend>{ko ? "1. 이 PC 에 설치해도 되나요?" : "1. Can you install software on this PC?"}</legend>
          <label><input type="radio" name="inst" value="y" checked /> {ko ? "예" : "Yes"}</label>
          <label><input type="radio" name="inst" value="n" /> {ko ? "아니요 / 설치 없이 쓰고 싶어요" : "No / I'd rather not install"}</label>
        </fieldset>
        <fieldset>
          <legend>{ko ? "2. 이 PC 가 인터넷에 연결돼 있나요?" : "2. Is this PC connected to the internet?"}</legend>
          <label><input type="radio" name="net" value="y" checked /> {ko ? "예" : "Yes"}</label>
          <label><input type="radio" name="net" value="n" /> {ko ? "아니요" : "No"}</label>
        </fieldset>
        <p class="pick-out" aria-live="polite"></p>
      </form>
    </section>
    <table class="t dl-table" data-pick="setup">
      <thead>
        <tr><th>{t.tools}</th><th class="c-setup">{t.dlSetup}</th><th class="c-offline">{t.dlOffline}</th><th class="c-portable">{t.dlPortable}</th><th>{t.docs}</th></tr>
      </thead>
      <tbody>
        {
          TOOLS.map((x) => (
            <tr>
              <td class="dl-name">
                {appIcon(x.id) && <img class="app-icon sm" src={appIcon(x.id)} alt="" width="28" height="28" loading="lazy" decoding="async" />}
                <span>
                  <a href={url(lang, `${x.id}/`)}><b>{x.name}</b></a>
                  <br />
                  <span class="note">{x.tagline[lang]}</span>
                </span>
              </td>
              {downloadable(x) ? (
                <>
                  <td class="c-setup" data-label={t.dlSetup}><a class="btn primary" href={latest(`${x.file}-setup.exe`)}>{ko ? "받기" : "Get"}</a></td>
                  <td class="c-offline" data-label={t.dlOffline}><a class="btn" href={latest(`${x.file}-setup-offline.exe`)}>{ko ? "받기" : "Get"}</a></td>
                  <td class="c-portable" data-label={t.dlPortable}><a class="btn" href={latest(`${x.file}-portable.zip`)}>{ko ? "받기" : "Get"}</a></td>
                </>
              ) : (
                <td colspan="3"><span class="note">{x.upcoming ? t.dlUpcoming : t.dlSoon}</span></td>
              )}
              <td class="dl-docs"><a href={url(lang, `${x.id}/docs/`)}>{t.docs}</a></td>
            </tr>
          ))
        }
      </tbody>
    </table>
    <p class="note"><a href={RELEASES}>{t.dlAll} →</a></p>

    <section class="prose" id="safe">
      <h2>{t.safeTitle}</h2>
      <ul>{t.safe.map((s) => <li>{s}</li>)}</ul>
      <p class="note">{ko ? "파일 값 확인 예:" : "Hash check example:"}</p>
      <pre class="result">Get-FileHash .\PortDock-Serial-setup.exe -Algorithm SHA256</pre>
      <p><a href={url(lang, "code-signing/")}>{t.codeSigning} →</a></p>
      <h2>{ko ? "필요한 것" : "Requirements"}</h2>
      <ul>
        <li>{ko ? "윈도우 10 또는 11, 64비트" : "Windows 10 or 11, 64-bit"}</li>
        <li>{t.webview}</li>
        <li>{ko ? "설치판: 관리자 권한 없이 사용자 계정에 설치됩니다. 삭제는 «설정 → 앱» 에서." : "Installer: installs per user without admin rights. Uninstall from «Settings → Apps»."}</li>
        <li>{ko ? "휴대판: zip 을 풀어 exe 를 실행합니다. 설정·기록은 exe 옆 portdock-data 폴더에 남아 USB 로 옮겨 쓸 수 있습니다. 같은 폴더에 두고 쓰면 방화벽 허용을 다시 묻지 않습니다." : "Portable: unzip and run the exe. Settings and reports stay in the portdock-data folder next to it, so you can carry it on a USB stick. Keep it in the same folder to avoid repeated firewall prompts."}</li>
        <li>
          {ko ? "Scoop 으로(휴대판): " : "With Scoop (portable edition): "}
          <code>scoop bucket add portdock https://github.com/portdock/scoop-bucket</code>
          {" → "}
          <code>scoop install portdock/portdock-serial</code>
          {ko ? " — 앱 이름은 " : " — app names are listed in "}
          <a href="https://github.com/portdock/scoop-bucket#install">scoop-bucket</a>
          {ko ? " 에 있습니다." : "."}
        </li>
      </ul>
      {
        SPONSOR_URL && (
          <>
            <h2>{t.sponsor}</h2>
            <p>
              {ko ? "PortDock 은 무료입니다. 도움이 되셨다면 " : "PortDock is free. If it helps you, "}
              <a href={SPONSOR_URL}>{ko ? "후원으로 개발을 도와주세요" : "please consider sponsoring its development"} →</a>
            </p>
          </>
        )
      }
    </section>
  </div>
  <script>
    // 질문 2개 → 권하는 파일 종류를 표에서 강조(설치판·오프라인 설치판·휴대판)
    const form = document.querySelector<HTMLFormElement>(".pick-q");
    const table = document.querySelector<HTMLElement>(".dl-table");
    const list = document.querySelector<HTMLElement>(".pick-list");
    if (form && table && list) {
      const ko = document.documentElement.lang === "ko";
      const NAME: Record<string, string> = ko
        ? { setup: "설치판 (.exe)", offline: "오프라인 설치판", portable: "휴대판 (.zip)" }
        : { setup: "Installer (.exe)", offline: "Offline installer", portable: "Portable (.zip)" };
      form.hidden = false;
      const run = () => {
        const inst = (form.elements.namedItem("inst") as RadioNodeList).value;
        const net = (form.elements.namedItem("net") as RadioNodeList).value;
        const pick = inst === "n" ? "portable" : net === "n" ? "offline" : "setup";
        table.dataset.pick = pick;
        for (const li of list.querySelectorAll<HTMLElement>("li")) li.classList.toggle("on", li.dataset.pick === pick);
        const out = form.querySelector(".pick-out")!;
        out.textContent = (ko ? "→ 이것을 받으세요: " : "→ Get this one: ") + NAME[pick] + (pick === "portable" && net === "n" ? (ko ? " (휴대판은 WebView2 가 있는 PC 에서만 실행됩니다 — 윈도우 11 은 기본 포함)" : " (the portable edition needs WebView2 on the PC — included in Windows 11)") : "");
      };
      form.addEventListener("change", run);
      run();
    }
  </script>
</Base>
