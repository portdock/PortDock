---
// 웹 도구: GigE 카메라 대역폭 — 해상도·픽셀 형식·fps·카메라 수·링크 → MB/s, 링크 대비 %, 최대 fps(lib/gige.ts).
// 근거: Beckhoff «Bandwidth management for GigE Vision»(식·예·1 GbE 125 MB/s·110~115 MB/s 가정), EMVA PFNC 2.4(화소 크기).
import Base from "../layouts/Base.astro";
import AdSlot from "../components/AdSlot.astro";
import Crumbs from "../components/Crumbs.astro";
import WebToolLinks from "../components/WebToolLinks.astro";
import UseNotice from "../components/UseNotice.astro";
import { PIXEL_FORMATS, gige } from "../lib/gige";
import { type Lang } from "../data/tools";
import { url } from "../lib/i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const ko = lang === "ko";
const PATH = "tools/gige-bandwidth/";
const BECKHOFF = "https://infosys.beckhoff.com/content/1033/tf7xxx_tc3_vision/22185723659.html";
const PFNC = "https://www.emva.org/wp-content/uploads/GenICam_PFNC_2_4.pdf";
// 해상도별 표 — 1 GbE, 쓸 수 있는 속도 110 MB/s(Beckhoff 예의 가정 아래쪽), 카메라 1대
const RES: [number, number][] = [
  [640, 480],
  [1280, 1024],
  [1920, 1200],
  [2448, 2048],
  [4096, 3000],
];
const tRows = RES.map(([w, h]) => {
  const m8 = gige(w, h, 8, 1, 1, 1, 110 / 125);
  const m12 = gige(w, h, 16, 1, 1, 1, 110 / 125);
  const rgb = gige(w, h, 24, 1, 1, 1, 110 / 125);
  return [`${w} × ${h}`, (m8.frameBytes / 1e6).toFixed(2), m8.maxFps.toFixed(1), m12.maxFps.toFixed(1), rgb.maxFps.toFixed(1)];
});
const L = ko
  ? {
      title: "GigE 카메라 대역폭 계산기",
      desc: "해상도·픽셀 형식(Mono8·Mono12·RGB8 등)·fps·카메라 수로 영상 데이터 속도(MB/s)와 1·2.5·5·10 GbE 링크 대비 비율, 링크 안에서 낼 수 있는 최대 fps 를 계산합니다.",
      w: "가로 (화소)",
      h: "세로 (화소)",
      pf: "픽셀 형식",
      fps: "프레임 수 (fps)",
      cams: "같은 링크를 쓰는 카메라 수",
      link: "링크",
      usable: "쓸 수 있다고 볼 속도 (링크의 %)",
      res: "결과",
      k: { frame: "한 프레임", per: "카메라 한 대", total: "모든 카메라 합", link: "링크 총 속도 대비", usable: "쓸 수 있는 속도 대비", max: "카메라마다 최대 fps (쓸 수 있는 속도 안에서)" },
      example: "기본값(1920 × 1200, Mono8, 30 fps, 1대, 1 GbE, 88 %)은 Beckhoff 문서의 예입니다. 88 % 는 그 예가 가정한 «안정적으로 쓸 수 있는 속도» 110 MB/s ÷ 125 MB/s 입니다 — 정해진 값이 아니라 카메라·랜카드·스위치에 따라 정합니다.",
      how: "값을 바꾸면 바로 다시 계산합니다. 계산은 이 브라우저 안에서만 하고, 입력한 값은 어디에도 보내지 않습니다.",
      fTitle: "계산식",
      formula: [
        "영상 데이터 속도 [바이트/s] = 가로 × 세로 × (화소당 비트 ÷ 8) × fps",
        "모든 카메라 합 = 카메라 한 대 × 카메라 수 (한 랜카드 포트·한 스위치 업링크를 나눠 쓸 때)",
        "링크 총 속도 = 링크 [Gbit/s] × 10⁹ ÷ 8 — 1 GbE = 125 MB/s",
        "최대 fps = 쓸 수 있는 속도 ÷ 카메라 수 ÷ 한 프레임 바이트",
        "MB = 10⁶ 바이트. 이더넷·IP·UDP·GVSP 머리글 같은 프로토콜 오버헤드는 넣지 않은 단순 계산입니다 — 그 몫은 «쓸 수 있는 속도» 를 낮게 잡아 남깁니다.",
      ],
      tTitle: "해상도별 최대 fps (1 GbE, 쓸 수 있는 속도 110 MB/s, 카메라 1대)",
      tHead: ["해상도", "Mono8 한 프레임 (MB)", "Mono8", "Mono12 (16비트)", "RGB8"],
      tNote: "카메라 쪽 한계(센서 최대 fps·노출 시간)는 넣지 않았습니다. 표의 값은 링크가 허락하는 상한이고, 실제 fps 는 카메라 데이터시트의 최대 fps 와 둘 가운데 작은 쪽입니다.",
      pTitle: "픽셀 형식과 화소당 크기",
      pHead: ["형식", "화소당 비트", "설명"],
      pRows: [
        ["Mono8 · Bayer**8", "8", "8비트 한 성분"],
        ["Mono10 · Mono12 · Bayer**10 · Bayer**12", "16", "unpacked — 성분마다 다음 바이트 경계까지 0 으로 채움"],
        ["Mono10p · Bayer**10p", "10", "lsb packed — 빈 비트 없이 이어 붙임"],
        ["Mono12p · Bayer**12p", "12", "lsb packed"],
        ["Mono16", "16", "16비트 한 성분"],
        ["RGB8 · BGR8", "24", "8비트 성분 3개"],
        ["YCbCr422_8", "16", "4:2:2 — 화소 둘에 Y 둘과 Cb·Cr 하나씩"],
      ],
      pNote: "Bayer** 의 ** 는 RG·GR·GB·BG 배열입니다. 카메라에 따라 옛 이름(예: Mono12Packed)을 쓰기도 합니다 — 화소당 비트는 카메라 설명서에서 확인합니다.",
      lTitle: "읽는 법",
      l: [
        "링크 대비 100 % 를 넘으면 그 설정으로는 다 보낼 수 없습니다. fps 를 줄이거나, 관심 영역(ROI)으로 해상도를 줄이거나, 8비트 형식·packed 형식으로 바꾸거나, 카메라를 다른 랜카드 포트로 나눕니다.",
        "Beckhoff 예처럼 1920 × 1200 Mono8 30 fps 카메라 3대(207 MB/s)는 1 GbE 한 줄에 다 실을 수 없고, 15 fps 로 줄이면 104 MB/s 로 들어옵니다.",
        "Mono12(unpacked)는 화소마다 2 바이트라 Mono8 의 두 배입니다. 12비트가 필요하면 Mono12p(1.5 바이트)를 지원하는지 봅니다.",
        "링크 대비 비율이 낮아도 프레임이 빠지면 대역폭보다 랜카드 설정(점보 프레임·수신 버퍼)·방화벽·스위치를 먼저 봅니다 — 아래 가이드.",
      ],
      uTitle: "현장에서 쓰는 곳",
      u: [
        "머신 비전 PC 를 고를 때 — 카메라 몇 대를 랜카드 포트 몇 개에 나눌지, 1 GbE 로 될지 2.5·5·10 GbE 가 필요한지.",
        "여러 카메라를 스위치 하나로 모을 때 — 스위치에서 PC 로 가는 업링크 하나를 모든 카메라가 나눠 씁니다.",
        "fps 를 올리려는데 프레임이 빠질 때 — 링크 한계에 걸린 것인지 먼저 계산해 봅니다.",
      ],
      faqTitle: "자주 묻는 것",
      faq: [
        ["GigE 카메라 대역폭은 어떻게 계산하나요?", "가로 × 세로 × 화소당 바이트 × fps 입니다. 1920 × 1200 Mono8(1 바이트) 30 fps 면 69.12 MB/s 입니다. 프로토콜 오버헤드는 따로 여유를 둡니다."],
        ["1 GbE 는 몇 MB/s 인가요?", "총 속도는 1 Gbit/s ÷ 8 = 125 MB/s 입니다. 영상에 실제로 쓸 수 있는 속도는 이보다 작습니다 — Beckhoff 예는 약 110~115 MB/s 를 가정합니다."],
        ["Mono12 와 Mono12p 는 무엇이 다른가요?", "Mono12 는 12비트 값을 2 바이트에 담고 남는 4비트를 0 으로 채우고(16비트), Mono12p 는 빈 비트 없이 이어 붙입니다(12비트). 같은 fps 라면 Mono12p 가 데이터가 25 % 적습니다."],
        ["카메라 두 대를 스위치로 묶어 PC 한 포트에 연결하면?", "두 대의 속도를 더한 값이 그 포트 하나의 링크 안에 들어가야 합니다. 카메라 수 칸에 2 를 넣어 보세요."],
      ],
      gNote: "랜카드의 점보 프레임·수신 버퍼·인터럽트 완화 설정은",
      gLink: "GigE 카메라 랜카드 설정 가이드",
      sNote: "카메라·PC 가 같은 대역인지는",
      sLink: "IP 서브넷 계산기",
      aNote: "PC 의 랜카드 설정을 한 화면에 읽으려면",
      aLink: "PortDock Port Inspector",
      srcTitle: "근거",
      src1: "식과 예(1920 × 1200 Mono8 30 fps = 69.12 MB/s, 3대 207.36 MB/s, 15 fps 103.68 MB/s, 1 Gbit/s = 125 MB/s, 쓸 수 있는 속도 약 110~115 MB/s 가정):",
      src1Link: "Beckhoff TwinCAT 3 Vision — Bandwidth management for GigE Vision",
      src2: "화소당 비트(성분 비트 × 성분 수, unpacked 는 바이트 경계까지 채움, «p» 는 빈 비트 없이, 4:2:2 순서):",
      src2Link: "EMVA GenICam Pixel Format Naming Convention 2.4 (2021-06-16) §3.1.3·§4·§6.1",
    }
  : {
      title: "GigE Camera Bandwidth Calculator",
      desc: "Image data rate (MB/s) from resolution, pixel format, fps and camera count; share of a 1, 2.5, 5 or 10 GbE link and the highest frame rate that fits.",
      w: "Width (pixels)",
      h: "Height (pixels)",
      pf: "Pixel format",
      fps: "Frame rate (fps)",
      cams: "Cameras sharing the link",
      link: "Link",
      usable: "Usable share of the link (%)",
      res: "Results",
      k: { frame: "One frame", per: "One camera", total: "All cameras", link: "Of gross link rate", usable: "Of usable rate", max: "Max fps per camera (within usable rate)" },
      example: "The defaults (1920 × 1200, Mono8, 30 fps, one camera, 1 GbE, 88 %) follow the Beckhoff example. 88 % is that example's assumed stable usable rate, 110 MB/s ÷ 125 MB/s — not a fixed figure; set it for your camera, adapter and switch.",
      how: "Results update as you type. Everything runs in your browser; nothing you type is sent anywhere.",
      fTitle: "Formulas",
      formula: [
        "Image data rate [bytes/s] = width × height × (bits per pixel ÷ 8) × fps",
        "All cameras = one camera × number of cameras (when they share one adapter port or one switch uplink)",
        "Gross link rate = link [Gbit/s] × 10⁹ ÷ 8 — 1 GbE = 125 MB/s",
        "Max fps = usable rate ÷ cameras ÷ bytes per frame",
        "MB = 10⁶ bytes. Protocol overhead (Ethernet, IP, UDP and GVSP headers) is not included in this simplified calculation — leave room for it by setting the usable rate lower.",
      ],
      tTitle: "Max fps by resolution (1 GbE, usable 110 MB/s, one camera)",
      tHead: ["Resolution", "Mono8 frame (MB)", "Mono8", "Mono12 (16-bit)", "RGB8"],
      tNote: "Camera limits (sensor maximum fps, exposure time) are not included. The table shows what the link allows; the real frame rate is the lower of this and the camera datasheet's maximum.",
      pTitle: "Pixel formats and size per pixel",
      pHead: ["Format", "Bits per pixel", "Notes"],
      pRows: [
        ["Mono8 · Bayer**8", "8", "One 8-bit component"],
        ["Mono10 · Mono12 · Bayer**10 · Bayer**12", "16", "Unpacked — each component padded with zeros to the next byte"],
        ["Mono10p · Bayer**10p", "10", "lsb packed — no padding bits"],
        ["Mono12p · Bayer**12p", "12", "lsb packed"],
        ["Mono16", "16", "One 16-bit component"],
        ["RGB8 · BGR8", "24", "Three 8-bit components"],
        ["YCbCr422_8", "16", "4:2:2 — two pixels carry two Y and one each of Cb and Cr"],
      ],
      pNote: "In Bayer** the ** is the RG, GR, GB or BG pattern. Some cameras use older names (e.g. Mono12Packed) — check the bits per pixel in the camera manual.",
      lTitle: "How to read it",
      l: [
        "Over 100 % of the link means the settings cannot all be sent. Lower the frame rate, cut the resolution with a region of interest, switch to an 8-bit or packed format, or spread cameras over more adapter ports.",
        "As in the Beckhoff example, three 1920 × 1200 Mono8 cameras at 30 fps (207 MB/s) do not fit on one 1 GbE link; at 15 fps they need 104 MB/s and fit.",
        "Mono12 (unpacked) takes 2 bytes per pixel, twice Mono8. If you need 12 bits, check whether the camera offers Mono12p (1.5 bytes).",
        "If frames drop while the link share is low, look at adapter settings (jumbo frames, receive buffers), the firewall and the switch before bandwidth — see the guide below.",
      ],
      uTitle: "Where it is used",
      u: [
        "Choosing a vision PC: how to spread cameras over adapter ports, and whether 1 GbE is enough or 2.5, 5 or 10 GbE is needed.",
        "Joining several cameras through one switch — they all share the single uplink from switch to PC.",
        "Raising the frame rate and seeing dropped frames — first check whether the link is the limit.",
      ],
      faqTitle: "FAQ",
      faq: [
        ["How do I calculate GigE camera bandwidth?", "Width × height × bytes per pixel × fps. 1920 × 1200 Mono8 (1 byte) at 30 fps is 69.12 MB/s. Leave separate headroom for protocol overhead."],
        ["How many MB/s is 1 GbE?", "The gross rate is 1 Gbit/s ÷ 8 = 125 MB/s. The rate you can actually use for images is lower — the Beckhoff example assumes about 110–115 MB/s."],
        ["What is the difference between Mono12 and Mono12p?", "Mono12 puts each 12-bit value in 2 bytes with 4 zero bits (16 bits); Mono12p packs values with no padding (12 bits). At the same frame rate Mono12p carries 25 % less data."],
        ["Two cameras through a switch into one PC port?", "Their combined rate must fit within that one port's link. Enter 2 in the camera count."],
      ],
      gNote: "For jumbo frames, receive buffers and interrupt moderation on the adapter, see the",
      gLink: "GigE camera network adapter settings guide",
      sNote: "To check the camera and PC are on the same subnet, use the",
      sLink: "IP Subnet Calculator",
      aNote: "To read this PC's adapter settings on one screen, use",
      aLink: "PortDock Port Inspector",
      srcTitle: "Basis",
      src1: "Formula and examples (1920 × 1200 Mono8 at 30 fps = 69.12 MB/s, three cameras 207.36 MB/s, 15 fps 103.68 MB/s, 1 Gbit/s = 125 MB/s, usable about 110–115 MB/s assumed):",
      src1Link: "Beckhoff TwinCAT 3 Vision — Bandwidth management for GigE Vision",
      src2: "Bits per pixel (component bits × components, unpacked padded to byte boundaries, «p» with no padding, 4:2:2 order):",
      src2Link: "EMVA GenICam Pixel Format Naming Convention 2.4 (2021-06-16) §3.1.3, §4, §6.1",
    };
const ld = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: L.faq.map(([q, a]) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a } })),
};
---

<Base lang={lang} title={L.title} seoTitle={ko ? "GigE 카메라 대역폭 계산기 — MB/s·1 GbE 한계·최대 fps — PortDock" : "GigE Camera Bandwidth Calculator: MB/s and Max FPS — PortDock"} description={L.desc} path={PATH} ads>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <header class="page-head">
    <div class="wrap">
      <Crumbs lang={lang} items={[{ name: ko ? "웹 도구" : "Web tools", path: "tools/" }, { name: L.title, path: PATH }]} />
      <h1>{L.title}</h1>
      <p>{L.desc}</p>
    </div>
  </header>
  <div class="wrap" style="padding-top:24px">
    <form class="calc card" id="gv">
      <div class="row">
        <label class="fld">{L.w}<input id="w" class="mono" value="1920" inputmode="numeric" spellcheck="false" autocomplete="off" /></label>
        <label class="fld">{L.h}<input id="h" class="mono" value="1200" inputmode="numeric" spellcheck="false" autocomplete="off" /></label>
        <label class="fld">{L.pf}<select id="pf">{PIXEL_FORMATS.map((p) => <option value={p.bits} selected={p.id === "Mono8"}>{`${p.id} (${p.bits} bit)`}</option>)}</select></label>
        <label class="fld">{L.fps}<input id="fps" class="mono" value="30" inputmode="decimal" spellcheck="false" autocomplete="off" /></label>
      </div>
      <div class="row">
        <label class="fld">{L.cams}<input id="n" class="mono" value="1" inputmode="numeric" spellcheck="false" autocomplete="off" /></label>
        <label class="fld">{L.link}<select id="link"><option value="1" selected>1 GbE</option><option value="2.5">2.5 GbE</option><option value="5">5 GbE</option><option value="10">10 GbE</option></select></label>
        <label class="fld">{L.usable}<input id="u" class="mono" value="88" inputmode="decimal" spellcheck="false" autocomplete="off" /></label>
      </div>
      <p class="err" id="err" role="alert"></p>
      <div class="tbl" aria-live="polite">
        <table class="t kv">
          <caption class="note" style="text-align:left">{L.res}</caption>
          <tbody>{Object.entries(L.k).map(([id, name]) => <tr><td>{name}</td><td class="mono" data-k={id}></td></tr>)}</tbody>
        </table>
      </div>
      <p class="note">{L.example}</p>
      <p class="note">{L.how}</p>
    </form>

    <AdSlot />

    <section class="prose">
      <h2>{L.fTitle}</h2>
      <ul>{L.formula.map((f) => <li>{f}</li>)}</ul>
      <h2>{L.tTitle}</h2>
      <div class="tbl">
        <table class="t">
          <thead><tr>{L.tHead.map((h) => <th>{h}</th>)}</tr></thead>
          <tbody>{tRows.map((r) => <tr>{r.map((c) => <td class="mono">{c}</td>)}</tr>)}</tbody>
        </table>
      </div>
      <p>{L.tNote}</p>
      <h2>{L.pTitle}</h2>
      <div class="tbl">
        <table class="t">
          <thead><tr>{L.pHead.map((h) => <th>{h}</th>)}</tr></thead>
          <tbody>{L.pRows.map((r) => <tr><td class="mono">{r[0]}</td><td class="mono">{r[1]}</td><td>{r[2]}</td></tr>)}</tbody>
        </table>
      </div>
      <p>{L.pNote}</p>
      <h2>{L.lTitle}</h2>
      <ul>{L.l.map((x) => <li>{x}</li>)}</ul>
      <h2>{L.uTitle}</h2>
      <ul>{L.u.map((x) => <li>{x}</li>)}</ul>
      <h2>{L.faqTitle}</h2>
      {
        L.faq.map(([q, a]) => (
          <>
            <h3>{q}</h3>
            <p>{a}</p>
          </>
        ))
      }
      <p>
        {L.gNote} <a href={url(lang, "guides/gige-camera-network-adapter/")}>{L.gLink}</a>. {L.sNote} <a href={url(lang, "tools/subnet/")}>{L.sLink}</a>. {L.aNote} <a href={url(lang, "port-inspector/")}>{L.aLink}</a>.
      </p>
      <h2>{L.srcTitle}</h2>
      <ul>
        <li>{L.src1} <a href={BECKHOFF} rel="noopener">{L.src1Link}</a></li>
        <li>{L.src2} <a href={PFNC} rel="noopener">{L.src2Link}</a></li>
      </ul>
    </section>
    <UseNotice lang={lang} />
    <WebToolLinks lang={lang} path={PATH} />
  </div>
  <script>
    import { gige } from "../lib/gige";
    const ko = document.documentElement.lang === "ko";
    const form = document.getElementById("gv") as HTMLFormElement;
    const $ = <E extends HTMLElement = HTMLInputElement>(id: string) => document.getElementById(id) as E;
    const num = (id: string) => {
      const s = $(id).value.trim().replace(",", ".");
      return s === "" ? NaN : Number(s);
    };
    const set = (k: string, v: string) => {
      const td = form.querySelector<HTMLElement>(`td[data-k="${k}"]`);
      if (td) td.textContent = v;
    };
    const mbs = (b: number) => `${(b / 1e6).toFixed(2)} MB/s`;
    const pct = (x: number) => `${(x * 100).toFixed(1)} %`;
    function run() {
      try {
        const o = gige(num("w"), num("h"), Number($<HTMLSelectElement>("pf").value), num("fps"), num("n"), Number($<HTMLSelectElement>("link").value), num("u") / 100);
        set("frame", `${(o.frameBytes / 1e6).toFixed(3)} MB`);
        set("per", mbs(o.perCamera));
        set("total", `${mbs(o.total)} (${((o.total * 8) / 1e9).toFixed(3)} Gbit/s)`);
        set("link", pct(o.ofLink));
        set("usable", `${pct(o.ofUsable)}${o.ofUsable > 1 ? (ko ? " — 넘침" : " — over") : ""}`);
        set("max", `${o.maxFps.toFixed(1)} fps`);
        $("err").textContent = "";
      } catch {
        $("err").textContent = ko ? "숫자를 확인하세요 — 가로·세로·카메라 수는 1 이상 정수(카메라 64대까지), fps 는 0 보다 크게, 쓸 수 있는 속도는 1~100 %" : "Check the numbers — width, height and cameras whole numbers from 1 (up to 64 cameras), fps above 0, usable share 1–100 %";
        for (const td of form.querySelectorAll<HTMLElement>("td[data-k]")) td.textContent = "";
      }
    }
    form.addEventListener("input", run);
    form.addEventListener("change", run);
    form.addEventListener("submit", (e) => e.preventDefault());
    run();
  </script>
</Base>
