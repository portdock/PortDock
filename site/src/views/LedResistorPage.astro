---
// 웹 도구: LED 직렬 저항 — 전원·순방향 전압·전류·직렬 개수 → 저항·전력, E12·E24 표준 값과 그때 전류(lib/led.ts).
// 옴의 법칙(정의식). Vf·If 는 데이터시트 값을 사용자가 넣는다 — 색별 «보통 값» 은 출처 없이 싣지 않는다.
import Base from "../layouts/Base.astro";
import AdSlot from "../components/AdSlot.astro";
import Crumbs from "../components/Crumbs.astro";
import WebToolLinks from "../components/WebToolLinks.astro";
import UseNotice from "../components/UseNotice.astro";
import { ledResistor, ledStandard, withResistor } from "../lib/led";
import { type Lang } from "../data/tools";
import { url } from "../lib/i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const ko = lang === "ko";
const PATH = "tools/led-resistor/";
const ohmS = (r: number) => (r >= 1e3 ? `${+(r / 1e3).toPrecision(4)} kΩ` : `${+r.toPrecision(4)} Ω`);
const mw = (p: number) => `${+(p * 1e3).toPrecision(3)} mW`;
// 전원별 표 — Vf 2.0 V, 10 mA(예시 값)
const tRows = [5, 12, 24].map((vs) => {
  const o = ledResistor(vs, 2, 0.01);
  const e = ledStandard(o.r, "E12").above;
  const w = withResistor(vs, 2, e);
  return [`${vs} V`, ohmS(o.r), ohmS(e), `${+(w.i * 1e3).toPrecision(3)} mA`, mw(w.pr)];
});
const L = ko
  ? {
      title: "LED 저항 계산기",
      desc: "전원 전압·LED 순방향 전압(Vf)·전류·직렬 개수로 LED 저항 값과 전력을 계산하고, E12·E24 표준 값일 때의 전류를 보여 줍니다. 5·12·24 V 표시등.",
      vs: "전원 전압 Vs (V)",
      vf: "LED 순방향 전압 Vf (V, 하나)",
      i: "LED 전류 If (mA)",
      n: "직렬 LED 개수",
      ser: "표준 값 계열",
      res: "결과",
      k: { vr: "저항에 걸리는 전압 Vs − n × Vf", r: "계산한 저항", near: "가까운 표준 값 / 그때 전류", up: "바로 위 표준 값 / 그때 전류 (목표 이하)", pr: "저항 전력 (바로 위 값에서)", pl: "LED 하나의 전력 (바로 위 값에서)" },
      example: "기본값(24 V, Vf 2.0 V, 10 mA)은 예시입니다. Vf·If 는 쓰는 LED 의 데이터시트 값을 넣으세요 — 색·제품·온도마다 다르고, 데이터시트에는 대개 대표값과 최댓값이 따로 있습니다.",
      how: "값을 바꾸면 바로 다시 계산합니다. 계산은 이 브라우저 안에서만 하고, 입력한 값은 어디에도 보내지 않습니다.",
      fTitle: "계산식",
      formula: [
        "R = (Vs − n × Vf) ÷ If",
        "저항 전력 P = If² × R = (Vs − n × Vf) × If",
        "LED 하나의 전력 = Vf × If",
        "정한 R 로 흐르는 전류 If = (Vs − n × Vf) ÷ R",
      ],
      tTitle: "전원 전압별 (Vf 2.0 V, 10 mA, E12 바로 위 값)",
      tHead: ["전원", "계산 R", "E12", "전류", "저항 전력"],
      tNote: "Vf 2.0 V·10 mA 는 계산을 보이려는 예시 값입니다. 전원이 높을수록 같은 전류에서 저항이 받는 전력이 커져 24 V 에서는 LED 전력(20 mW)의 10배가 넘습니다.",
      lTitle: "읽는 법",
      l: [
        "표준 값은 «바로 위» 를 고르면 전류가 목표를 넘지 않습니다. 가까운 값이 아래쪽이면 전류가 목표보다 조금 커집니다.",
        "Vf 가 데이터시트 대표값보다 낮은 개체·온도에서는 전류가 늘어납니다. 전원과 Vf 의 차가 작을수록(예: 5 V 에 Vf 3 V) 이 영향이 커집니다.",
        "직렬로 여러 개를 이으면 저항 전력이 줄지만, 전원 전압이 n × Vf 에 가까워지면 전류가 Vf 변화에 민감해집니다. Vs ≤ n × Vf 면 저항에 남는 전압이 없어 계산이 안 됩니다.",
        "저항은 계산한 전력보다 정격 전력이 충분히 큰 것을 씁니다 — 정격 대비 얼마나 낮게 쓸지는 저항 데이터시트의 감액 곡선을 봅니다.",
      ],
      uTitle: "현장에서 쓰는 곳",
      u: [
        "24 V DC 제어반의 상태 표시 LED, 센서·릴레이 동작 표시처럼 LED 를 직접 달 때.",
        "마이컴 핀(3.3 V·5 V)으로 LED 를 켤 때 — 핀이 낼 수 있는 전류 한도는 MCU 데이터시트를 봅니다.",
        "LED 여러 개를 병렬로 하나의 저항에 물리면 Vf 차이로 전류가 고르게 나뉘지 않습니다. 줄마다 저항을 따로 둡니다.",
      ],
      faqTitle: "자주 묻는 것",
      faq: [
        ["LED 저항 공식은?", "R = (전원 전압 − LED 순방향 전압) ÷ LED 전류 입니다. 5 V, Vf 2 V, 20 mA 면 3 V ÷ 0.02 A = 150 Ω 이고, 저항 전력은 60 mW 입니다."],
        ["24 V 에 LED 를 달려면 저항이 얼마?", "Vf 2 V·10 mA 라면 (24 − 2) ÷ 0.01 = 2.2 kΩ, 저항 전력 0.22 W 입니다. 1/4 W 저항이면 여유가 거의 없으므로 정격이 더 큰 저항을 고르거나 전류를 낮춥니다."],
        ["LED 를 직렬로 여러 개 달면?", "Vf 를 개수만큼 더해 뺍니다. 12 V 에 Vf 3 V LED 3개, 20 mA 면 (12 − 9) ÷ 0.02 = 150 Ω 입니다."],
        ["계산값이 표준 값에 없으면?", "바로 위 표준 값을 쓰면 전류가 목표보다 조금 작아집니다. 위 «바로 위 표준 값 / 그때 전류» 칸이 그 값입니다."],
      ],
      pNote: "두 저항으로 원하는 값을 만들려면",
      pLink: "합성 저항 계산기",
      vNote: "긴 배선에서 전압이 얼마나 떨어지는지는",
      vLink: "전압 강하·전선 굵기 계산기",
      srcTitle: "근거",
      src: "저항·전류·전력은 옴의 법칙(정의식)으로 계산합니다. E12·E24 표준 값은 Vishay 문서 28372(IEC 60063 의 표)에서 옮긴 값입니다. LED 의 Vf·If 와 저항의 정격 전력은 각 데이터시트를 보세요.",
    }
  : {
      title: "LED Resistor Calculator",
      desc: "LED series resistor and its power from supply voltage, forward voltage (Vf), current and LEDs in series, and the current with an E12/E24 value. 5, 12, 24 V.",
      vs: "Supply voltage Vs (V)",
      vf: "LED forward voltage Vf (V, each)",
      i: "LED current If (mA)",
      n: "LEDs in series",
      ser: "Standard series",
      res: "Results",
      k: { vr: "Voltage across the resistor Vs − n × Vf", r: "Calculated resistor", near: "Nearest standard value / current", up: "Next value up / current (at or below target)", pr: "Resistor power (next value up)", pl: "Power per LED (next value up)" },
      example: "The defaults (24 V, Vf 2.0 V, 10 mA) are an example. Enter Vf and If from your LED's datasheet — they vary by colour, part and temperature, and datasheets usually give typical and maximum values separately.",
      how: "Results update as you type. Everything runs in your browser; nothing you type is sent anywhere.",
      fTitle: "Formulas",
      formula: [
        "R = (Vs − n × Vf) ÷ If",
        "Resistor power P = If² × R = (Vs − n × Vf) × If",
        "Power per LED = Vf × If",
        "Current with a chosen R: If = (Vs − n × Vf) ÷ R",
      ],
      tTitle: "By supply voltage (Vf 2.0 V, 10 mA, next E12 value up)",
      tHead: ["Supply", "Calculated R", "E12", "Current", "Resistor power"],
      tNote: "Vf 2.0 V and 10 mA are example values to show the calculation. The higher the supply, the more power the resistor takes at the same current: at 24 V it is over ten times the LED's 20 mW.",
      lTitle: "How to read it",
      l: [
        "Picking the next standard value up keeps the current at or below the target. If the nearest value is below, the current ends up slightly higher.",
        "A part or temperature with Vf below the datasheet typical value draws more current. The smaller the gap between supply and Vf (e.g. Vf 3 V on 5 V), the bigger the effect.",
        "LEDs in series cut resistor power, but as the supply approaches n × Vf the current becomes sensitive to Vf. If Vs ≤ n × Vf there is no voltage left for the resistor.",
        "Use a resistor rated well above the calculated power — how far below its rating to run it is in the resistor datasheet's derating curve.",
      ],
      uTitle: "Where it is used",
      u: [
        "Status LEDs in 24 V DC control panels and sensor or relay indicators wired directly.",
        "Driving an LED from a microcontroller pin (3.3 V or 5 V) — check the pin current limit in the MCU datasheet.",
        "Several LEDs in parallel on one resistor do not share current evenly because of Vf differences. Give each string its own resistor.",
      ],
      faqTitle: "FAQ",
      faq: [
        ["What is the LED resistor formula?", "R = (supply voltage − LED forward voltage) ÷ LED current. For 5 V, Vf 2 V and 20 mA: 3 V ÷ 0.02 A = 150 Ω, and the resistor dissipates 60 mW."],
        ["What resistor for an LED on 24 V?", "With Vf 2 V and 10 mA: (24 − 2) ÷ 0.01 = 2.2 kΩ, dissipating 0.22 W. A 1/4 W resistor leaves almost no margin, so choose a higher rating or lower the current."],
        ["What about several LEDs in series?", "Subtract Vf once per LED. Three LEDs with Vf 3 V on 12 V at 20 mA: (12 − 9) ÷ 0.02 = 150 Ω."],
        ["What if the result is not a standard value?", "Use the next standard value up and the current comes out slightly below target. That is the «Next value up / current» row above."],
      ],
      pNote: "To make a value from two resistors, use the",
      pLink: "Parallel & Series Resistor Calculator",
      vNote: "For voltage drop over long wiring, use the",
      vLink: "Voltage Drop & Wire Size Calculator",
      srcTitle: "Basis",
      src: "Resistance, current and power follow Ohm's law (definitions). E12 and E24 values come from Vishay document 28372 (the IEC 60063 tables). Check the LED's Vf and If and the resistor's power rating in their datasheets.",
    };
const ld = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: L.faq.map(([q, a]) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a } })),
};
---

<Base lang={lang} title={L.title} seoTitle={ko ? "LED 저항 계산기 — 5 V·12 V·24 V LED 저항 값 — PortDock" : "LED Resistor Calculator: 5 V, 12 V, 24 V, Series LEDs — PortDock"} description={L.desc} path={PATH} ads>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <header class="page-head">
    <div class="wrap">
      <Crumbs lang={lang} items={[{ name: ko ? "웹 도구" : "Web tools", path: "tools/" }, { name: L.title, path: PATH }]} />
      <h1>{L.title}</h1>
      <p>{L.desc}</p>
    </div>
  </header>
  <div class="wrap" style="padding-top:24px">
    <form class="calc card" id="led">
      <div class="row">
        <label class="fld">{L.vs}<input id="vs" class="mono" value="24" inputmode="decimal" spellcheck="false" autocomplete="off" /></label>
        <label class="fld">{L.vf}<input id="vf" class="mono" value="2.0" inputmode="decimal" spellcheck="false" autocomplete="off" /></label>
        <label class="fld">{L.i}<input id="i" class="mono" value="10" inputmode="decimal" spellcheck="false" autocomplete="off" /></label>
        <label class="fld">{L.n}<input id="n" class="mono" value="1" inputmode="numeric" spellcheck="false" autocomplete="off" /></label>
        <label class="fld">{L.ser}<select id="ser"><option value="E12" selected>E12</option><option value="E24">E24</option></select></label>
      </div>
      <p class="err" id="err" role="alert"></p>
      <div class="tbl" aria-live="polite">
        <table class="t kv">
          <caption class="note" style="text-align:left">{L.res}</caption>
          <tbody>{Object.entries(L.k).map(([id, name]) => <tr><td>{name}</td><td class="mono" data-k={id}></td></tr>)}</tbody>
        </table>
      </div>
      <p class="note">{L.example}</p>
      <p class="note">{L.how}</p>
    </form>

    <AdSlot />

    <section class="prose">
      <h2>{L.fTitle}</h2>
      <ul>{L.formula.map((f) => <li class="mono">{f}</li>)}</ul>
      <h2>{L.tTitle}</h2>
      <div class="tbl">
        <table class="t">
          <thead><tr>{L.tHead.map((h) => <th>{h}</th>)}</tr></thead>
          <tbody>{tRows.map((r) => <tr>{r.map((c) => <td class="mono">{c}</td>)}</tr>)}</tbody>
        </table>
      </div>
      <p>{L.tNote}</p>
      <h2>{L.lTitle}</h2>
      <ul>{L.l.map((x) => <li>{x}</li>)}</ul>
      <h2>{L.uTitle}</h2>
      <ul>{L.u.map((x) => <li>{x}</li>)}</ul>
      <h2>{L.faqTitle}</h2>
      {
        L.faq.map(([q, a]) => (
          <>
            <h3>{q}</h3>
            <p>{a}</p>
          </>
        ))
      }
      <p>
        {L.pNote} <a href={url(lang, "tools/parallel-resistor/")}>{L.pLink}</a>. {L.vNote} <a href={url(lang, "tools/voltage-drop/")}>{L.vLink}</a>.
      </p>
      <h2>{L.srcTitle}</h2>
      <p>{L.src}</p>
    </section>
    <UseNotice lang={lang} />
    <WebToolLinks lang={lang} path={PATH} />
  </div>
  <script>
    import { ledResistor, ledStandard, withResistor } from "../lib/led";
    import type { ESeries } from "../lib/divider";
    const ko = document.documentElement.lang === "ko";
    const form = document.getElementById("led") as HTMLFormElement;
    const $ = <E extends HTMLElement = HTMLInputElement>(id: string) => document.getElementById(id) as E;
    const num = (id: string) => {
      const s = $(id).value.trim().replace(",", ".");
      // 빈칸·글자·아주 큰 수(1e12 넘음)는 «값 없음» 으로 — 결과에 Infinity·NaN 이 보이지 않게
      const n = s === "" ? NaN : Number(s);
      return Math.abs(n) > 1e12 ? NaN : n;
    };
    const set = (k: string, v: string) => {
      const td = form.querySelector<HTMLElement>(`td[data-k="${k}"]`);
      if (td) td.textContent = v;
    };
    const p4 = (x: number) => String(+x.toPrecision(4));
    const ohm = (r: number) => (r >= 1e6 ? `${p4(r / 1e6)} MΩ` : r >= 1e3 ? `${p4(r / 1e3)} kΩ` : `${p4(r)} Ω`);
    const amp = (i: number) => (i >= 1 ? `${p4(i)} A` : `${p4(i * 1e3)} mA`);
    const watt = (p: number) => (p >= 1 ? `${p4(p)} W` : `${p4(p * 1e3)} mW`);
    function run() {
      try {
        const vs = num("vs");
        const vf = num("vf");
        const n = num("n");
        const o = ledResistor(vs, vf, num("i") / 1000, n);
        const s = ledStandard(o.r, $<HTMLSelectElement>("ser").value as ESeries);
        const wn = withResistor(vs, vf, s.nearest, n);
        const wu = withResistor(vs, vf, s.above, n);
        set("vr", `${p4(o.vr)} V`);
        set("r", `${ohm(o.r)} (${watt(o.pr)})`);
        set("near", `${ohm(s.nearest)} / ${amp(wn.i)}`);
        set("up", `${ohm(s.above)} / ${amp(wu.i)}`);
        set("pr", watt(wu.pr));
        set("pl", watt(wu.pLed));
        $("err").textContent = "";
      } catch {
        $("err").textContent = ko ? "숫자를 확인하세요 — 전원·Vf·전류는 0 보다 크고, 개수는 1~100 정수, 전원은 개수 × Vf 보다 커야 합니다" : "Check the numbers — supply, Vf and current above 0, count a whole number 1–100, supply above count × Vf";
        for (const td of form.querySelectorAll<HTMLElement>("td[data-k]")) td.textContent = "";
      }
    }
    form.addEventListener("input", run);
    form.addEventListener("change", run);
    form.addEventListener("submit", (e) => e.preventDefault());
    run();
  </script>
</Base>
