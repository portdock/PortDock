---
// 웹 도구: I2C 도구 — (a) 풀업 저항 범위(UM10204 §7.1), (b) 흔한 칩 7비트 주소표·7↔8비트 변환, (c) «S A0 A 00 A Sr A1 A 12 N P» 바이트 풀이.
// 계산·풀이는 lib/i2c.ts.
import Base from "../layouts/Base.astro";
import AdSlot from "../components/AdSlot.astro";
import Crumbs from "../components/Crumbs.astro";
import WebToolLinks from "../components/WebToolLinks.astro";
import UseNotice from "../components/UseNotice.astro";
import { CHIPS, SPEC } from "../lib/i2c";
import { page2 } from "../i18n";
import { pageName } from "../i18n/names";
import type { SiteLang } from "../i18n/langs";
import { ui, link } from "../lib/i18n";
import { msg, tx } from "../lib/tr";

interface Props {
  lang: SiteLang;
}
const { lang } = Astro.props;
const PATH = "tools/i2c/";
const h2 = (n: number) => "0x" + n.toString(16).toUpperCase().padStart(2, "0");
const addrText = (a: number[]) => {
  const runs: string[] = [];
  let i = 0;
  while (i < a.length) {
    let j = i;
    while (j + 1 < a.length && a[j + 1] === a[j] + 1) j++;
    runs.push(j > i + 1 ? `${h2(a[i])}~${h2(a[j])}` : j === i + 1 ? `${h2(a[i])}, ${h2(a[j])}` : h2(a[i]));
    i = j + 1;
  }
  return runs.join(", ");
};
const EXAMPLES = [
  { name: msg(lang, "EEPROM 랜덤 읽기", "EEPROM random read"), v: "S 0xA0 A 0x00 A Sr 0xA1 A 0x12 N P" },
  { name: msg(lang, "RTC 시각 읽기", "RTC time read"), v: "S D0 A 00 A Sr D1 A 45 A 30 A 12 N P" },
  { name: msg(lang, "주소 NACK", "Address NACK"), v: "S 0x78 N P" },
  { name: msg(lang, "HEX 나열", "Plain hex"), v: "78 00 AF" },
];
const L =
  lang === "ko"
  ? {
      title: "I2C 도구 (풀업 저항·주소표·바이트 풀이)",
      seo: "I2C 풀업 저항 계산·주소표·바이트 풀이 — PortDock",
      desc: "I2C 풀업 저항 최소·최대(VDD·버스 용량·100k/400k/1M), 흔한 칩 7비트 주소표와 8비트 쓰기·읽기 주소 변환, S·주소·ACK·NACK·P 바이트 풀이를 한 곳에서.",
      pTitle: "풀업 저항 계산",
      vdd: "VDD (V)",
      cb: "버스 용량 Cb (pF)",
      cbHelp: "장치 핀 용량 + 배선(대략 수십 pF/m)을 더한 값",
      mode: "속도 모드",
      modes: ["Standard-mode 100 kHz", "Fast-mode 400 kHz", "Fast-mode Plus 1 MHz"],
      res: "결과",
      k: { min: "Rp 최소 = (VDD − VOL) ÷ IOL", max: "Rp 최대 = tr ÷ (0.8473 × Cb)", vol: "VOL · IOL (표 10)", tr: "tr 최대 · Cb 최대", pick: "범위 안 E12·E24 값" },
      aTitle: "주소 변환·찾기",
      addr: "주소 (7비트 0x50, 또는 8비트 0xA0·0xA1)",
      addrBits: "넣은 값",
      addrOpt: ["7비트", "8비트 (R/W 비트 포함)"],
      dTitle: "바이트 풀이",
      dIn: "바이트 열",
      dHelp: "S·Sr·P, A(ACK)·N(NACK), 바이트(0xA0 또는 A0). S 가 없으면 첫 바이트를 주소로 봅니다.",
      examples: "예시",
      how: "계산과 풀이는 이 브라우저 안에서만 하고, 입력한 값은 어디에도 보내지 않습니다.",
      fTitle: "풀업 저항 식 (UM10204 §7.1)",
      formula: [
        "Rp(min) = (VDD − VOL(max)) ÷ IOL — 장치가 LOW 로 끌어내릴 때 흘릴 수 있는 전류(IOL)를 넘지 않게",
        "Rp(max) = tr ÷ (0.8473 × Cb) — 0.3·VDD 에서 0.7·VDD 까지 오르는 시간이 tr 을 넘지 않게(ln(0.7/0.3) = 0.8473)",
        "VDD > 2 V: VOL = 0.4 V, IOL = 3 mA(Sm·Fm)·20 mA(Fm+). VDD ≤ 2 V: VOL = 0.2·VDD, IOL = 2 mA",
        "tr = 1000 ns(Sm)·300 ns(Fm)·120 ns(Fm+), Cb 최대 = 400 pF(Sm·Fm)·550 pF(Fm+)",
      ],
      tips: [
        "최소보다 최대가 작으면 그 용량·속도로는 맞는 저항이 없습니다 — 속도를 낮추거나, 선을 짧게 해 용량을 줄이거나, 버퍼·전류원 풀업을 씁니다.",
        "모듈 보드마다 풀업이 달려 있으면 병렬로 합쳐집니다(4.7 kΩ 세 개 → 약 1.6 kΩ). 실제 값은 병렬 합으로 봅니다.",
        "Cb 는 재기 어렵습니다. 오실로스코프로 상승 시간을 보고 Rp × Cb 를 거꾸로 셈하는 방법도 있습니다(상승 시간 ≈ 0.8473 × Rp × Cb).",
      ],
      cTitle: "흔한 칩 7비트 주소 (데이터시트 값)",
      cNote: "주소 핀·부품 번호 변형에 따라 다릅니다. 모듈 보드는 핀을 다른 쪽에 묶어 둘 수 있으니 보드 회로도·I2C 스캔으로 확인할 것.",
      cHead: ["칩", "종류", "7비트 주소", "고르는 법"],
      rTitle: "예약 주소 (UM10204 표 4)",
      rHead: ["7비트", "쓰임"],
      rRows: [
        ["0x00", "일반 호출(R/W 0)·START 바이트(R/W 1)"],
        ["0x01", "CBUS 주소"],
        ["0x02", "다른 버스 형식용"],
        ["0x03", "앞으로 쓸 것"],
        ["0x04~0x07", "Hs-mode 마스터 코드"],
        ["0x78~0x7B", "10비트 주소의 첫 바이트(1111 0XX)"],
        ["0x7C~0x7F", "장치 ID"],
      ],
      faqTitle: "자주 묻는 것",
      faq: [
        ["데이터시트에는 0xA0 인데 라이브러리는 0x50 이라고 합니다", "같은 장치입니다. 0xA0 은 7비트 주소 0x50 을 왼쪽으로 한 칸 민 8비트 쓰기 바이트(R/W = 0), 0xA1 은 읽기 바이트입니다. Arduino Wire·Linux i2c-dev 는 7비트를, 일부 MCU HAL·데이터시트는 8비트를 씁니다."],
        ["4.7 kΩ 이면 되나요?", "Standard-mode·짧은 배선에서는 흔히 쓰는 값이지만, 버스 용량이 크거나 Fast-mode 이상이면 상승 시간이 모자랄 수 있습니다. 위 계산기에 VDD·Cb·모드를 넣어 범위 안인지 볼 것."],
        ["주소 NACK 이 나옵니다", "원인 후보: 주소(7/8비트 혼동), 전원·GND, 풀업 없음, SDA·SCL 바뀜, 다른 장치와 주소 겹침(예: DS3231·MPU-6050 이 모두 0x68), 레벨 변환."],
        ["10비트 주소는?", "첫 바이트 1111 0XX + R/W, 둘째 바이트에 아래 8비트를 보냅니다. 바이트 풀이가 10비트 주소도 풉니다."],
      ],
      srcTitle: "출처",
      more: "UART·SPI·CAN 은",
    }
  : lang === "en"
  ? {
      title: "I2C Tools (Pull-up Resistor, Addresses, Decoder)",
      seo: "I2C Pull-up Resistor Calculator & Address Table — PortDock",
      desc: "I2C pull-up resistor min/max from VDD, bus capacitance and 100k/400k/1M mode, 7-bit addresses of common chips, 8-bit address conversion and a byte decoder.",
      pTitle: "Pull-up resistor",
      vdd: "VDD (V)",
      cb: "Bus capacitance Cb (pF)",
      cbHelp: "Device pin capacitance plus wiring (roughly tens of pF per metre)",
      mode: "Speed mode",
      modes: ["Standard-mode 100 kHz", "Fast-mode 400 kHz", "Fast-mode Plus 1 MHz"],
      res: "Results",
      k: { min: "Rp min = (VDD − VOL) ÷ IOL", max: "Rp max = tr ÷ (0.8473 × Cb)", vol: "VOL · IOL (table 10)", tr: "tr max · Cb max", pick: "E12/E24 values in range" },
      aTitle: "Address conversion and lookup",
      addr: "Address (7-bit 0x50, or 8-bit 0xA0/0xA1)",
      addrBits: "Value is",
      addrOpt: ["7-bit", "8-bit (with R/W bit)"],
      dTitle: "Byte decoder",
      dIn: "Byte sequence",
      dHelp: "S, Sr, P, A (ACK), N (NACK) and bytes (0xA0 or A0). Without S, the first byte is taken as the address.",
      examples: "Examples",
      how: "Everything runs in your browser; nothing you type is sent anywhere.",
      fTitle: "Pull-up formulas (UM10204 §7.1)",
      formula: [
        "Rp(min) = (VDD − VOL(max)) ÷ IOL — so a device pulling LOW never has to sink more than IOL",
        "Rp(max) = tr ÷ (0.8473 × Cb) — so the rise from 0.3·VDD to 0.7·VDD stays within tr (ln(0.7/0.3) = 0.8473)",
        "VDD > 2 V: VOL = 0.4 V, IOL = 3 mA (Sm, Fm), 20 mA (Fm+). VDD ≤ 2 V: VOL = 0.2·VDD, IOL = 2 mA",
        "tr = 1000 ns (Sm), 300 ns (Fm), 120 ns (Fm+); Cb max = 400 pF (Sm, Fm), 550 pF (Fm+)",
      ],
      tips: [
        "If the maximum is below the minimum, no resistor works for that capacitance and speed — slow down, shorten the wiring, or use a bus buffer or current-source pull-up.",
        "Pull-ups on several modules add in parallel (three 4.7 kΩ → about 1.6 kΩ). Use the parallel value.",
        "Cb is hard to measure. You can also measure the rise time on a scope and work back from rise ≈ 0.8473 × Rp × Cb.",
      ],
      cTitle: "Common chips — 7-bit addresses (datasheet values)",
      cNote: "Depends on address pins and part variants. Breakout boards may strap pins differently; check the board schematic or an I2C scan.",
      cHead: ["Chip", "Type", "7-bit address", "Selected by"],
      rTitle: "Reserved addresses (UM10204 table 4)",
      rHead: ["7-bit", "Use"],
      rRows: [
        ["0x00", "General call (R/W 0), START byte (R/W 1)"],
        ["0x01", "CBUS address"],
        ["0x02", "Reserved for a different bus format"],
        ["0x03", "Reserved for future purposes"],
        ["0x04–0x07", "Hs-mode master code"],
        ["0x78–0x7B", "First byte of a 10-bit address (1111 0XX)"],
        ["0x7C–0x7F", "Device ID"],
      ],
      faqTitle: "FAQ",
      faq: [
        ["The datasheet says 0xA0 but the library says 0x50", "Same device. 0xA0 is the 7-bit address 0x50 shifted left — the 8-bit write byte (R/W = 0); 0xA1 is the read byte. Arduino Wire and Linux i2c-dev use 7-bit; some MCU HALs and datasheets use 8-bit."],
        ["Is 4.7 kΩ fine?", "It is a common choice for Standard-mode and short wiring, but with a large bus capacitance or Fast-mode and up the rise time may be too slow. Enter VDD, Cb and mode above to check."],
        ["I get an address NACK", "Likely causes: address (7- vs 8-bit mix-up), power or ground, missing pull-ups, SDA/SCL swapped, an address clash (DS3231 and MPU-6050 are both 0x68), level shifting."],
        ["What about 10-bit addresses?", "The first byte is 1111 0XX plus R/W, the second byte carries the low 8 bits. The byte decoder handles them."],
      ],
      srcTitle: "Sources",
      more: "For UART, SPI and CAN:",
    }
  : page2(lang, "i2c");
const MORE = [
  { path: "tools/uart-waveform/", nameKo: "UART 파형 그리기", nameEn: "UART Waveform Drawer" },
  { path: "tools/spi/", nameKo: "SPI 모드 도우미", nameEn: "SPI Mode Helper" },
  { path: "tools/can-decoder/", nameKo: "CAN 프레임 해석기", nameEn: "CAN Frame Decoder" },
  { path: "tools/uart-baud/", nameKo: "UART 보율 오차 계산기", nameEn: "UART Baud Rate Error Calculator" },
];
const ld = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: L.faq.map(([q, a]) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a } })),
};
const SRC = [
  { name: "NXP UM10204 «I2C-bus specification and user manual» Rev. 7.0 — table 4 (reserved addresses), table 10 (VOL, IOL, tr, Cb), §7.1 pull-up resistor sizing, §3.1.11 10-bit addressing", href: "https://www.nxp.com/docs/en/user-guide/UM10204.pdf" },
  { name: "Texas Instruments SLVA689 «I2C Bus Pullup Resistor Calculation»", href: "https://www.ti.com/lit/an/slva689/slva689.pdf" },
];
---

<Base lang={lang} title={L.title} seoTitle={L.seo} description={L.desc} path={PATH} ads libText={["i2c"]}>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <header class="page-head">
    <div class="wrap">
      <Crumbs lang={lang} items={[{ name: ui(lang).webTools, path: "tools/" }, { name: L.title, path: PATH }]} />
      <h1>{L.title}</h1>
      <p>{L.desc}</p>
    </div>
  </header>
  <div class="wrap" style="padding-top:24px">
    <form class="calc card" id="pu" data-lang={lang}>
      <h2 class="i2-h">{L.pTitle}</h2>
      <div class="row">
        <label class="fld">{L.vdd}<input id="vdd" class="mono" value="3.3" inputmode="decimal" spellcheck="false" autocomplete="off" /></label>
        <label class="fld">{L.cb}<input id="cb" class="mono" value="100" inputmode="decimal" spellcheck="false" autocomplete="off" /><span class="note">{L.cbHelp}</span></label>
        <label class="fld">{L.mode}<select id="mode"><option value="sm">{L.modes[0]}</option><option value="fm" selected>{L.modes[1]}</option><option value="fmp">{L.modes[2]}</option></select></label>
      </div>
      <p class="err" id="pu-err" role="alert"></p>
      <div class="tbl" aria-live="polite">
        <table class="t kv">
          <caption class="note" style="text-align:left">{L.res}</caption>
          <tbody>{(["min", "max", "vol", "tr", "pick"] as const).map((id) => <tr><td>{L.k[id]}</td><td class="mono" data-k={id}></td></tr>)}</tbody>
        </table>
      </div>
      <p class="verdict" id="pu-vd"></p>
    </form>

    <form class="calc card" id="ad" style="margin-top:16px">
      <h2 class="i2-h">{L.aTitle}</h2>
      <div class="row">
        <label class="fld">{L.addr}<input id="addr" class="mono" value="0x68" spellcheck="false" autocomplete="off" /></label>
        <label class="fld">{L.addrBits}<select id="abits"><option value="7" selected>{L.addrOpt[0]}</option><option value="8">{L.addrOpt[1]}</option></select></label>
      </div>
      <p class="result" id="ad-out" aria-live="polite"></p>
    </form>

    <form class="calc card" id="dc" style="margin-top:16px">
      <h2 class="i2-h">{L.dTitle}</h2>
      <label class="fld">{L.dIn}<textarea id="din" class="mono" rows="2" spellcheck="false" autocomplete="off">{EXAMPLES[0].v}</textarea></label>
      <p class="note">{L.dHelp}</p>
      <div class="ex-row" role="group" aria-label={L.examples}>
        <span class="note">{L.examples}</span>
        {EXAMPLES.map((e) => <button type="button" class="btn tight" data-ex={e.v}>{e.name}</button>)}
      </div>
      <p class="err" id="dc-err" role="alert"></p>
      <div class="tbl" aria-live="polite">
        <table class="t">
          <thead><tr>{["#", msg(lang, "칸", "Field"), msg(lang, "바이트", "Byte"), msg(lang, "풀이", "Meaning"), "ACK"].map((h) => <th>{h}</th>)}</tr></thead>
          <tbody id="dc-tb"></tbody>
        </table>
      </div>
      <p class="note">{L.how}</p>
    </form>

    <AdSlot />

    <section class="prose">
      <h2>{L.fTitle}</h2>
      <ul>{L.formula.map((f) => <li class="mono">{f}</li>)}</ul>
      <ul>{L.tips.map((f) => <li>{f}</li>)}</ul>
      <div class="tbl">
        <table class="t">
          <thead><tr><th>{msg(lang, "모드", "Mode")}</th><th>{msg(lang, "최대 속도", "Max rate")}</th><th>tr</th><th>IOL (VOL 0.4 V)</th><th>Cb max</th></tr></thead>
          <tbody>{Object.values(SPEC).map((s) => <tr><td>{s.name}</td><td class="mono">{s.khz} kHz</td><td class="mono">{s.trNs} ns</td><td class="mono">{s.iolMa} mA</td><td class="mono">{s.cbMaxPf} pF</td></tr>)}</tbody>
        </table>
      </div>
      <h2>{L.cTitle}</h2>
      <p>{L.cNote}</p>
      <div class="tbl">
        <table class="t">
          <thead><tr>{L.cHead.map((h) => <th>{h}</th>)}</tr></thead>
          <tbody>{CHIPS.map((c) => <tr><td>{c.chip}</td><td>{tx(c.kind, lang)}</td><td class="mono">{addrText(c.addrs)}</td><td>{tx(c.pins, lang)}</td></tr>)}</tbody>
        </table>
      </div>
      <h2>{L.rTitle}</h2>
      <div class="tbl">
        <table class="t">
          <thead><tr>{L.rHead.map((h) => <th>{h}</th>)}</tr></thead>
          <tbody>{L.rRows.map(([a, b]) => <tr><td class="mono">{a}</td><td>{b}</td></tr>)}</tbody>
        </table>
      </div>
      <h2>{L.faqTitle}</h2>
      {
        L.faq.map(([q, a]) => (
          <>
            <h3>{q}</h3>
            <p>{a}</p>
          </>
        ))
      }
      <p>
        {L.more} {MORE.map((m, i) => <>{i > 0 && " · "}<a href={link(lang, m.path)}>{lang === "ko" ? m.nameKo : lang === "en" ? m.nameEn : pageName(lang, m.path)}</a></>)}
      </p>
      <h2>{L.srcTitle}</h2>
      <ul>{SRC.map((s) => <li><a href={s.href} rel="noopener" target="_blank">{s.name}</a></li>)}</ul>
    </section>
    <UseNotice lang={lang} />
    <WebToolLinks lang={lang} path={PATH} />
  </div>
  <style>
    .i2-h {
      font-size: 18px;
      margin: 0;
    }
    .ex-row {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      align-items: center;
    }
    #ad-out {
      white-space: pre-wrap;
    }
    #dc-tb :global(.bad) {
      color: #b42318;
      font-weight: 600;
    }
  </style>
  <script>
    import { addr8, analyze, chipsAt, pullup, reserved, tokenize, type Mode } from "../lib/i2c";
    import { msg, type Lang } from "../lib/tr";
    const lang = (document.getElementById("pu")?.dataset.lang ?? "en") as Lang;
    const $ = <E extends HTMLElement = HTMLInputElement>(id: string) => document.getElementById(id) as E;
    const H = (n: number) => "0x" + n.toString(16).toUpperCase().padStart(2, "0");
    const num = (id: string) => {
      const s = $(id).value.trim().replace(",", ".");
      const n = s === "" ? NaN : Number(s);
      return Math.abs(n) > 1e9 ? NaN : n;
    };
    const ohm = (r: number) => (r >= 1000 ? `${(r / 1000).toFixed(2)} kΩ` : `${r.toFixed(0)} Ω`);
    const E24 = [1.0, 1.1, 1.2, 1.3, 1.5, 1.6, 1.8, 2.0, 2.2, 2.4, 2.7, 3.0, 3.3, 3.6, 3.9, 4.3, 4.7, 5.1, 5.6, 6.2, 6.8, 7.5, 8.2, 9.1];
    const E12 = new Set([1.0, 1.2, 1.5, 1.8, 2.2, 2.7, 3.3, 3.9, 4.7, 5.6, 6.8, 8.2]);
    const RES_NAMES: Record<string, [string, string]> = {
      general: ["일반 호출 / START 바이트", "General call / START byte"],
      cbus: ["CBUS 주소(예약)", "CBUS address (reserved)"],
      other: ["다른 버스 형식(예약)", "Different bus format (reserved)"],
      future: ["앞으로 쓸 것(예약)", "Future purposes (reserved)"],
      hs: ["Hs-mode 마스터 코드(예약)", "Hs-mode master code (reserved)"],
      ten: ["10비트 주소 첫 바이트", "10-bit address, first byte"],
      devid: ["장치 ID(예약)", "Device ID (reserved)"],
    };

    // ---- 풀업
    const pu = $<HTMLFormElement>("pu");
    const set = (k: string, v: string) => {
      const td = pu.querySelector<HTMLElement>(`td[data-k="${k}"]`);
      if (td) td.textContent = v;
    };
    function runPu() {
      const vd = $("pu-vd");
      vd.className = "verdict";
      vd.textContent = "";
      try {
        const vdd = num("vdd");
        const cb = num("cb");
        const mode = $<HTMLSelectElement>("mode").value as Mode;
        const r = pullup(vdd, cb, mode);
        set("min", ohm(r.rpMin));
        set("max", ohm(r.rpMax));
        set("vol", `${r.vol.toFixed(2)} V · ${r.iolMa} mA${r.lowVdd ? (msg(lang, " (VDD ≤ 2 V 줄)", " (VDD ≤ 2 V row)")) : ""}`);
        const s = { sm: [1000, 400], fm: [300, 400], fmp: [120, 550] }[mode];
        set("tr", `${s[0]} ns · ${s[1]} pF`);
        const picks: string[] = [];
        for (let dec = 10; dec <= 1e6; dec *= 10)
          for (const m of E24) {
            const v = Math.round(m * dec);
            if (v >= r.rpMin && v <= r.rpMax) picks.push(ohm(v) + (E12.has(m) ? "" : "*"));
          }
        set("pick", picks.length ? picks.slice(0, 12).join(", ") + (picks.some((p) => p.endsWith("*")) ? (msg(lang, "   (* = E24 만)", "   (* = E24 only)")) : "") : "—");
        const msgs: string[] = [];
        if (r.overCb) msgs.push(msg(lang, `버스 용량이 이 모드의 최대 ${s[1]} pF 를 넘습니다`, `Bus capacitance exceeds the ${s[1]} pF maximum for this mode`));
        if (!r.ok) msgs.push(msg(lang, "최소가 최대보다 큽니다 — 이 용량·속도로는 맞는 풀업이 없습니다(속도를 낮추거나 용량을 줄이거나 버퍼)", "Minimum exceeds maximum — no pull-up fits this capacitance and speed (slow down, reduce capacitance or add a buffer)"));
        vd.className = `verdict ${msgs.length ? "warn" : "ok"}`;
        vd.textContent = msgs.length ? msgs.join(". ") : msg(lang, `${ohm(r.rpMin)} ~ ${ohm(r.rpMax)} 사이의 저항을 고릅니다`, `Pick a resistor between ${ohm(r.rpMin)} and ${ohm(r.rpMax)}`);
        $("pu-err").textContent = "";
      } catch {
        $("pu-err").textContent = msg(lang, "숫자를 확인하세요 — VDD 와 Cb 는 0 보다 커야 합니다", "Check the numbers — VDD and Cb must be above 0");
        for (const td of pu.querySelectorAll<HTMLElement>("td[data-k]")) td.textContent = "";
      }
    }
    pu.addEventListener("input", runPu);
    pu.addEventListener("change", runPu);
    pu.addEventListener("submit", (e) => e.preventDefault());
    runPu();

    // ---- 주소
    const ad = $<HTMLFormElement>("ad");
    function runAd() {
      const out = $("ad-out");
      const s = $("addr").value.trim().replace(/^0x/i, "");
      const bits = $<HTMLSelectElement>("abits").value;
      const v = /^[0-9a-f]{1,2}$/i.test(s) ? parseInt(s, 16) : NaN;
      if (!Number.isFinite(v) || (bits === "7" && v > 0x7f)) {
        out.textContent = msg(lang, "HEX 로 넣으세요(7비트는 0x00~0x7F)", "Enter hex (7-bit is 0x00–0x7F)");
        return;
      }
      const a7 = bits === "7" ? v : v >> 1;
      const w = addr8(a7);
      const lines = [
        `${msg(lang, "7비트", "7-bit")} ${H(a7)} (${a7})   →   ${msg(lang, "쓰기", "write")} ${H(w.write)}   ${msg(lang, "읽기", "read")} ${H(w.read)}`,
        `${msg(lang, "2진", "binary")} ${a7.toString(2).padStart(7, "0")} + R/W`,
      ];
      if (bits === "8") lines.push(msg(lang, `넣은 0x… 의 맨 아래 비트 = ${v & 1 ? "1 (읽기)" : "0 (쓰기)"}`, `Lowest bit of the value = ${v & 1 ? "1 (read)" : "0 (write)"}`));
      const rs = reserved(a7);
      if (rs) lines.push((msg(lang, "예약 주소: ", "Reserved: ")) + msg(lang, ...RES_NAMES[rs]));
      const cs = chipsAt(a7);
      lines.push(
        cs.length
          ? (msg(lang, "이 주소를 쓸 수 있는 칩: ", "Chips that can use this address: ")) + cs.map((c) => c.chip).join(" / ")
          : msg(lang, "이 표의 칩 중에는 없습니다", "No chip in this table"),
      );
      out.textContent = lines.join("\n");
    }
    ad.addEventListener("input", runAd);
    ad.addEventListener("change", runAd);
    ad.addEventListener("submit", (e) => e.preventDefault());
    runAd();

    // ---- 바이트 풀이
    const dc = $<HTMLFormElement>("dc");
    function runDc() {
      const tb = $("dc-tb");
      tb.replaceChildren();
      try {
        const steps = analyze(tokenize($<HTMLTextAreaElement>("din").value));
        $("dc-err").textContent = "";
        steps.forEach((s, i) => {
          let field = "";
          let mean = "";
          if (s.kind === "start") {
            field = "S";
            mean = msg(lang, "시작(START)", "START");
          } else if (s.kind === "restart") {
            field = "Sr";
            mean = msg(lang, "반복 시작(Repeated START) — 방향을 바꿀 때", "Repeated START — to change direction");
          } else if (s.kind === "stop") {
            field = "P";
            mean = msg(lang, "정지(STOP)", "STOP");
          } else if (s.kind === "lone") {
            field = s.ack ? "A" : "N";
            mean = msg(lang, "앞에 바이트가 없는 ACK/NACK", "ACK/NACK without a byte before it");
          } else if (s.kind === "addr") {
            field = msg(lang, "주소", "Address");
            const rs = s.reserved ? ` — ${msg(lang, ...RES_NAMES[s.reserved])}` : "";
            const cs = chipsAt(s.addr!);
            mean = `${msg(lang, "7비트", "7-bit")} ${H(s.addr!)} + ${s.rw === "W" ? (msg(lang, "쓰기(W)", "write (W)")) : msg(lang, "읽기(R)", "read (R)")}${rs}${cs.length ? ` — ${cs.slice(0, 3).map((c) => c.chip).join(" / ")}${cs.length > 3 ? " …" : ""}` : ""}`;
          } else if (s.kind === "addr10") {
            field = msg(lang, "10비트 주소", "10-bit address");
            mean = s.addr !== undefined ? `${msg(lang, "주소", "address")} 0x${s.addr.toString(16).toUpperCase().padStart(3, "0")} + ${s.rw}` : `1111 0XX + ${s.rw}`;
          } else {
            field = msg(lang, `데이터 ${s.n! + 1}`, `Data ${s.n! + 1}`);
            mean = s.from === "slave" ? (msg(lang, "장치 → 마스터(읽음)", "device → master (read)")) : msg(lang, "마스터 → 장치(씀)", "master → device (write)");
            if (s.from === "master" && s.n === 0) mean += msg(lang, " — 보통 레지스터·메모리 주소", " — often a register/memory address");
          }
          let ack = "";
          let bad = false;
          if (s.ack !== undefined) {
            ack = s.ack ? "ACK" : "NACK";
            if (!s.ack && (s.kind === "addr" || s.kind === "addr10")) {
              ack += msg(lang, " — 응답한 장치 없음", " — no device answered");
              bad = true;
            } else if (!s.ack && s.from === "slave") ack += msg(lang, " — 마스터가 마지막 바이트에 보내는 정상 끝", " — master ends the read (expected on the last byte)");
            else if (!s.ack && s.from === "master") {
              ack += msg(lang, " — 장치가 받지 않음", " — device refused the byte");
              bad = true;
            }
          }
          const tr = document.createElement("tr");
          for (const [t, cls] of [
            [String(i + 1), "mono"],
            [field, ""],
            [s.byte !== undefined ? H(s.byte) : "", "mono"],
            [mean, ""],
            [ack, bad ? "bad" : ""],
          ]) {
            const td = document.createElement("td");
            td.textContent = t;
            if (cls) td.className = cls;
            tr.append(td);
          }
          tb.append(tr);
        });
      } catch (e) {
        $("dc-err").textContent = (msg(lang, "읽을 수 없는 칸: ", "Cannot read: ")) + (e instanceof Error ? e.message : "");
      }
    }
    dc.addEventListener("input", runDc);
    dc.addEventListener("submit", (e) => e.preventDefault());
    for (const b of dc.querySelectorAll<HTMLButtonElement>("button[data-ex]"))
      b.addEventListener("click", () => {
        $<HTMLTextAreaElement>("din").value = b.dataset.ex ?? "";
        runDc();
      });
    runDc();
  </script>
</Base>
