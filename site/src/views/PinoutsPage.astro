---
// 웹 도구: 커넥터 핀 배치 사전 — DB9·DB25 RS-232, RJ45(T568A/B·이더넷·Modbus), Modbus DB9, M12(A·D·X), M8, USB-A/B/C, RS-485 단자 표기.
// 데이터·찾기·그림(SVG 글)은 lib/pinouts.ts(node --test — 핀 번호 중복·빠짐 검사). 저장은 lib/fileSave.ts. 모두 브라우저 안 — 서버로 보내지 않는다.
// 지어낸 값 금지: 확실치 않은 항목은 빼거나 «제조사마다 다름». 원형 커넥터(M12·M8)는 정면 위치를 그리지 않고 번호 목록 그림만.
import Base from "../layouts/Base.astro";
import AdSlot from "../components/AdSlot.astro";
import Crumbs from "../components/Crumbs.astro";
import WebToolLinks from "../components/WebToolLinks.astro";
import UseNotice from "../components/UseNotice.astro";
import { CONNECTORS, CATEGORIES } from "../lib/pinouts";
import { GUIDES } from "../data/guides";
import { WEB_TOOLS } from "../data/webTools";
import { type Lang } from "../data/tools";
import { url } from "../lib/i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const ko = lang === "ko";
const PATH = "tools/pinouts/";
const L = ko
  ? {
      title: "커넥터 핀 배치 사전 — DB9·RJ45·M12·M8·USB·RS-485",
      h1: "커넥터 핀 배치 사전",
      desc: "DB9·RJ45·M12·M8·USB 커넥터의 핀 번호·신호·선 색을 수/암 정면 그림과 표로 봅니다. Modbus RJ45/DB9 규격 핀, RS-485 단자 표기 대조, 출처 포함.",
      intro: "현장에서 자주 쓰는 커넥터의 핀 번호·신호·선 색을 수/암 정면 그림과 표로 봅니다. DB9·DB25 RS-232, RJ45 T568A/B·이더넷, Modbus RJ45/DB9(규격), M12 A·D·X-코드, M8, USB-A/B/C, RS-485 단자 표기. 출처를 함께 적었습니다.",
      seo: "커넥터 핀 배치 사전 — DB9 RS232·RJ45·M12·M8·USB 핀배치 — PortDock",
      search: "찾기",
      searchPh: "예: DB9, T568B, M12, TRX, CC1",
      all: "전체",
      none: "맞는 커넥터가 없습니다.",
      view: "보는 방향",
      saveSvg: "SVG 저장",
      print: "인쇄",
      link: "주소 복사",
      copied: "주소를 복사했습니다 — 이 주소를 열면 같은 커넥터·보는 방향이 나옵니다.",
      clickHint: "그림의 핀이나 표의 줄을 누르면 서로 강조됩니다.",
      notes: "볼 것",
      src: "출처",
      more: "이어 보기",
      privacy: "이 페이지는 브라우저 안에서만 그림을 만들고 아무것도 서버로 보내지 않습니다. 고른 커넥터는 주소의 # 뒤에만 담깁니다.",
      what: "무엇을 보여 주나",
      whatP: [
        "커넥터를 고르면 정면 그림과 핀 표가 나옵니다. D-sub(DB9·DB25)는 수(핀)와 암(소켓)을 각각 정면에서 본 그림, RJ45 는 플러그(접점이 보이게)와 잭(정면) 그림입니다. 납땜 쪽(뒤)에서 보면 좌우가 바뀝니다.",
        "Modbus 의 RJ45·DB9 핀은 «MODBUS over serial line V1.02» §3.5 의 표를 원문에서 옮겼습니다. 센서 선 색은 IEC 60947-5-2 관례로, 실제 센서는 데이터시트가 우선입니다. M12·M8 처럼 둥근 커넥터는 제조사 도면마다 그리는 방향이 달라 핀 위치 대신 번호 목록 그림을 씁니다.",
        "그림은 SVG 로 저장하거나 표와 함께 인쇄할 수 있습니다. 배선 전체를 그리려면 배선도 만들기, 시운전 순서는 점검표 만들기를 함께 쓰세요.",
      ],
      faqTitle: "자주 묻는 것",
      faq: [
        ["PC 의 DB9 와 장비의 DB9 를 그냥 이으면 되나요?", "PC(DTE)와 모뎀 같은 DCE 사이는 1:1 스트레이트, PC 와 PC 처럼 DTE 끼리는 2·3번을 엇갈린 널 모뎀 케이블입니다. 장비가 어느 쪽인지는 매뉴얼의 핀 표에서 2번이 입력인지 출력인지로 확인합니다."],
        ["T568A 와 T568B 중 무엇을 써야 하나요?", "성능은 같습니다. 초록 쌍과 주황 쌍의 자리만 다르므로 한 현장 안에서 하나로 통일하면 됩니다. 양 끝이 다르면 크로스 케이블이 됩니다."],
        ["RS-485 의 A 가 + 인가요, B 가 + 인가요?", "Modbus 규격은 D1(B)이 1(OFF)일 때 높은 쪽, D0(A)가 낮은 쪽입니다. 하지만 A 를 + 로 적는 제조사도 있어 글자만 믿을 수 없습니다. 응답이 없으면 두 선을 바꿔 봅니다."],
        ["M12 핀 위치 그림은 왜 없나요?", "제조사 도면마다 수/암·앞/뒤를 그리는 방향이 달라, 틀린 위치를 그리지 않으려고 번호·신호·색 목록만 보여 줍니다. 핀 위치는 커넥터나 센서 데이터시트의 도면으로 확인합니다."],
      ],
      wiring: "배선도 만들기",
      sys: "시스템 구성도 그리기",
      check: "시운전·유지보수 점검표 만들기",
      seeAlso: "함께 쓰기:",
    }
  : {
      title: "Connector Pinout Reference — DB9, RJ45, M12, M8, USB, RS-485",
      h1: "Connector pinout reference",
      desc: "Pin numbers, signals and wire colours for DB9/DB25, RJ45, Modbus RJ45/DB9, M12, M8 and USB, with male/female front views, tables and sources.",
      intro: "Pin numbers, signals and wire colours of common field connectors, with male/female front views and tables: DB9/DB25 RS-232, RJ45 T568A/B and Ethernet, Modbus RJ45/DB9 (spec), M12 A/D/X-coded, M8, USB-A/B/C and RS-485 terminal names. Sources included.",
      seo: "Connector Pinouts: DB9 RS-232, RJ45, M12, M8, USB — PortDock",
      search: "Search",
      searchPh: "e.g. DB9, T568B, M12, TRX, CC1",
      all: "All",
      none: "No matching connector.",
      view: "View",
      saveSvg: "Save SVG",
      print: "Print",
      link: "Copy link",
      copied: "Link copied — opening it shows the same connector and view.",
      clickHint: "Click a pin in the drawing or a row in the table to highlight both.",
      notes: "Notes",
      src: "Sources",
      more: "See also",
      privacy: "This page draws everything inside your browser and sends nothing to a server. The chosen connector lives only after the # in the address.",
      what: "What it shows",
      whatP: [
        "Pick a connector to see a front view and a pin table. D-subs (DB9, DB25) are drawn from the front for male (pins) and female (socket); RJ45 as the plug (contacts facing you) and the jack (front). From the solder side (rear) left and right swap.",
        "Modbus RJ45 and DB9 pins are copied from the tables in «MODBUS over serial line V1.02» §3.5. Sensor wire colours follow the IEC 60947-5-2 convention — the sensor datasheet comes first. For round connectors such as M12 and M8, makers draw the face in different orientations, so a number list is shown instead of pin positions.",
        "Save the drawing as SVG or print it with the table. To draw the whole wiring, use the wiring diagram maker; for start-up steps, the checklist maker.",
      ],
      faqTitle: "FAQ",
      faq: [
        ["Can I just connect a PC DB9 to a device DB9?", "PC (DTE) to a DCE such as a modem is a 1:1 straight cable; DTE to DTE (PC to PC) is a null-modem cable with 2 and 3 crossed. Whether a device is DTE or DCE shows in its manual: is pin 2 an input or an output?"],
        ["T568A or T568B?", "Same performance. Only the green and orange pairs swap places, so pick one per site. Different schemes at the two ends make a crossover cable."],
        ["On RS-485, is A or B the + line?", "The Modbus spec makes D1 (B) the higher line for binary 1 (OFF) and D0 (A) the lower. Some makers label A as + though, so letters alone cannot be trusted. If nothing answers, swap the two wires."],
        ["Why is there no M12 pin position drawing?", "Makers draw male/female and front/rear in different orientations, so only numbers, signals and colours are listed to avoid drawing wrong positions. Check pin positions in the connector or sensor datasheet drawing."],
      ],
      wiring: "Wiring diagram maker",
      sys: "System diagram editor",
      check: "Commissioning and maintenance checklist",
      seeAlso: "Use with:",
    };
const T = {
  copied: L.copied,
  notes: L.notes,
  src: L.src,
  more: L.more,
  footer: "portdock.dev/tools/pinouts",
};
const ld = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: L.faq.map(([q, a]) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a } })),
};
// 링크 이름(가이드·웹 도구) — 화면 스크립트에 넘긴다
const linkPaths = [...new Set(CONNECTORS.flatMap((c) => c.links ?? []))];
const LINKS: Record<string, { href: string; name: string }> = Object.fromEntries(
  linkPaths.map((p) => {
    const g = GUIDES.find((x) => `guides/${x.slug}/` === p);
    const w = WEB_TOOLS.find((x) => x.path === p);
    return [p, { href: url(lang, p), name: g ? g.title[lang] : w ? w.name[lang] : p }];
  }),
);
---

<Base lang={lang} title={L.title} seoTitle={L.seo} description={L.desc} path={PATH} ads>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <header class="page-head">
    <div class="wrap">
      <Crumbs lang={lang} items={[{ name: ko ? "웹 도구" : "Web tools", path: "tools/" }, { name: L.h1, path: PATH }]} />
      <h1>{L.h1}</h1>
      <p>{L.intro}</p>
    </div>
  </header>
  <div class="wrap" style="padding-top:24px">
    <section class="calc card pp-pick" id="pp" data-lang={lang} data-t={JSON.stringify(T)} data-links={JSON.stringify(LINKS)}>
      <label class="fld">{L.search}<input id="q" type="search" placeholder={L.searchPh} autocomplete="off" /></label>
      <div class="pp-cats" role="group" aria-label={L.search}>
        <button type="button" class="pp-chip" data-cat="" aria-pressed="true">{L.all}</button>
        {CATEGORIES.map((c) => <button type="button" class="pp-chip" data-cat={c.id} aria-pressed="false">{c.name[lang]}</button>)}
      </div>
      <ul class="pp-list" id="list">
        {
          CONNECTORS.map((c) => (
            <li data-id={c.id} data-cat={c.cat}>
              <button type="button" class="pp-item" data-id={c.id}>
                <b>{c.name[lang]}</b>
                <small>{c.sum[lang]}</small>
              </button>
            </li>
          ))
        }
      </ul>
      <p class="note" id="none" hidden>{L.none}</p>
      <p class="note privacy">{L.privacy}</p>
    </section>

    <section class="card pp-out" id="pp-print" aria-live="polite">
      <h2 class="pp-h" id="cName"></h2>
      <p id="cSum"></p>
      <div class="pp-views" id="views" role="group" aria-label={L.view}></div>
      <div class="pp-svg" id="svg"></div>
      <div class="btns pp-btns">
        <button type="button" class="btn tight" id="bSvg">{L.saveSvg}</button>
        <button type="button" class="btn tight" id="bPrint">{L.print}</button>
        <button type="button" class="btn tight" id="bLink">{L.link}</button>
      </div>
      <p class="note" id="msg" role="status">{L.clickHint}</p>
      <div class="tbl"><table class="t pp-table" id="tbl"></table></div>
      <div id="extra"></div>
    </section>

    <AdSlot />

    <section class="prose">
      <h2>{L.what}</h2>
      {L.whatP.map((p) => <p>{p}</p>)}
      <p>
        {L.seeAlso} <a href={url(lang, "tools/wiring/")}>{L.wiring}</a> · <a href={url(lang, "tools/system-diagram/")}>{L.sys}</a> ·{" "}
        <a href={url(lang, "tools/commissioning-checklist/")}>{L.check}</a>
      </p>
      <h2>{L.faqTitle}</h2>
      {
        L.faq.map(([q, a]) => (
          <>
            <h3>{q}</h3>
            <p>{a}</p>
          </>
        ))
      }
      <p>
        {ko ? "커넥터에 맞는 케이블(이더넷 등급·RS-485·RS-232 길이)은 " : "For the cable behind the connector (Ethernet category, RS-485, RS-232 length), see the "}<a href={url(lang, "tools/cable-selection/")}>{ko ? "케이블 선정 도우미" : "cable selection helper"}</a>{ko ? " 를 보세요." : "."}
      </p>
    </section>
    <UseNotice lang={lang} />
    <WebToolLinks lang={lang} path={PATH} />
  </div>
  <style>
    .pp-pick {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .pp-cats {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }
    .pp-chip {
      border: 1px solid var(--line);
      border-radius: 999px;
      padding: 5px 12px;
      font-size: 14px;
      background: var(--panel);
      color: inherit;
      cursor: pointer;
    }
    .pp-chip[aria-pressed="true"] {
      border-color: var(--accent);
      background: var(--soft);
      font-weight: 600;
    }
    .pp-list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
      gap: 8px;
    }
    .pp-item {
      width: 100%;
      height: 100%;
      text-align: left;
      border: 1px solid var(--line);
      border-radius: 8px;
      padding: 8px 10px;
      background: var(--panel);
      color: inherit;
      cursor: pointer;
      display: flex;
      flex-direction: column;
      gap: 3px;
      font: inherit;
    }
    .pp-item small {
      color: var(--muted);
      font-size: 12.5px;
      line-height: 1.4;
    }
    .pp-item[aria-current="true"] {
      border-color: var(--accent);
      background: var(--soft);
    }
    .pp-out {
      margin-top: 16px;
    }
    .pp-h {
      margin: 0 0 4px;
      font-size: 20px;
    }
    .pp-views {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin: 8px 0;
    }
    .pp-svg {
      overflow-x: auto;
      border: 1px solid var(--line);
      border-radius: 8px;
      background: var(--panel);
      max-width: 640px;
    }
    .pp-svg :global(svg) {
      display: block;
      width: 100%;
      height: auto;
    }
    .pp-btns {
      margin-top: 10px;
    }
    .pp-table :global(tr) {
      cursor: pointer;
    }
    .pp-table :global(tr.hl td) {
      background: var(--soft);
      font-weight: 600;
    }
    .pp-table :global(.sw) {
      display: inline-block;
      width: 22px;
      height: 12px;
      border: 1px solid var(--line);
      border-radius: 2px;
      vertical-align: middle;
      margin-right: 6px;
    }
    #extra :global(h3) {
      font-size: 16px;
      margin: 14px 0 4px;
    }
    #extra :global(ul) {
      margin: 0;
      padding-left: 20px;
    }
    #extra :global(li) {
      margin: 3px 0;
    }
    @media print {
      :global(body *) {
        visibility: hidden;
      }
      #pp-print,
      #pp-print :global(*) {
        visibility: visible;
      }
      #pp-print {
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
        border: 0;
      }
      .pp-btns,
      .pp-views,
      #msg {
        display: none;
      }
    }
  </style>
  <script>
    import { CONNECTORS, VIEWS, VIEW_NAME, WIRE, connectorById, filterConnectors, headCells, rowCells, pinoutSvg, type Category, type Connector, type ViewId } from "../lib/pinouts";
    import { LIGHT, esc } from "../lib/diagramSvg";
    import { saveText, screenPalette, onThemeChange } from "../lib/fileSave";

    const root = document.getElementById("pp") as HTMLElement;
    const lang = (root.dataset.lang === "en" ? "en" : "ko") as "ko" | "en";
    const T = JSON.parse(root.dataset.t ?? "{}") as Record<string, string>;
    const LINKS = JSON.parse(root.dataset.links ?? "{}") as Record<string, { href: string; name: string }>;
    const $ = <E extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as E;

    let cat: Category | "" = "";
    let cur: Connector = CONNECTORS[0];
    let view: ViewId = VIEWS[cur.kind][0];
    let hl: string | undefined;
    let printing = false;

    // 주소 #c=<id>&v=<view>&p=<pin>
    function readHash() {
      const h = new URLSearchParams(location.hash.slice(1));
      const c = connectorById(h.get("c") ?? "");
      if (c) cur = c;
      const v = h.get("v") as ViewId | null;
      view = v && VIEWS[cur.kind].includes(v) ? v : VIEWS[cur.kind][0];
      const p = h.get("p");
      hl = p && cur.pins.some((x) => x.n === p) ? p : undefined;
    }
    function writeHash() {
      const h = new URLSearchParams({ c: cur.id, v: view });
      if (hl) h.set("p", hl);
      history.replaceState(null, "", "#" + h.toString());
    }

    function drawList() {
      const ids = new Set(filterConnectors(($("q") as HTMLInputElement).value, cat).map((c) => c.id));
      let shown = 0;
      for (const li of $("list").querySelectorAll<HTMLElement>("li")) {
        const on = ids.has(li.dataset.id ?? "");
        li.hidden = !on;
        if (on) shown++;
      }
      $("none").hidden = shown > 0;
      for (const b of root.querySelectorAll<HTMLButtonElement>(".pp-chip")) b.setAttribute("aria-pressed", String((b.dataset.cat ?? "") === cat));
      for (const b of root.querySelectorAll<HTMLButtonElement>(".pp-item")) b.setAttribute("aria-current", String(b.dataset.id === cur.id));
    }

    function drawSvg() {
      $("svg").innerHTML = pinoutSvg(cur, view, { lang, pal: printing ? LIGHT : screenPalette(), hl });
    }

    function drawTable() {
      const head = headCells(cur, lang);
      const hasColor = cur.pins.some((p) => p.color);
      const colorIdx = hasColor ? 3 : -1;
      const rows = cur.pins
        .map((p) => {
          const cells = rowCells(cur, p, lang).map((c, i) => {
            if (i === colorIdx && p.color) {
              const w = WIRE[p.color];
              const bg = w.stripe ? `repeating-linear-gradient(90deg, ${w.hex} 0 4px, ${w.stripe} 4px 8px)` : w.hex;
              return `<td><span class="sw" style="background:${bg}"></span>${esc(c)}</td>`;
            }
            return `<td${i === 0 ? ' class="mono"' : ""}>${esc(c)}</td>`;
          });
          return `<tr data-pin="${esc(p.n)}"${p.n === hl ? ' class="hl"' : ""}>${cells.join("")}</tr>`;
        })
        .join("");
      $("tbl").innerHTML = `<thead><tr>${head.map((h) => `<th>${esc(h)}</th>`).join("")}</tr></thead><tbody>${rows}</tbody>`;
    }

    function drawDetail() {
      $("cName").textContent = cur.name[lang];
      $("cSum").textContent = cur.sum[lang];
      $("views").innerHTML = VIEWS[cur.kind]
        .map((v) => `<button type="button" class="pp-chip" data-view="${v}" aria-pressed="${v === view}">${esc(VIEW_NAME[v][lang])}</button>`)
        .join("");
      drawSvg();
      drawTable();
      const notes = [...cur.notes.map((n) => n[lang]), ...(cur.colorNote ? [cur.colorNote[lang]] : [])];
      const links = (cur.links ?? []).map((p) => LINKS[p]).filter(Boolean);
      $("extra").innerHTML =
        `<h3>${esc(T.notes)}</h3><ul>${notes.map((n) => `<li>${esc(n)}</li>`).join("")}</ul>` +
        `<h3>${esc(T.src)}</h3><ul>${cur.src.map((s) => `<li><a href="${esc(s.href)}" rel="noopener" target="_blank">${esc(s.name)}</a></li>`).join("")}</ul>` +
        (links.length ? `<h3>${esc(T.more)}</h3><ul>${links.map((l) => `<li><a href="${esc(l.href)}">${esc(l.name)}</a></li>`).join("")}</ul>` : "");
      writeHash();
    }

    function setHl(p: string | undefined) {
      hl = hl === p ? undefined : p;
      drawSvg();
      for (const tr of $("tbl").querySelectorAll<HTMLTableRowElement>("tbody tr")) tr.classList.toggle("hl", tr.dataset.pin === hl);
      writeHash();
    }

    $("q").addEventListener("input", drawList);
    root.addEventListener("click", (e) => {
      const chip = (e.target as HTMLElement).closest<HTMLButtonElement>(".pp-chip");
      if (chip && chip.dataset.cat !== undefined) {
        cat = (chip.dataset.cat ?? "") as Category | "";
        drawList();
        return;
      }
      const item = (e.target as HTMLElement).closest<HTMLButtonElement>(".pp-item");
      if (item) {
        const c = connectorById(item.dataset.id ?? "");
        if (!c) return;
        cur = c;
        view = VIEWS[c.kind][0];
        hl = undefined;
        drawList();
        drawDetail();
        if (window.matchMedia("(max-width: 800px)").matches) $("pp-print").scrollIntoView({ behavior: "smooth", block: "start" });
      }
    });
    $("views").addEventListener("click", (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-view]");
      if (!b) return;
      view = b.dataset.view as ViewId;
      drawDetail();
    });
    $("svg").addEventListener("click", (e) => {
      const g = (e.target as Element).closest("[data-pin]");
      if (g) setHl(g.getAttribute("data-pin") ?? undefined);
    });
    $("tbl").addEventListener("click", (e) => {
      const tr = (e.target as HTMLElement).closest<HTMLTableRowElement>("tbody tr");
      if (tr) setHl(tr.dataset.pin);
    });

    const exportSvg = () => pinoutSvg(cur, view, { lang, pal: LIGHT, hl, bg: true, footer: T.footer });
    $("bSvg").addEventListener("click", () => saveText(exportSvg(), `portdock-pinout-${cur.id}-${view}.svg`, "image/svg+xml"));
    $("bPrint").addEventListener("click", () => window.print());
    window.addEventListener("beforeprint", () => {
      printing = true;
      drawSvg();
    });
    window.addEventListener("afterprint", () => {
      printing = false;
      drawSvg();
    });
    $("bLink").addEventListener("click", () => {
      const u = location.href;
      navigator.clipboard?.writeText(u).then(
        () => ($("msg").textContent = T.copied),
        () => ($("msg").textContent = u),
      );
    });
    window.addEventListener("hashchange", () => {
      readHash();
      drawList();
      drawDetail();
    });
    onThemeChange(drawSvg);
    readHash();
    drawList();
    drawDetail();
  </script>
</Base>
