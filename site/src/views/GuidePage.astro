---
// 가이드 글 — 본문 아래에만 광고(AdSlot). 이어지는 도구·가이드·웹 도구·장비 레지스터 맵으로 안내한다.
import Base from "../layouts/Base.astro";
import AdSlot from "../components/AdSlot.astro";
import UseNotice from "../components/UseNotice.astro";
import Crumbs from "../components/Crumbs.astro";
import { toolById, REPO, type Lang } from "../data/tools";
import { GUIDES, type Guide } from "../data/guides";
import { webToolByPath } from "../data/webTools";
import { groupOf } from "../data/webToolGroups";
import { DEVICES, devPath } from "../data/devices";
import { url } from "../lib/i18n";

interface Props {
  lang: Lang;
  guide: Guide;
}
const { lang, guide } = Astro.props;
const ko = lang === "ko";
const tools = guide.tools.map(toolById);
const related = guide.related.map((s) => GUIDES.find((g) => g.slug === s)!);
const webTools = (guide.webTools ?? []).map(webToolByPath);
// PC 하드웨어 글(마이크·블루투스…)은 웹 테스트를 먼저, 그 밖의 글은 윈도우 프로그램을 먼저 보인다
const webFirst = webTools.length > 0 && groupOf(webTools[0].path) === "hw";
const appCards = tools.map((x) => ({ app: true, href: url(lang, `${x.id}/`), name: x.name, blurb: x.tagline[lang], go: ko ? "프로그램 보기(무료)" : "See the program (free)" }));
const webCards = webTools.map((w) => ({ app: false, href: url(lang, w.path), name: w.name[lang], blurb: w.blurb[lang], go: ko ? "웹 도구 열기(설치 없음)" : "Open the web tool (no install)" }));
// 이 글과 같은 종류의 장비 레지스터 맵(예: 인버터 글 → 인버터 장비)
const kindDevices = DEVICES.filter((d) => guide.deviceKinds?.includes(d.kind));
const here = new URL(url(lang, `guides/${guide.slug}/`), Astro.site).href;
const ld = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  headline: guide.title[lang],
  // 사이트 주소(빌드 변수 SITE_URL)를 따른다
  url: here,
  mainEntityOfPage: here,
  image: new URL(lang === "ko" ? "/og.png" : "/og-en.png", Astro.site).href,
  description: guide.desc[lang],
  datePublished: guide.date,
  dateModified: guide.date,
  inLanguage: lang,
  author: { "@type": "Organization", name: "PortDock", url: REPO },
  publisher: { "@type": "Organization", name: "PortDock", url: new URL("/", Astro.site).href },
  // 앱이 없는 글(PC 하드웨어 웹 도구 글)은 about 을 빼고, 이어지는 웹 도구를 카드로 보인다
  // «근거» 목록(제조사·표준·공식 문서) — 기계가 읽는 인용
  ...(guide.refs?.length ? { citation: guide.refs.map((r) => ({ "@type": "CreativeWork", name: r.title, url: r.url })) } : {}),
  ...(tools.length ? { about: tools.map((t) => ({ "@type": "SoftwareApplication", name: t.name, applicationCategory: "DeveloperApplication", operatingSystem: "Windows" })) } : {}),
};
---

<Base lang={lang} title={guide.title[lang]} seoTitle={guide.seoTitle?.[lang]} description={guide.desc[lang]} path={`guides/${guide.slug}/`} ads ogType="article">
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <header class="page-head">
    <div class="wrap">
      <Crumbs lang={lang} items={[{ name: ko ? "가이드" : "Guides", path: "guides/" }, { name: guide.title[lang], path: `guides/${guide.slug}/` }]} />
      <h1>{guide.title[lang]}</h1>
      <p>{guide.desc[lang]}</p>
      {/* 첫 화면 안에 «이 글에서 쓰는 도구» — 맨 아래 카드까지 내려가지 않아도 다음 행동이 보이게(앱 2개·웹 도구 2개까지) */}
      {
        (tools.length > 0 || webTools.length > 0) && (
          <p class="guide-tools">
            <b>{ko ? "이 글에서 쓰는 도구" : "Tools for this guide"}</b>
            {(webFirst ? [...webCards.slice(0, 2), ...appCards.slice(0, 2)] : [...appCards.slice(0, 2), ...webCards.slice(0, 2)]).map((c) => (
              <a href={c.href}>
                {c.name.replace("PortDock ", "")} <small>{c.app ? (ko ? "윈도우 프로그램 · 무료" : "Windows program · free") : ko ? "웹 · 설치 없음" : "web · no install"}</small>
              </a>
            ))}
          </p>
        )
      }
    </div>
  </header>
  <article class="wrap prose guide" style="padding-top:20px">
    {
      guide.body[lang].map((b) =>
        "p" in b ? <p>{b.p}</p>
        : "h" in b ? <h2>{b.h}</h2>
        : "ul" in b ? <ul>{b.ul.map((x) => <li>{x}</li>)}</ul>
        : "code" in b ? <pre class="result">{b.code}</pre>
        : "fig" in b ? (
          <figure class="fig">
            <img src={b.fig.src} width={b.fig.w} height={b.fig.h} alt={b.fig.alt} loading="lazy" decoding="async" />
            <figcaption>{b.fig.cap}</figcaption>
          </figure>
        )
        : (
          <div class="tbl">
            <table class="t">
              <thead><tr>{b.table.head.map((h) => <th>{h}</th>)}</tr></thead>
              <tbody>{b.table.rows.map((r) => <tr>{r.map((c, i) => <td class={i === 0 && !b.table.plain ? "mono" : ""}>{c}</td>)}</tr>)}</tbody>
            </table>
          </div>
        ),
      )
    }
    {
      guide.refs && (
        <>
          <h2>{ko ? "근거" : "Sources"}</h2>
          <ul>
            {guide.refs.map((r) => (
              <li>
                <a href={r.url} rel="noopener">{r.title}</a>
                {r.note ? ` — ${r.note[lang]}` : ""}
              </li>
            ))}
          </ul>
        </>
      )
    }
    <p class="note">{ko ? `작성 ${guide.date}` : `Published ${guide.date}`}</p>
    <UseNotice lang={lang} />
  </article>
  <div class="wrap">
    <AdSlot />
    <section class="related">
      <h2>{ko ? "이 글과 이어지는 도구" : "Tools for this"}</h2>
      <div class="grid">
        {
          (webFirst ? [...webCards, ...appCards] : [...appCards, ...webCards]).map((c) => (
            <a class="card" href={c.href}>
              <h3>{c.name}</h3>
              <p>{c.blurb}</p>
              <span class="go">{c.go} →</span>
            </a>
          ))
        }
      </div>
      <p class="note">
        <a href={url(lang, "download/")}>{ko ? "모든 도구 내려받기(무료, 윈도우 10·11)" : "Download all tools (free, Windows 10/11)"} →</a>
      </p>
    </section>
    <section class="related">
      <h2>{ko ? "이어 읽기" : "Read next"}</h2>
      <ul class="links">
        {
          related.map((g) => (
            <li>
              <a href={url(lang, `guides/${g.slug}/`)}>{g.title[lang]}</a>
            </li>
          ))
        }
        {
          kindDevices.map((d) => (
            <li>
              <a href={url(lang, devPath(d))}>{ko ? `${d.manufacturer.ko} ${d.model} Modbus 레지스터 맵` : `${d.manufacturer.en} ${d.model} Modbus register map`}</a>
            </li>
          ))
        }
        {
          guide.devices && (
            <li>
              <a href={url(lang, "devices/")}>{ko ? `산업 장비 Modbus 레지스터 맵 ${DEVICES.length}종` : `Modbus register maps for ${DEVICES.length} industrial devices`}</a>
            </li>
          )
        }
      </ul>
    </section>
  </div>
</Base>
