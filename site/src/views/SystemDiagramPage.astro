};
---

<Base lang={lang} title={L.title} seoTitle={L.seo} description={L.desc} path={PATH} ads libText={["sysDiagram", "sysDiff"]}>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <header class="page-head">
    <div class="wrap">
      <Crumbs lang={lang} items={[{ name: ui(lang).webTools, path: "tools/" }, { name: L.h1, path: PATH }]} />
      <h1>{L.h1}</h1>
      <p>{L.desc}</p>
    </div>
  </header>
  <div class="wrap" style="padding-top:24px">
    <div class="card sd-tools" id="sd" data-lang={lang} data-t={JSON.stringify(T)}>
      <div class="row sd-row">
        <label class="fld sd-title">{L.docTitle}<input id="docTitle" maxlength="80" autocomplete="off" /></label>
        <label class="fld">{L.example}<select id="example"><option value="">{L.pick}</option>{EXAMPLES.map((e) => <option value={e.id}>{tx(e.name, lang)}</option>)}</select></label>
        <button type="button" class="btn tight" id="fresh">{L.fresh}</button>
      </div>
      <div class="sd-palette" role="group" aria-label={L.add}>
        <span class="sd-lbl">{L.add}</span>
        {NODE_KINDS.map((k) => <button type="button" class="btn tight" data-add={k}>+ {tx(NODE_NAME[k], lang)}</button>)}
        <button type="button" class="btn tight" data-bus="rs485">+ {L.bus485}</button>
        <button type="button" class="btn tight" data-bus="can">+ {L.busCan}</button>
      </div>
      <div class="sd-palette">
        <label class="fld sd-inline">{L.linkKind}<select id="linkKind">{LINK_KINDS.map((k) => <option value={k}>{tx(LINK_NAME[k], lang)}</option>)}</select></label>
        <button type="button" class="btn tight" id="connect" aria-pressed="false">{L.connect}</button>
        <button type="button" class="btn tight" id="delSel" disabled>{L.del}</button>
      </div>
      <p class="note" id="hint" hidden>{L.connectOn}</p>
    </div>

    <div class="sd-main">
      <section class="card sd-canvas-wrap" id="sd-print">
        <div class="sd-canvas" id="canvas" tabindex="0" aria-label={L.h1}></div>
        <div class="btns sd-btns">
          <button type="button" class="btn tight" id="bJson">{L.saveJson}</button>
          <label class="btn tight sd-file">{L.openJson}<input type="file" id="fJson" accept=".json,application/json" /></label>
          <label class="btn tight sd-file">{L.openScan}<input type="file" id="fScan" accept=".csv,text/csv" /></label>
          <button type="button" class="btn tight" id="bSvg">{L.saveSvg}</button>
          <button type="button" class="btn tight" id="bPng">{L.savePng}</button>
          <button type="button" class="btn tight" id="bPrint">{L.print}</button>
        </div>
        <p class="note" id="msg" role="status"></p>
        <h2 class="sd-h">{L.checks}</h2>
        <ul class="sd-findings" id="findings" aria-live="polite"></ul>
        <h3 class="sd-h3">{L.busSum}</h3>
        <div class="sd-table" id="busSum"></div>
        <p class="note">{L.busNote} <a href={link(lang, "tools/serial-timing/")}>{L.seeLinks[0]}</a>{L.busEnd}</p>
      </section>
      <aside class="card sd-props" aria-label={L.props}>
        <h2 class="sd-h">{L.props}</h2>
        <label class="fld">{L.pickItem}<select id="pickItem"></select></label>
        <div id="props"></div>
      </aside>
    </div>
    <section class="card sd-cmp" id="cmp">
      <h2 class="sd-h">{L.compare}</h2>
      <p class="note">{L.compareIntro}</p>
      <div class="btns">
        <button type="button" class="btn tight" id="bBase">{L.setBase}</button>
        <label class="btn tight sd-file">{L.openBase}<input type="file" id="fBase" accept=".json,application/json" /></label>
        <button type="button" class="btn tight" id="bBaseClear" disabled>{L.clearBase}</button>
        <button type="button" class="btn tight" id="bDiffCopy" disabled>{L.copyDiff}</button>
        <label class="sd-chk"><input type="checkbox" id="showDiff" checked /> {L.showDiff}</label>
      </div>
      <p class="note" id="baseInfo" role="status"></p>
      <div id="diff"></div>
      <p class="note" id="diffLegend" hidden>{L.legend}</p>
      <textarea id="diffFallback" class="mono" rows="6" readonly hidden aria-label={L.copyDiff}></textarea>
    </section>
    <p class="note privacy">{L.privacy}</p>
    <p class="note">{L.keys}</p>

    <AdSlot />

    <section class="prose">
      <h2>{L.what}</h2>
      {L.whatP.map((p) => <p>{p}</p>)}
      <p>{L.wiringNote}<a href={link(lang, "tools/wiring/")}>{L.seeLinks[1]}</a>{L.wiringEnd}</p>
      <p>{L.checkNote}<a href={link(lang, "tools/commissioning-checklist/")}>{L.seeLinks[2]}</a> · <a href={link(lang, "tools/pinouts/")}>{L.seeLinks[3]}</a>{L.checkEnd}</p>
      <h2>{L.faqTitle}</h2>
      {
        L.faq.map(([q, a]) => (
          <>
            <h3>{q}</h3>
            <p>{a}</p>
          </>
        ))
      }
    </section>
    <UseNotice lang={lang} />
    <WebToolLinks lang={lang} path={PATH} />
  </div>
  <style>
    .sd-tools {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .sd-row {
      align-items: flex-end;
    }
    .sd-row > .btn {
      flex: 0 0 auto;
    }
    .sd-title {
      flex: 2 1 240px;
    }
    .sd-palette {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      align-items: center;
    }
    .sd-lbl {
      font-weight: 600;
      font-size: 14px;
      margin-right: 4px;
    }
    .sd-inline {
      flex-direction: row;
      align-items: center;
      gap: 8px;
    }
    .sd-inline select {
      width: auto;
    }
    #connect[aria-pressed="true"] {
      background: var(--accent);
      border-color: var(--accent);
      color: var(--accent-ink);
    }
    .sd-main {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 300px;
      gap: 16px;
      margin-top: 16px;
      align-items: start;
    }
    @media (max-width: 900px) {
      .sd-main {
        grid-template-columns: minmax(0, 1fr);
      }
    }
    .sd-canvas {
      overflow: auto;
      border: 1px solid var(--line);
      border-radius: 8px;
      background: var(--panel);
      max-height: 76vh;
    }
    .sd-canvas:focus-visible {
      outline: 2px solid var(--accent);
    }
    .sd-canvas :global(svg) {
      display: block;
      max-width: 100%;
      height: auto;
      user-select: none;
      cursor: default;
    }
    @media (min-width: 700px) {
      .sd-canvas :global(svg) {
        touch-action: none;
      }
    }
    .sd-canvas.linking :global(svg) {
      cursor: crosshair;
    }
    .sd-btns {
      margin-top: 10px;
    }
    .sd-file {
      position: relative;
      overflow: hidden;
    }
    .sd-file input {
      position: absolute;
      inset: 0;
      opacity: 0;
      cursor: pointer;
    }
    .sd-h {
      font-size: 18px;
      margin: 14px 0 6px;
    }
    .sd-props .sd-h {
      margin-top: 0;
    }
    .sd-findings {
      margin: 0;
      padding-left: 0;
      list-style: none;
      font-size: 14.5px;
    }
    .sd-findings :global(li) {
      margin: 4px 0;
    }
    .sd-findings :global(button) {
      all: unset;
      cursor: pointer;
      display: block;
      padding: 4px 8px;
      border-left: 4px solid var(--line);
      border-radius: 4px;
    }
    .sd-findings :global(button:focus-visible) {
      outline: 2px solid var(--accent);
    }
    .sd-findings :global(.fault) {
      border-left-color: #b42318;
    }
    .sd-findings :global(.warn) {
      border-left-color: #b54708;
    }
    .sd-h3 {
      font-size: 16px;
      margin: 14px 0 6px;
    }
    .sd-table,
    #diff {
      overflow-x: auto;
    }
    .sd-table :global(table),
    #diff :global(table) {
      border-collapse: collapse;
      width: 100%;
      font-size: 14px;
    }
    .sd-table :global(th),
    .sd-table :global(td),
    #diff :global(th),
    #diff :global(td) {
      border-bottom: 1px solid var(--line);
      padding: 4px 6px;
      text-align: left;
      vertical-align: top;
    }
    .sd-table :global(.warn),
    #diff :global(.warn) {
      color: #b54708;
      font-weight: 600;
    }
    #diff :global(.added) {
      color: #15803d;
      font-weight: 600;
    }
    #diff :global(.removed) {
      color: #b42318;
      font-weight: 600;
    }
    #diff :global(.changed) {
      color: #7c3aed;
      font-weight: 600;
    }
    /* 어두운 화면: 위 색은 대비가 모자라(2.6~3.5) 밝은 색으로 — 멀티미터 점검기와 같은 방식 */
    @media (prefers-color-scheme: dark) {
      .sd-findings :global(.fault) {
        border-left-color: #ff8a80;
      }
      .sd-findings :global(.warn) {
        border-left-color: #fbbf24;
      }
      .sd-table :global(.warn),
      #diff :global(.warn) {
        color: #fbbf24;
      }
      #diff :global(.added) {
        color: #4ade80;
      }
      #diff :global(.removed) {
        color: #ff8a80;
      }
      #diff :global(.changed) {
        color: #c4b5fd;
      }
    }
    #diff :global(ul) {
      padding-left: 18px;
      margin: 8px 0;
    }
    .sd-cmp {
      margin-top: 16px;
    }
    .sd-chk {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 14px;
    }
    .sd-chk input {
      width: auto;
      margin: 0;
    }
    #diffFallback {
      width: 100%;
    }
    #props :global(label.fld) {
      margin-bottom: 8px;
    }
    #props :global(.lk) {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 4px 6px;
      align-items: center;
      padding: 6px 0;
      border-top: 1px solid var(--line);
      font-size: 14px;
    }
    #props :global(.lk input) {
      grid-column: 1 / -1;
    }
    @media print {
      :global(body *) {
        visibility: hidden;
      }
      #sd-print,
      #sd-print :global(*) {
        visibility: visible;
      }
      #sd-print {
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
        border: 0;
      }
      .sd-btns,
      #msg {
        display: none;
      }
      .sd-canvas {
        max-height: none;
        overflow: visible;
        border: 0;
      }
    }
  </style>
  <script>
    import {
      EXAMPLES,
      LINK_NAME,
      NODE_KINDS,
      NODE_NAME,
      addLink,
      addScanRows,
      checkDoc,
      busStats,
      fmtUl,
      UNIT_LOADS,
      emptyDoc,
      freeSpot,
      hitTest,
      newId,
      parseNetScanCsv,
      removeItem,
      toDrawing,
      validateDoc,
      type LinkKind,
      type NodeKind,
      type SysDoc,
      type SysNode,
      type SysBus,
      type Finding,
    } from "../lib/sysDiagram";
    import { renderSvg, LIGHT, esc } from "../lib/diagramSvg";
    import { diffDocs, diffText, type DocDiff } from "../lib/sysDiff";
    import { saveText, savePng, screenPalette, onThemeChange, fileStamp, store } from "../lib/fileSave";
    import { tx, type Lang } from "../lib/tr";

    const root = document.getElementById("sd") as HTMLDivElement;
    const lang = (root.dataset.lang ?? "en") as Lang;
    const T = JSON.parse(root.dataset.t ?? "{}") as Record<string, string> & { bCols: string[]; dCols: string[]; iCols: string[] };
    const $ = <E extends HTMLElement = HTMLInputElement>(id: string) => document.getElementById(id) as E;
    const canvas = $<HTMLDivElement>("canvas");
    const KEY = "portdock.systemDiagram.v1";
    const BASE_KEY = "portdock.systemDiagram.base.v1";

    let doc: SysDoc = load();
    let selected: string | null = null;
    let pending: string | null = null;
    let linking = false;
    let printing = false;
    let findings: Finding[] = [];
    let drag: { id: string; dx: number; dy: number; moved: boolean } | null = null;
    let base: SysDoc | null = loadBase();
    let diff: DocDiff | null = null;

    function loadBase(): SysDoc | null {
      const raw = store.get(BASE_KEY);
      if (!raw) return null;
      try {
        return validateDoc(JSON.parse(raw)).doc;
      } catch {
        return null;
      }
    }

    function load(): SysDoc {
      const raw = store.get(KEY);
      if (raw) {
        try {
          const v = validateDoc(JSON.parse(raw));
          if (v.doc) return v.doc;
        } catch {
          /* 깨진 저장 — 예시로 */
        }
      }
      return EXAMPLES[0].make(lang);
    }
    let saveTimer = 0;
    function save() {
      clearTimeout(saveTimer);
      saveTimer = window.setTimeout(() => {
        if (!store.set(KEY, JSON.stringify(doc))) $("msg").textContent = T.storeOff;
      }, 300);
    }

    // ---- 그리기
    function draw() {
      findings = checkDoc(doc, lang);
      const flagged = new Set(findings.filter((f) => f.level !== "info").flatMap((f) => f.ids));
      diff = base ? diffDocs(base, doc, lang) : null;
      const show = !!diff && $<HTMLInputElement>("showDiff").checked;
      const svg = renderSvg(toDrawing(doc, lang, { selected, pending, flagged, ...(show && diff ? { added: diff.added, changed: diff.changed, ghosts: diff.removed } : {}) }), printing ? LIGHT : screenPalette(), {});
      canvas.innerHTML = svg;
      canvas.classList.toggle("linking", linking);
      const fl = $("findings");
      fl.innerHTML = findings.length
        ? findings.map((f, i) => `<li><button type="button" class="${f.level}" data-f="${i}">${f.level === "fault" ? "✖ " : f.level === "warn" ? "⚠ " : "· "}${esc(f.text)}</button></li>`).join("")
        : `<li>${esc(T.allOk)}</li>`;
      $<HTMLButtonElement>("delSel").disabled = !selected;
      fillPick();
      drawBusSum();
      drawDiff();
    }
    const ms = (sec: number) => (sec >= 1 ? `${(Math.round(sec * 100) / 100).toFixed(2)} s` : `${Math.round(sec * 1000)} ms`);
    function drawBusSum() {
      const rows = doc.buses
        .filter((b) => b.kind === "rs485")
        .map((b) => {
          const st = busStats(doc, b);
          return `<tr><td>${esc(b.name || b.id)}</td><td>${st.devices.length}</td><td${st.unitLoads > 32 ? ' class="warn"' : ""}>${fmtUl(st.unitLoads)}</td><td>${st.baud}${st.baudAssumed ? ` ${esc(T.assumed)}` : ""}</td><td>${st.slaves.length ? ms(st.cycle) : "—"}</td></tr>`;
        });
      $("busSum").innerHTML = rows.length ? `<table><thead><tr>${T.bCols.map((c) => `<th>${esc(c)}</th>`).join("")}</tr></thead><tbody>${rows.join("")}</tbody></table>` : "";
    }
    function drawDiff() {
      $<HTMLButtonElement>("bBaseClear").disabled = !base;
      $<HTMLButtonElement>("bDiffCopy").disabled = !diff;
      $("diffLegend").hidden = !diff || diff.same;
      if (!base || !diff) {
        $("baseInfo").textContent = T.noBase;
        $("diff").innerHTML = "";
        return;
      }
      $("baseInfo").textContent = T.baseInfo.replace("{t}", base.title || "—").replace("{n}", String(base.nodes.length));
      if (diff.same) {
        $("diff").innerHTML = `<p>${esc(T.same)}</p>`;
        return;
      }
      const lab = { added: T.dAdded, removed: T.dRemoved, changed: T.dChanged };
      const rows = diff.rows.map((r) => `<tr><td class="${r.change}">${esc(lab[r.change])}</td><td>${esc(r.name)}</td><td>${esc(r.details.join(", "))}</td></tr>`).join("");
      const f = (st: ReturnType<typeof busStats> | null) => (st ? `${st.devices.length} · UL ${fmtUl(st.unitLoads)} · ${st.slaves.length ? ms(st.cycle) : "—"}` : "—");
      const bus = diff.buses
        .map((b) => {
          const grew = b.before && b.after && b.after.cycle > b.before.cycle * 1.0001;
          return `<tr><td>${esc(b.name)}</td><td>${esc(f(b.before))}</td><td${b.after && b.after.unitLoads > 32 ? ' class="warn"' : grew ? ' class="changed"' : ""}>${esc(f(b.after))}</td></tr>`;
        })
        .join("");
      const fl = diff.findings.map((x) => `<li${x.level === "warn" ? ' class="warn"' : ""}>${x.level === "warn" ? "⚠ " : ""}${esc(x.text)}</li>`).join("");
      $("diff").innerHTML =
        `<table><thead><tr>${T.dCols.map((c) => `<th>${esc(c)}</th>`).join("")}</tr></thead><tbody>${rows}</tbody></table>` +
        (bus ? `<table style="margin-top:10px"><thead><tr>${T.iCols.map((c) => `<th>${esc(c)}</th>`).join("")}</tr></thead><tbody>${bus}</tbody></table>` : "") +
        (fl ? `<ul>${fl}</ul>` : "");
    }
    function changed() {
      draw();
      save();
    }

    // ---- 고른 것 칸
    const PAR = () => [
      ["", T.pAny],
      ["none", T.pN],
      ["even", T.pE],
      ["odd", T.pO],
    ];
    function field(label: string, value: string, on: (v: string) => void, opts?: { options?: string[][]; mono?: boolean; area?: boolean }) {
      const l = document.createElement("label");
      l.className = "fld";
      l.append(label);
      let el: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;
      if (opts?.options) {
        const s = document.createElement("select");
        for (const [v, t] of opts.options) s.append(new Option(t, v));
        el = s;
      } else if (opts?.area) {
        const a = document.createElement("textarea");
        a.rows = 2;
        a.maxLength = 300;
        el = a;
      } else {
        const i = document.createElement("input");
        i.autocomplete = "off";
        i.maxLength = 80;
        if (opts?.mono) i.className = "mono";
        el = i;
      }
      el.value = value;
      el.addEventListener(opts?.options ? "change" : "input", () => on(el.value));
      l.append(el);
      return l;
    }
    const numOrUndef = (v: string) => {
      const n = Number(v);
      return v.trim() === "" || !Number.isFinite(n) ? undefined : Math.round(n);
    };
    function drawProps() {
      const box = $("props");
      box.replaceChildren();
      const n = doc.nodes.find((x) => x.id === selected);
      const b = doc.buses.find((x) => x.id === selected);
      if (!n && !b) {
        const p = document.createElement("p");
        p.className = "note";
        p.textContent = T.none;
        box.append(p);
        return;
      }
      const upd = (fn: () => void) => {
        fn();
        changed();
      };
      if (n) {
        box.append(
          field(T.name, n.name, (v) => upd(() => (n.name = v))),
          field(T.kind, n.kind, (v) => upd(() => (n.kind = v as NodeKind)), { options: NODE_KINDS.map((k) => [k, tx(NODE_NAME[k], lang)]) }),
          field(T.ip, n.ip ?? "", (v) => upd(() => (v.trim() ? (n.ip = v.trim()) : delete n.ip)), { mono: true }),
          field(T.mask, n.mask ?? "", (v) => upd(() => (v.trim() ? (n.mask = v.trim()) : delete n.mask)), { mono: true }),
          field(T.unit, n.unit?.toString() ?? "", (v) => upd(() => {
            const u = numOrUndef(v);
            if (u === undefined) delete n.unit;
            else n.unit = u;
          }), { mono: true }),
          field(T.baud, n.baud?.toString() ?? "", (v) => upd(() => {
            const u = numOrUndef(v);
            if (u === undefined || u <= 0) delete n.baud;
            else n.baud = u;
          }), { mono: true }),
          field(T.parity, n.parity ?? "", (v) => upd(() => (v ? (n.parity = v as SysNode["parity"]) : delete n.parity)), { options: PAR() }),
          field(T.note, n.note ?? "", (v) => upd(() => (v ? (n.note = v) : delete n.note)), { area: true }),
        );
        const on485 = doc.links.some((l) => (l.a === n.id || l.b === n.id) && doc.buses.some((x) => x.kind === "rs485" && (x.id === l.a || x.id === l.b)));
        if (on485)
          box.append(
            field(T.term, n.term ? "on" : "", (v) => upd(() => (v ? (n.term = true) : delete n.term)), { options: [["", T.tOff], ["on", T.tOn]] }),
            field(T.ul, String(n.ul ?? 1), (v) => upd(() => (Number(v) === 1 ? delete n.ul : (n.ul = Number(v)))), { options: UNIT_LOADS.map((u) => [String(u), u === 1 ? "1" : `1/${Math.round(1 / u)}`]) }),
            field(T.regs, n.regs?.toString() ?? "", (v) => upd(() => {
              const u = numOrUndef(v);
              if (u === undefined || u < 1) delete n.regs;
              else n.regs = Math.min(10000, u);
            }), { mono: true }),
          );
      } else if (b) {
        box.append(
          field(T.name, b.name, (v) => upd(() => (b.name = v))),
          field(T.baud, b.baud?.toString() ?? "", (v) => upd(() => {
            const u = numOrUndef(v);
            if (u === undefined || u <= 0) delete b.baud;
            else b.baud = u;
          }), { mono: true }),
        );
        if (b.kind === "rs485")
          box.append(
            field(T.parity, b.parity ?? "", (v) => upd(() => (v ? (b.parity = v as SysBus["parity"]) : delete b.parity)), { options: PAR() }),
            field(T.termStart, b.termStart ? "on" : "", (v) => upd(() => (v ? (b.termStart = true) : delete b.termStart)), { options: [["", T.tOff], ["on", T.tOn]] }),
            field(T.termEnd, b.termEnd ? "on" : "", (v) => upd(() => (v ? (b.termEnd = true) : delete b.termEnd)), { options: [["", T.tOff], ["on", T.tOn]] }),
          );
        box.append(field(T.len, String(b.len), (v) => upd(() => {
          const u = numOrUndef(v);
          if (u !== undefined) b.len = Math.max(120, Math.min(4000, u));
        }), { mono: true }));
      }
      // 이어진 선
      const h = document.createElement("p");
      h.className = "fld-title";
      h.style.fontWeight = "600";
      h.textContent = T.links;
      box.append(h);
      const mine = doc.links.filter((l) => l.a === selected || l.b === selected);
      if (!mine.length) {
        const p = document.createElement("p");
        p.className = "note";
        p.textContent = T.noLinks;
        box.append(p);
      }
      const nameOf = (id: string) => doc.nodes.find((x) => x.id === id)?.name || doc.buses.find((x) => x.id === id)?.name || id;
      for (const l of mine) {
        const row = document.createElement("div");
        row.className = "lk";
        const other = l.a === selected ? l.b : l.a;
        const s = document.createElement("span");
        s.textContent = `${tx(LINK_NAME[l.kind], lang)} → ${nameOf(other)}`;
        const del = document.createElement("button");
        del.type = "button";
        del.className = "btn tight";
        del.textContent = "×";
        del.title = T.unlink;
        del.setAttribute("aria-label", `${T.unlink}: ${s.textContent}`);
        del.addEventListener("click", () => {
          doc.links = doc.links.filter((x) => x.id !== l.id);
          changed();
          drawProps();
        });
        const lab = document.createElement("input");
        lab.placeholder = T.label;
        lab.setAttribute("aria-label", T.label);
        lab.maxLength = 80;
        lab.value = l.label ?? "";
        lab.addEventListener("input", () => {
          if (lab.value) l.label = lab.value;
          else delete l.label;
          changed();
        });
        row.append(s, del, lab);
        box.append(row);
      }
      // 이을 대상 — 마우스 없이 선 잇기
      const others = allItems().filter((id) => id !== selected);
      if (others.length) {
        const row = document.createElement("div");
        row.className = "lk";
        const to = field(T.linkTo, others[0], () => {}, { options: others.map((id) => [id, itemName(id)]) });
        const go = document.createElement("button");
        go.type = "button";
        go.className = "btn tight";
        go.textContent = T.linkBtn;
        go.addEventListener("click", () => {
          const target = to.querySelector("select")!.value;
          const next = selected ? addLink(doc, $<HTMLSelectElement>("linkKind").value as LinkKind, selected, target) : null;
          if (!next) {
            $("msg").textContent = T.linkFail;
            return;
          }
          doc = next;
          changed();
          drawProps();
        });
        row.append(to, go);
        box.append(row);
      }
    }
    // 키보드로 고르기 — 캔버스를 누르지 않고도 장비·버스를 고른다(접근성)
    const itemName = (id: string) => doc.nodes.find((x) => x.id === id)?.name || doc.buses.find((x) => x.id === id)?.name || id;
    const allItems = () => [...doc.nodes.map((n) => n.id), ...doc.buses.map((b) => b.id)];
    function fillPick() {
      const sel = $<HTMLSelectElement>("pickItem");
      const opts: [string, string][] = [["", T.pickNone], ...allItems().map((id): [string, string] => [id, itemName(id)])];
      const sig = JSON.stringify(opts);
      if (sel.dataset.sig !== sig) {
        sel.replaceChildren(...opts.map(([v, t]) => new Option(t, v)));
        sel.dataset.sig = sig;
      }
      sel.value = selected ?? "";
    }
    $("pickItem").addEventListener("change", (e) => select((e.target as HTMLSelectElement).value || null));
    function select(id: string | null) {
      selected = id;
      drawProps();
      draw();
    }

    // ---- 넣기
    for (const b of document.querySelectorAll<HTMLButtonElement>("[data-add]")) {
      b.addEventListener("click", () => {
        const kind = b.dataset.add as NodeKind;
        const id = newId(doc, "n");
        const count = doc.nodes.filter((n) => n.kind === kind).length + 1;
        doc.nodes.push({ id, kind, name: `${tx(NODE_NAME[kind], lang)} ${count}`, ...freeSpot(doc) });
        select(id);
        save();
      });
    }
    for (const b of document.querySelectorAll<HTMLButtonElement>("[data-bus]")) {
      b.addEventListener("click", () => {
        const kind = b.dataset.bus as "rs485" | "can";
        const id = newId(doc, "b");
        const y = doc.nodes.reduce((m, n) => Math.max(m, n.y + 100), doc.buses.reduce((m, x) => Math.max(m, x.y + 140), 80));
        doc.buses.push({ id, kind, name: kind === "rs485" ? `RS-485 ${doc.buses.length + 1}` : `CAN ${doc.buses.length + 1}`, x: 40, y, len: 600, ...(kind === "rs485" ? { baud: 9600 } : { baud: 250000 }) });
        select(id);
        save();
      });
    }
    $("connect").addEventListener("click", () => {
      linking = !linking;
      pending = null;
      $("connect").setAttribute("aria-pressed", String(linking));
      $("hint").hidden = !linking;
      draw();
    });
    function deleteSelected() {
      if (!selected) return;
      doc = removeItem(doc, selected);
      select(null);
      save();
    }
    $("delSel").addEventListener("click", deleteSelected);

    // ---- 누르기·끌기
    function svgPoint(e: PointerEvent) {
      const svg = canvas.querySelector("svg");
      const m = svg?.getScreenCTM();
      if (!svg || !m) return null;
      const p = new DOMPoint(e.clientX, e.clientY).matrixTransform(m.inverse());
      return { x: p.x, y: p.y };
    }
    canvas.addEventListener("pointerdown", (e) => {
      const p = svgPoint(e);
      if (!p) return;
      const hit = hitTest(doc, p.x, p.y);
      if (linking) {
        if (!hit) return;
        if (!pending) {
          pending = hit;
          draw();
          return;
        }
        const next = addLink(doc, $<HTMLSelectElement>("linkKind").value as LinkKind, pending, hit);
        if (next) doc = next;
        pending = null;
        selected = hit;
        drawProps();
        changed();
        return;
      }
      if (hit !== selected) select(hit);
      if (!hit) return;
      const n = doc.nodes.find((x) => x.id === hit);
      const b = doc.buses.find((x) => x.id === hit);
      const it = n ?? b!;
      drag = { id: hit, dx: p.x - it.x, dy: p.y - it.y, moved: false };
      canvas.querySelector("svg")?.setPointerCapture(e.pointerId);
    });
    let raf = 0;
    canvas.addEventListener("pointermove", (e) => {
      if (!drag) return;
      const p = svgPoint(e);
      if (!p) return;
      const it = doc.nodes.find((x) => x.id === drag!.id) ?? doc.buses.find((x) => x.id === drag!.id);
      if (!it) return;
      const snap = (v: number) => Math.max(0, Math.round(v / 10) * 10);
      it.x = snap(p.x - drag.dx);
      it.y = snap(p.y - drag.dy);
      drag.moved = true;
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(draw);
    });
    const endDrag = () => {
      if (drag?.moved) save();
      drag = null;
    };
    // 다시 그리면 svg 가 바뀌어 포인터 잡기가 풀리므로 창 전체에서 놓기를 받는다
    window.addEventListener("pointerup", endDrag);
    canvas.addEventListener("pointercancel", endDrag);
    canvas.addEventListener("keydown", (e) => {
      if (!selected) return;
      const it = doc.nodes.find((x) => x.id === selected) ?? doc.buses.find((x) => x.id === selected);
      if (!it) return;
      const mv: Record<string, [number, number]> = { ArrowLeft: [-10, 0], ArrowRight: [10, 0], ArrowUp: [0, -10], ArrowDown: [0, 10] };
      if (e.key === "Delete" || e.key === "Backspace") {
        e.preventDefault();
        deleteSelected();
      } else if (mv[e.key]) {
        e.preventDefault();
        it.x = Math.max(0, it.x + mv[e.key][0]);
        it.y = Math.max(0, it.y + mv[e.key][1]);
        changed();
      } else if (e.key === "Escape") {
        pending = null;
        select(null);
      }
    });
    $("findings").addEventListener("click", (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>("button[data-f]");
      if (!b) return;
      const f = findings[Number(b.dataset.f)];
      if (f?.ids[0]) {
        select(f.ids[0]);
        canvas.focus();
      }
    });

    // ---- 문서
    function setDoc(d: SysDoc) {
      doc = d;
      selected = null;
      pending = null;
      $("docTitle").value = doc.title;
      drawProps();
      changed();
    }
    $("docTitle").addEventListener("input", () => {
      doc.title = $("docTitle").value;
      save();
    });
    $<HTMLSelectElement>("example").addEventListener("change", () => {
      const ex = EXAMPLES.find((x) => x.id === $<HTMLSelectElement>("example").value);
      if (ex) setDoc(ex.make(lang));
      $<HTMLSelectElement>("example").value = "";
    });
    $("fresh").addEventListener("click", () => {
      if (doc.nodes.length && !confirm(T.freshAsk)) return;
      setDoc(emptyDoc());
    });
    const fname = (ext: string) => `portdock-system-diagram-${fileStamp()}.${ext}`;
    $("bJson").addEventListener("click", () => saveText(JSON.stringify(doc, null, 2), fname("json"), "application/json"));
    const exportSvg = () => renderSvg(toDrawing(doc, lang), LIGHT, { bg: true, title: true, footer: T.footer });
    $("bSvg").addEventListener("click", () => saveText(exportSvg(), fname("svg"), "image/svg+xml"));
    $("bPng").addEventListener("click", () => {
      savePng(exportSvg(), fname("png")).catch(() => ($("msg").textContent = T.pngFail));
    });
    $("bPrint").addEventListener("click", () => window.print());
    window.addEventListener("beforeprint", () => {
      printing = true;
      draw();
    });
    window.addEventListener("afterprint", () => {
      printing = false;
      draw();
    });
    const readFile = (input: HTMLInputElement, fn: (text: string) => void) => {
      input.addEventListener("change", () => {
        const f = input.files?.[0];
        input.value = "";
        if (!f) return;
        if (f.size > 5 * 1024 * 1024) {
          $("msg").textContent = `${T.bad}: > 5 MB`;
          return;
        }
        f.text().then(fn, () => ($("msg").textContent = T.bad));
      });
    };
    readFile($("fJson"), (text) => {
      try {
        const v = validateDoc(JSON.parse(text));
        if (!v.doc) {
          $("msg").textContent = `${T.bad}: ${v.errors.slice(0, 3).join("; ")}`;
          return;
        }
        setDoc(v.doc);
        $("msg").textContent = v.errors.length ? `${T.skipped}: ${v.errors.slice(0, 3).join("; ")}` : "";
      } catch (e) {
        $("msg").textContent = `${T.bad}: ${(e as Error).message}`;
      }
    });
    readFile($("fScan"), (text) => {
      const { rows } = parseNetScanCsv(text);
      if (!rows.length) {
        $("msg").textContent = T.scanNone;
        return;
      }
      doc = addScanRows(doc, rows, lang);
      $("msg").textContent = T.scanAdded.replace("{n}", String(rows.length));
      changed();
    });
    // ---- 변경 비교
    function setBase(d: SysDoc | null) {
      base = d;
      if (d) store.set(BASE_KEY, JSON.stringify(d));
      else store.remove(BASE_KEY);
      draw();
    }
    $("bBase").addEventListener("click", () => setBase(structuredClone(doc)));
    $("bBaseClear").addEventListener("click", () => setBase(null));
    $("showDiff").addEventListener("change", draw);
    readFile($("fBase"), (text) => {
      try {
        const v = validateDoc(JSON.parse(text));
        if (!v.doc) {
          $("baseInfo").textContent = `${T.bad}: ${v.errors.slice(0, 3).join("; ")}`;
          return;
        }
        setBase(v.doc);
      } catch (e) {
        $("baseInfo").textContent = `${T.bad}: ${(e as Error).message}`;
      }
    });
    $("bDiffCopy").addEventListener("click", () => {
      if (!diff) return;
      const text = diffText(diff, lang);
      const fb = $<HTMLTextAreaElement>("diffFallback");
      const fail = () => {
        fb.hidden = false;
        fb.value = text;
        fb.select();
      };
      if (!navigator.clipboard) return fail();
      navigator.clipboard.writeText(text).then(() => {
        fb.hidden = true;
        $("baseInfo").textContent = T.copied;
      }, fail);
    });

    onThemeChange(draw);
    $("docTitle").value = doc.title;
    drawProps();
    draw();
  </script>
</Base>
