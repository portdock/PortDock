---
// 웹 도구: 케이블·단자 라벨 만들기 — 연번(W001~W120, X1:1~X1:40)·붙여넣은 장비 IO 이름·양끝 «A→B» 쌍 라벨,
// A4 라벨 용지 배치(행·열·여백 mm) 미리보기와 인쇄, 라벨 프린터·열수축 튜브 프린터용 CSV·텍스트 내보내기.
// 목록·배치·내보내기는 lib/cableLabels.ts(node --test). 모두 브라우저 안 — 서버로 보내지 않는다.
import FaqBlock from "../components/FaqBlock.astro";
import Base from "../layouts/Base.astro";
import AdSlot from "../components/AdSlot.astro";
import Crumbs from "../components/Crumbs.astro";
import WebToolLinks from "../components/WebToolLinks.astro";
import UseNotice from "../components/UseNotice.astro";
import { SHEET_PRESETS, MAX_LABELS } from "../lib/cableLabels";
import type { SiteLang } from "../i18n/langs";
import { page7 } from "../i18n";
import { pageName } from "../i18n/names";
import { ui, link } from "../lib/i18n";
import { tx } from "../lib/tr";

interface Props {
  lang: SiteLang;
}
const { lang } = Astro.props;
const PATH = "tools/cable-labels/";
const L =
  lang === "ko"
  ? {
      h1: "케이블·단자 라벨 만들기",
      desc: "W001~W120·X1:1~X1:40 연번, 장비 IO 이름 붙여넣기, 양끝 «A→B» 라벨을 만들어 A4 라벨 용지에 인쇄하거나 라벨 프린터용 CSV 로 내보냅니다.",
      seo: "케이블 라벨·단자 번호 만들기 (A4 인쇄·CSV) — PortDock",
      mode: "만드는 방법",
      modes: [
        ["seq", "연번 (W001~W120, X1:1~X1:40)"],
        ["list", "이름 붙여넣기 (장비 IO 목록)"],
        ["pair", "양끝 라벨 (A→B)"],
      ],
      prefix: "앞 글자",
      start: "시작",
      end: "끝",
      digits: "자릿수(0 = 채우지 않음)",
      step: "간격",
      suffix: "뒤 글자",
      listLbl: "한 줄에 하나 — 엑셀에서 두 열(주소·이름)을 복사해 붙이면 «주소 이름» 으로",
      listPh: "%IX0.0\tStart PB\n%IX0.1\tStop PB\n%QX0.0\tMotor run",
      pairLbl: "한 줄에 «케이블, A 끝, B 끝» 또는 «A 끝, B 끝» (탭·세미콜론·쉼표로 나눔)",
      pairPh: "W001, X1:1, K1:A1\nW002, X1:2, K1:A2\nW003, X2:5, M1:U",
      reverse: "B 끝 라벨은 «B→A» 로 뒤집기",
      arrow: "화살표",
      copies: "라벨마다 장 수",
      sheet: "용지·배치 (mm)",
      preset: "용지 예",
      custom: "직접 입력",
      pageW: "용지 너비",
      pageH: "용지 높이",
      rows: "행",
      cols: "열",
      mTop: "위 여백",
      mLeft: "왼쪽 여백",
      gapX: "가로 간격",
      gapY: "세로 간격",
      lw: "라벨 너비(0 = 나눠 계산)",
      lh: "라벨 높이(0 = 나눠 계산)",
      skip: "첫 장에서 이미 쓴 칸",
      font: "글자 크기(pt)",
      border: "자를 선(테두리) 인쇄",
      print: "인쇄",
      csv: "CSV 저장",
      txt: "텍스트 저장",
      copy: "목록 복사",
      copied: "복사했습니다.",
      copyFail: "복사하지 못했습니다 — 아래 글을 직접 골라 복사하세요.",
      sum: (n: number, pages: number, w: number, h: number) => `라벨 ${n}개 · ${pages}장 · 라벨 ${w} × ${h} mm`,
      previewNote: "미리보기는 앞 두 장만 줄여서 보여 줍니다. 인쇄는 모든 장입니다.",
      printNote: "인쇄 창에서 «실제 크기(100 %)»·여백 «없음» 으로 고르고, 먼저 보통 종이에 찍어 라벨 용지에 겹쳐 맞춰 보세요.",
      privacy: "넣은 이름은 이 브라우저 안에서만 쓰며 어디에도 보내지 않습니다.",
      howTitle: "쓰는 법",
      how: [
        "케이블 번호는 연번(W001…)으로, 단자대 번호는 «X1:» 앞 글자와 자릿수 0 으로 만듭니다. 케이블 양끝에 같은 번호를 붙이려면 «라벨마다 장 수» 를 2 로 둡니다.",
        "PLC·리모트 IO 의 주소·이름 목록은 엑셀·CSV 에서 두 열을 복사해 붙이면 줄마다 «주소 이름» 라벨이 됩니다.",
        "양끝 라벨은 «케이블, A 끝, B 끝» 을 한 줄로 넣습니다. 각 끝에서 자기 쪽 단자가 먼저 읽히게 하려면 «B 끝 뒤집기» 를 켭니다.",
        "용지 포장에 적힌 행·열·라벨 크기·여백을 넣습니다. 라벨 크기를 0 으로 두면 여백·간격을 뺀 자리를 똑같이 나눕니다. 쓰다 남은 용지는 «이미 쓴 칸» 만큼 앞을 비웁니다.",
        "라벨 프린터·열수축 튜브 프린터는 그 소프트웨어의 «CSV·텍스트 불러오기(데이터베이스·직렬화)» 로 CSV(No, Label, End 열)나 한 줄에 하나인 텍스트를 읽게 합니다. 튜브 크기·글자 크기는 프린터 쪽에서 정합니다.",
      ],
      noteTitle: "번호 붙이는 습관",
      notes: [
        "번호 규칙(케이블 W, 단자대 X, 장비 -K·-M 등)은 현장·도면의 규칙을 먼저 따릅니다. 도면의 번호와 라벨이 같아야 나중에 찾을 수 있습니다.",
        "라벨은 단자에서 읽을 수 있는 방향으로, 피복 위 단자 가까이 붙입니다. 열수축 튜브는 압착 전에 끼워야 합니다.",
      ],
      see: ["배선도를 그려 두려면 ", ". 페룰 색·단자 크기는 ", "."],
      seeLinks: ["배선도 만들기", "페룰·압착 단자 규격표"],
      faqTitle: "자주 묻는 것",
      faq: [
        ["라벨 용지에 위치가 맞지 않게 찍혀요", "인쇄 창에서 «실제 크기(100 %)»·여백 «없음» 으로 고르고, 먼저 보통 종이에 찍어 라벨 용지에 겹쳐 봅니다. 어긋나면 «용지·배치» 의 위·왼쪽 여백과 가로·세로 간격(mm)을 고칩니다. 용지 예에 없는 용지는 «직접 입력» 으로 너비·높이·행·열을 넣습니다."],
        ["반쯤 쓴 라벨 용지를 다시 쓸 수 있나요?", "네. «첫 장에서 이미 쓴 칸» 에 이미 떼어 낸 칸 수를 넣으면 그 다음 칸부터 찍습니다."],
        ["라벨 프린터로 찍으려면?", "«CSV 저장» 으로 라벨 목록을 내보내 라벨 프린터 프로그램에서 불러옵니다. 양끝 라벨에서 «B 끝 라벨은 «B→A» 로 뒤집기» 를 켜면 B 끝에 붙일 라벨이 «B→A» 로 찍힙니다."],
      ] as [string, string][],
    }
  : lang === "en"
  ? {
      h1: "Cable & Terminal Label Maker",
      desc: "Make sequential labels (W001–W120, X1:1–X1:40), labels from pasted I/O names, or two-end «A→B» labels; print on A4 label sheets or export CSV for printers.",
      seo: "Cable Label & Wire Marker Maker: A4 Sheets, CSV — PortDock",
      mode: "Mode",
      modes: [
        ["seq", "Sequence (W001–W120, X1:1–X1:40)"],
        ["list", "Paste names (device I/O list)"],
        ["pair", "Two-end labels (A→B)"],
      ],
      prefix: "Prefix",
      start: "Start",
      end: "End",
      digits: "Digits (0 = no padding)",
      step: "Step",
      suffix: "Suffix",
      listLbl: "One per line — paste two columns (address, name) from Excel to get «address name»",
      listPh: "%IX0.0\tStart PB\n%IX0.1\tStop PB\n%QX0.0\tMotor run",
      pairLbl: "One per line: «cable, end A, end B» or «end A, end B» (tab, semicolon or comma)",
      pairPh: "W001, X1:1, K1:A1\nW002, X1:2, K1:A2\nW003, X2:5, M1:U",
      reverse: "Reverse the B-end label to «B→A»",
      arrow: "Arrow",
      copies: "Copies per label",
      sheet: "Sheet and layout (mm)",
      preset: "Sheet preset",
      custom: "Custom",
      pageW: "Page width",
      pageH: "Page height",
      rows: "Rows",
      cols: "Columns",
      mTop: "Top margin",
      mLeft: "Left margin",
      gapX: "Horizontal gap",
      gapY: "Vertical gap",
      lw: "Label width (0 = split evenly)",
      lh: "Label height (0 = split evenly)",
      skip: "Cells already used on the first sheet",
      font: "Font size (pt)",
      border: "Print cut lines (borders)",
      print: "Print",
      csv: "Save CSV",
      txt: "Save text",
      copy: "Copy list",
      copied: "Copied.",
      copyFail: "Could not copy — select the text below and copy it yourself.",
      sum: (n: number, pages: number, w: number, h: number) => `${n} labels · ${pages} sheet${pages === 1 ? "" : "s"} · label ${w} × ${h} mm`,
      previewNote: "The preview shows the first two sheets, scaled down. Printing includes every sheet.",
      printNote: "In the print dialog choose «Actual size (100 %)» and margins «None», and print on plain paper first to line it up with the label sheet.",
      privacy: "Names you enter stay inside this browser and are sent nowhere.",
      howTitle: "How to use it",
      how: [
        "Make cable numbers as a sequence (W001…), and terminal numbers with the prefix «X1:» and 0 digits. To put the same number on both cable ends, set «Copies per label» to 2.",
        "For a PLC or remote I/O list, copy the address and name columns from Excel or CSV and paste — each line becomes an «address name» label.",
        "For two-end labels, enter «cable, end A, end B» per line. Turn on «Reverse the B-end label» so each end reads its own terminal first.",
        "Enter the rows, columns, label size and margins printed on the label sheet pack. Leave the label size at 0 to split the space evenly after margins and gaps. For a partly used sheet, skip the cells already used.",
        "For label printers and heat-shrink sleeve printers, use the software's CSV or text import (database or serialisation) to read the CSV (No, Label, End columns) or the one-per-line text. Sleeve size and font size are set in the printer software.",
      ],
      noteTitle: "Numbering habits",
      notes: [
        "Follow the site and drawing conventions first (cables W, terminal strips X, devices -K, -M and so on). Labels must match the drawing to be useful later.",
        "Place labels near the terminal on the insulation, readable from the terminal side. Heat-shrink sleeves go on before crimping.",
      ],
      see: ["To draw the wiring, use the ", ". For ferrule colours and lug sizes, see the ", "."],
      seeLinks: ["wiring diagram maker", "ferrule and crimp terminal chart"],
      faqTitle: "FAQ",
      faq: [
        ["The labels print in the wrong place on the sheet", "In the print dialog choose «Actual size (100 %)» and margins «None», then print on plain paper first and hold it over the label sheet. If it is off, adjust the top/left margins and horizontal/vertical gaps (mm) under «Sheet and layout». For a sheet not in the presets, choose «Custom» and enter width, height, rows and columns."],
        ["Can I reuse a partly used label sheet?", "Yes. Enter the number of labels already peeled off in «Cells already used on the first sheet» and printing starts at the next cell."],
        ["How do I print on a label printer?", "Use «Save CSV» and import the list in the label printer software. For two-end labels, turn on «Reverse the B-end label to «B→A»» so the label for the B end reads «B→A»."],
      ] as [string, string][],
    }
  : { ...page7(lang, "cableLabels"), seeLinks: ["tools/wiring/", "tools/ferrules/"].map((p) => pageName(lang, p)) };
const T = { copied: L.copied, copyFail: L.copyFail };
const SUM_TPL = L.sum(111111, 222222, 333333, 444444);
const P0 = SHEET_PRESETS[1].s;
// 자주 묻는 것(FAQPage) — components/FaqBlock.astro
const FAQ = L.faq as [string, string][];
---

<Base lang={lang} title={L.h1} seoTitle={L.seo} description={L.desc} path={PATH} ads libText={["cableLabels"]}>
  <header class="page-head">
    <div class="wrap">
      <Crumbs lang={lang} items={[{ name: ui(lang).webTools, path: "tools/" }, { name: L.h1, path: PATH }]} />
      <h1>{L.h1}</h1>
      <p>{L.desc}</p>
    </div>
  </header>
  <div class="wrap" style="padding-top:24px">
    <form class="calc card" id="cl" data-lang={lang} data-t={JSON.stringify({ ...T, sumTpl: SUM_TPL, max: MAX_LABELS })} data-presets={JSON.stringify(SHEET_PRESETS.map((p) => p.s))}>
      <div class="row">
        <label class="fld">{L.mode}<select id="mode">{L.modes.map(([v, n]) => <option value={v}>{n}</option>)}</select></label>
        <label class="fld">{L.copies}<input id="copies" class="mono" value="1" inputmode="numeric" autocomplete="off" /></label>
      </div>
      <div class="row" data-for="seq">
        <label class="fld">{L.prefix}<input id="prefix" class="mono" value="W" autocomplete="off" spellcheck="false" /></label>
        <label class="fld">{L.start}<input id="start" class="mono" value="1" inputmode="numeric" autocomplete="off" /></label>
        <label class="fld">{L.end}<input id="end" class="mono" value="120" inputmode="numeric" autocomplete="off" /></label>
        <label class="fld">{L.digits}<input id="digits" class="mono" value="3" inputmode="numeric" autocomplete="off" /></label>
        <label class="fld">{L.step}<input id="step" class="mono" value="1" inputmode="numeric" autocomplete="off" /></label>
        <label class="fld">{L.suffix}<input id="suffix" class="mono" value="" autocomplete="off" spellcheck="false" /></label>
      </div>
      <div data-for="list" hidden>
        <label class="fld" style="display:block">{L.listLbl}<textarea id="list" rows="6" class="mono" spellcheck="false" placeholder={L.listPh}>{L.listPh}</textarea></label>
      </div>
      <div data-for="pair" hidden>
        <label class="fld" style="display:block">{L.pairLbl}<textarea id="pair" rows="6" class="mono" spellcheck="false" placeholder={L.pairPh}>{L.pairPh}</textarea></label>
        <div class="row">
          <label class="fld">{L.arrow}<input id="arrow" class="mono" value="→" autocomplete="off" /></label>
          <label class="ck"><input type="checkbox" id="reverse" /> {L.reverse}</label>
        </div>
      </div>
      <h2>{L.sheet}</h2>
      <div class="row">
        <label class="fld">{L.preset}<select id="preset">{SHEET_PRESETS.map((p, i) => <option value={String(i)} selected={i === 1}>{tx(p.name, lang)}</option>)}<option value="custom">{L.custom}</option></select></label>
      </div>
      <div class="row">
        <label class="fld">{L.pageW}<input id="pageW" class="mono" value={P0.pageW} inputmode="decimal" autocomplete="off" /></label>
        <label class="fld">{L.pageH}<input id="pageH" class="mono" value={P0.pageH} inputmode="decimal" autocomplete="off" /></label>
        <label class="fld">{L.rows}<input id="rows" class="mono" value={P0.rows} inputmode="numeric" autocomplete="off" /></label>
        <label class="fld">{L.cols}<input id="cols" class="mono" value={P0.cols} inputmode="numeric" autocomplete="off" /></label>
        <label class="fld">{L.mTop}<input id="marginTop" class="mono" value={P0.marginTop} inputmode="decimal" autocomplete="off" /></label>
        <label class="fld">{L.mLeft}<input id="marginLeft" class="mono" value={P0.marginLeft} inputmode="decimal" autocomplete="off" /></label>
        <label class="fld">{L.gapX}<input id="gapX" class="mono" value={P0.gapX} inputmode="decimal" autocomplete="off" /></label>
        <label class="fld">{L.gapY}<input id="gapY" class="mono" value={P0.gapY} inputmode="decimal" autocomplete="off" /></label>
        <label class="fld">{L.lw}<input id="labelW" class="mono" value={P0.labelW} inputmode="decimal" autocomplete="off" /></label>
        <label class="fld">{L.lh}<input id="labelH" class="mono" value={P0.labelH} inputmode="decimal" autocomplete="off" /></label>
      </div>
      <div class="row">
        <label class="fld">{L.skip}<input id="skip" class="mono" value="0" inputmode="numeric" autocomplete="off" /></label>
        <label class="fld">{L.font}<input id="font" class="mono" value="10" inputmode="decimal" autocomplete="off" /></label>
        <label class="ck"><input type="checkbox" id="border" checked /> {L.border}</label>
      </div>
      <p class="err" id="err" role="alert"></p>
      <p class="cl-sum" id="sum" aria-live="polite"></p>
      <div class="cl-btns">
        <button type="button" class="btn tight" id="bPrint">{L.print}</button>
        <button type="button" class="btn tight" id="bCsv">{L.csv}</button>
        <button type="button" class="btn tight" id="bTxt">{L.txt}</button>
        <button type="button" class="btn tight" id="bCopy">{L.copy}</button>
      </div>
      <p class="note" id="msg" aria-live="polite"></p>
      <textarea id="fallback" rows="4" class="mono" hidden aria-label={L.copy}></textarea>
      <div class="cl-preview" aria-hidden="true"><div id="sheets"></div></div>
      <p class="note">{L.previewNote} {L.printNote}</p>
      <p class="note">{L.privacy}</p>
    </form>

    <AdSlot />

    <section class="prose">
      <h2>{L.howTitle}</h2>
      <ul>{L.how.map((x) => <li>{x}</li>)}</ul>
      <h2>{L.noteTitle}</h2>
      <ul>{L.notes.map((x) => <li>{x}</li>)}</ul>
      <FaqBlock lang={lang} items={FAQ} title={L.faqTitle} />
      <p>{L.see[0]}<a href={link(lang, "tools/wiring/")}>{L.seeLinks[0]}</a>{L.see[1]}<a href={link(lang, "tools/ferrules/")}>{L.seeLinks[1]}</a>{L.see[2]}</p>
    </section>
    <UseNotice lang={lang} />
    <WebToolLinks lang={lang} path={PATH} />
  </div>
  <style>
    .ck {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 14px;
      align-self: end;
      padding-bottom: 8px;
    }
    textarea {
      width: 100%;
    }
    .cl-sum {
      font-weight: 600;
      margin: 8px 0;
    }
    .cl-btns {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }
    .cl-preview {
      overflow: auto;
      max-height: 560px;
      margin-top: 12px;
      padding: 8px;
      background: color-mix(in srgb, var(--muted) 15%, transparent);
      border-radius: 8px;
    }
    #sheets {
      zoom: 0.5;
    }
    #sheets :global(.sheet) {
      position: relative;
      background: #fff;
      color: #000;
      box-shadow: 0 1px 4px rgb(0 0 0 / 25%);
      margin: 0 auto 16px;
      overflow: hidden;
    }
    #sheets :global(.sheet:nth-child(n + 3)) {
      display: none;
    }
    #sheets :global(.lbl) {
      position: absolute;
      box-sizing: border-box;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 1mm;
      font-family: "Cascadia Mono", Consolas, monospace;
      line-height: 1.15;
      overflow: hidden;
      overflow-wrap: anywhere;
    }
    #sheets :global(.lbl.bd) {
      outline: 0.2mm dashed #888;
      outline-offset: -0.1mm;
    }
    @media print {
      :global(body *) {
        visibility: hidden;
      }
      #sheets,
      #sheets :global(*) {
        visibility: visible;
      }
      .cl-preview {
        overflow: visible;
        max-height: none;
        padding: 0;
        background: none;
      }
      #sheets {
        zoom: 1;
        position: absolute;
        left: 0;
        top: 0;
      }
      #sheets :global(.sheet) {
        margin: 0;
        box-shadow: none;
        break-after: page;
      }
      #sheets :global(.sheet:nth-child(n + 3)) {
        display: block;
      }
    }
  </style>
  <script>
    import { layoutSheet, listLabels, paginate, pairLabels, repeatEach, seqLabels, toCsv, toText, type Sheet } from "../lib/cableLabels";
    import { saveText, fileStamp } from "../lib/fileSave";
    import { tx, type Lang } from "../lib/tr";

    const form = document.getElementById("cl") as HTMLFormElement;
    const lang = (form.dataset.lang ?? "en") as Lang;
    const T = JSON.parse(form.dataset.t ?? "{}") as { copied: string; copyFail: string; sumTpl: string };
    const PRESETS = JSON.parse(form.dataset.presets ?? "[]") as Sheet[];
    const $ = <E extends HTMLElement = HTMLInputElement>(id: string) => document.getElementById(id) as unknown as E;
    const num = (id: string) => Number(($(id) as HTMLInputElement).value.trim().replace(",", "."));
    const SHEET_KEYS = ["pageW", "pageH", "rows", "cols", "marginTop", "marginLeft", "gapX", "gapY", "labelW", "labelH"] as const;

    // @page 크기는 용지 칸을 따른다
    const pageStyle = document.createElement("style");
    document.head.append(pageStyle);

    let rows: { label: string; end?: "A" | "B" }[] = [];

    function build(): { ok: true } | { ok: false; msg: string } {
      const mode = ($("mode") as HTMLSelectElement).value;
      for (const el of form.querySelectorAll<HTMLElement>("[data-for]")) el.hidden = el.dataset.for !== mode;
      const copies = Math.min(10, Math.max(1, Math.floor(num("copies")) || 1));
      if (mode === "seq") {
        const r = seqLabels({ prefix: $("prefix").value, start: num("start"), end: num("end"), digits: num("digits"), step: num("step"), suffix: $("suffix").value });
        if (!r.ok) return { ok: false, msg: tx(r.error, lang) };
        rows = repeatEach(r.value, copies).map((label) => ({ label }));
      } else if (mode === "list") {
        const r = listLabels(($("list") as unknown as HTMLTextAreaElement).value);
        if (!r.ok) return { ok: false, msg: tx(r.error, lang) };
        rows = repeatEach(r.value, copies).map((label) => ({ label }));
      } else {
        const r = pairLabels(($("pair") as unknown as HTMLTextAreaElement).value, { arrow: $("arrow").value || "→", reverseAtB: $("reverse").checked });
        if (!r.ok) return { ok: false, msg: tx(r.error, lang) };
        rows = repeatEach(r.value, copies).map((x) => ({ label: x.label, end: x.end }));
      }
      return { ok: true };
    }

    function render() {
      const err = $("err") as HTMLElement;
      const b = build();
      const sheet = Object.fromEntries(SHEET_KEYS.map((k) => [k, num(k)])) as unknown as Sheet;
      const lay = layoutSheet(sheet);
      const host = $("sheets") as HTMLElement;
      if (!b.ok || !lay.ok) {
        err.textContent = !b.ok ? b.msg : !lay.ok ? tx(lay.error, lang) : "";
        host.replaceChildren();
        $("sum").textContent = "";
        return;
      }
      err.textContent = "";
      const l = lay.value;
      const pages = paginate(
        rows.map((r) => r.label),
        l.perPage,
        num("skip") || 0,
      );
      pageStyle.textContent = `@page { size: ${sheet.pageW}mm ${sheet.pageH}mm; margin: 0; }`;
      const font = Math.min(72, Math.max(4, num("font") || 10));
      const bd = $("border").checked;
      host.replaceChildren(
        ...pages.map((pg) => {
          const s = document.createElement("div");
          s.className = "sheet";
          s.style.width = `${sheet.pageW}mm`;
          s.style.height = `${sheet.pageH}mm`;
          pg.forEach((txt, i) => {
            if (txt === null) return;
            const c = l.cells[i];
            const d = document.createElement("div");
            d.className = bd ? "lbl bd" : "lbl";
            d.style.left = `${c.x}mm`;
            d.style.top = `${c.y}mm`;
            d.style.width = `${l.labelW}mm`;
            d.style.height = `${l.labelH}mm`;
            d.style.fontSize = `${font}pt`;
            d.textContent = txt;
            s.append(d);
          });
          return s;
        }),
      );
      $("sum").textContent = T.sumTpl.replace("111111", String(rows.length)).replace("222222", String(pages.length)).replace("333333", String(l.labelW)).replace("444444", String(l.labelH));
    }

    function copy(text: string) {
      const fb = $("fallback") as unknown as HTMLTextAreaElement;
      const fail = () => {
        fb.hidden = false;
        fb.value = text;
        fb.select();
        $("msg").textContent = T.copyFail;
      };
      if (!navigator.clipboard) return fail();
      navigator.clipboard.writeText(text).then(() => {
        fb.hidden = true;
        $("msg").textContent = T.copied;
      }, fail);
    }

    ($("preset") as unknown as HTMLSelectElement).addEventListener("change", (e) => {
      const v = (e.target as HTMLSelectElement).value;
      const p = PRESETS[Number(v)];
      if (v !== "custom" && p) for (const k of SHEET_KEYS) $(k).value = String(p[k]);
      render();
    });
    form.addEventListener("input", (e) => {
      const id = (e.target as HTMLElement).id;
      if ((SHEET_KEYS as readonly string[]).includes(id)) ($("preset") as unknown as HTMLSelectElement).value = "custom";
      render();
    });
    form.addEventListener("change", render);
    form.addEventListener("submit", (e) => e.preventDefault());
    $("bPrint").addEventListener("click", () => window.print());
    $("bCsv").addEventListener("click", () => saveText("﻿" + toCsv(rows), `portdock-labels-${fileStamp()}.csv`, "text/csv;charset=utf-8"));
    $("bTxt").addEventListener("click", () => saveText(toText(rows.map((r) => r.label)), `portdock-labels-${fileStamp()}.txt`, "text/plain;charset=utf-8"));
    $("bCopy").addEventListener("click", () => copy(toText(rows.map((r) => r.label))));
    render();
  </script>
</Base>
