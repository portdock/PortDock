---
// 이용 안내(짧은 면책) — 웹 도구·가이드·장비 레지스터 맵 페이지의 본문 끝(광고 칸 아래가 아니라 본문 안 마지막)에 둔다.
// 문구는 lib/i18n.ts 의 UI(추가 언어는 i18n/<언어>/ui.ts) 한 곳에서만 고친다. 전체 내용은 이용 안내 페이지(terms/).
// 약관규제법 7조 1호: 고의·중과실 책임까지 빼는 문구는 무효 — «어떠한 경우에도 책임지지 않음» 같은 표현은 쓰지 않는다.
import { REPO } from "../data/tools";
import { ui, link } from "../lib/i18n";
import type { SiteLang } from "../i18n/langs";

interface Props {
  lang: SiteLang;
}
const { lang } = Astro.props;
const t = ui(lang);
// «도움이 됐나요?» — 서버 없이 GitHub Discussions(의견)·이슈(틀린 곳)로 잇는다
const pageTitle = Astro.url.pathname;
const ideaUrl = `${REPO}/discussions/new?category=ideas&title=${encodeURIComponent(t.feedbackPrefix + pageTitle)}`;
const [fixPre, fixContact, fixMid, fixIssue, fixPost] = t.noticeFix;
---

<aside class="feedback" aria-label={t.feedbackAria}>
  <p>
    <b>{t.feedbackQ}</b>
    {t.feedbackBody}
  </p>
  <p class="feedback-links">
    <a class="btn tight" href={ideaUrl} rel="noopener">{t.feedbackIdea}</a>
    <a class="btn tight" href={`${REPO}/issues/new/choose`} rel="noopener">{t.feedbackIssue}</a>
    <a href={link(lang, "contact/")}>{t.feedbackMail}</a>
  </p>
</aside>

<aside class="use-notice" aria-label={t.noticeAria}>
  <p>
    <b>{t.noticeHead}</b> — {t.noticeBody}{fixPre}<a href={link(lang, "contact/")}>{fixContact}</a>{fixMid}<a href={`${REPO}/issues`}>{fixIssue}</a>{fixPost}{" "}
    <a href={link(lang, "terms/")}>{t.noticeAll}</a>
  </p>
</aside>
