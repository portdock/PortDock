---
// 웹 도구 페이지 아래 «이어 읽기» — 이 웹 도구를 쓰는 가이드(guides.ts 의 webTools)와 다른 웹 도구
// 추가 언어(ja 등) 쪽에서는 그 언어로 번역된 웹 도구만 보이고, 가이드·나머지 도구는 영어판 목록으로 잇는다.
import { GUIDES } from "../data/guides";
import { WEB_TOOLS } from "../data/webTools";
import { groupOf } from "../data/webToolGroups";
import { ui, url, link, webToolText, isTranslated } from "../lib/i18n";
import { isCore, type SiteLang } from "../i18n/langs";

interface Props {
  lang: SiteLang;
  /** 지금 웹 도구 경로(예: "tools/modbus/") */
  path: string;
}
const { lang, path } = Astro.props;
const t = ui(lang);
const core = isCore(lang);
const guides = isCore(lang) ? GUIDES.filter((g) => g.webTools?.includes(path)) : [];
// 같은 묶음 도구를 먼저 보이고, 나머지는 접어 둔다(목록이 길어 본문보다 길어지지 않게 — 링크는 그대로 남는다)
const others = WEB_TOOLS.filter((w) => w.path !== path && isTranslated(lang, w.path));
const near = others.filter((w) => groupOf(w.path) === groupOf(path)).slice(0, 6);
const rest = others.filter((w) => !near.includes(w));
---

<section class="related">
  <h2>{t.readNext}</h2>
  <ul class="links">
    {
      isCore(lang) &&
        guides.map((g) => (
          <li>
            <a href={url(lang, `guides/${g.slug}/`)}>{g.title[lang as "ko" | "en"]}</a>
          </li>
        ))
    }
    {
      near.map((w) => (
        <li>
          <a href={url(lang, w.path)}>{webToolText(w, lang).name}</a> — {webToolText(w, lang).blurb}
        </li>
      ))
    }
    <li>
      <a href={link(lang, "download/")}>{t.dlPrograms}</a>
    </li>
    {
      !core && (
        <li>
          <a href={url("en", "tools/")} hreflang="en">{t.allToolsEn}</a>
        </li>
      )
    }
  </ul>
  {
    rest.length > 0 && (
      <details class="more">
        <summary>{t.moreTools(rest.length)}</summary>
        <ul class="links cols">
          {rest.map((w) => (
            <li>
              <a href={url(lang, w.path)}>{webToolText(w, lang).name}</a>
            </li>
          ))}
        </ul>
      </details>
    )
  }
</section>
