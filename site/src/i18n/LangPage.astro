  troubleshoot: TroubleshootPage,
  multimeterCheck: MultimeterCheckPage,
  canDecoder: CanDecoderPage,
  canTiming: CanTimingPage,
  i2c: I2cPage,
  uartBaud: UartBaudPage,
  modbusRtuTcp: ModbusRtuTcpPage,
  xgtDecoder: XgtDecoderPage,
