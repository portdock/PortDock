---
// 추가 언어(ja 등) 쪽 하나를 그린다 — pages/<언어>/[...path].astro 가 부른다. 쪽 이름 → 화면(views/) 표.
// 번역 범위(scope.ts SCOPE·SCOPE2·SCOPE3·SCOPE4)에 쪽을 더하면 여기 VIEWS 에도 한 줄.
import type { ExtraLang } from "./langs";
import { pageOf, type AnyPageId, type AnyScopePath } from "./scope";
import Home from "../views/Home.astro";
import ToolsIndex from "../views/ToolsIndex.astro";
import DownloadPage from "../views/DownloadPage.astro";
import SafetyPage from "../views/SafetyPage.astro";
import PrivacyPage from "../views/PrivacyPage.astro";
import AnalogScalePage from "../views/AnalogScalePage.astro";
import ModbusPage from "../views/ModbusPage.astro";
import ModbusDecoderPage from "../views/ModbusDecoderPage.astro";
import ModbusFloatPage from "../views/ModbusFloatPage.astro";
import McDecoderPage from "../views/McDecoderPage.astro";
import Rs485Page from "../views/Rs485Page.astro";
import SerialTimingPage from "../views/SerialTimingPage.astro";
import ChecksumPage from "../views/ChecksumPage.astro";
import SubnetPage from "../views/SubnetPage.astro";
import PinoutsPage from "../views/PinoutsPage.astro";
import WiringPage from "../views/WiringPage.astro";
import TroubleshootPage from "../views/TroubleshootPage.astro";
import MultimeterCheckPage from "../views/MultimeterCheckPage.astro";
import CanDecoderPage from "../views/CanDecoderPage.astro";
import CanTimingPage from "../views/CanTimingPage.astro";
import I2cPage from "../views/I2cPage.astro";
import UartBaudPage from "../views/UartBaudPage.astro";
import ModbusRtuTcpPage from "../views/ModbusRtuTcpPage.astro";
import XgtDecoderPage from "../views/XgtDecoderPage.astro";
import CableSelectionPage from "../views/CableSelectionPage.astro";
import MicTestPage from "../views/MicTestPage.astro";
import KeyboardTestPage from "../views/KeyboardTestPage.astro";
import WebcamTestPage from "../views/WebcamTestPage.astro";
import SpeakerTestPage from "../views/SpeakerTestPage.astro";
import MouseTestPage from "../views/MouseTestPage.astro";
import GamepadTestPage from "../views/GamepadTestPage.astro";
import MonitorTestPage from "../views/MonitorTestPage.astro";
import BsodCodesPage from "../views/BsodCodesPage.astro";
import BatteryReportPage from "../views/BatteryReportPage.astro";
import BarcodeTestPage from "../views/BarcodeTestPage.astro";
import AsciiPage from "../views/AsciiPage.astro";
import HexAsciiPage from "../views/HexAsciiPage.astro";
import IntegerPage from "../views/IntegerPage.astro";
import ModbusBlocksPage from "../views/ModbusBlocksPage.astro";
import ModbusPracticePage from "../views/ModbusPracticePage.astro";
import MqttDecoderPage from "../views/MqttDecoderPage.astro";
import PcapAnalyzerPage from "../views/PcapAnalyzerPage.astro";
import SpiPage from "../views/SpiPage.astro";
import UartWaveformPage from "../views/UartWaveformPage.astro";
import WebSerialPage from "../views/WebSerialPage.astro";
import LogicCapturePage from "../views/LogicCapturePage.astro";

interface Props {
  lang: ExtraLang;
  path: AnyScopePath;
}
const VIEWS = {
  home: Home,
  tools: ToolsIndex,
  download: DownloadPage,
  safety: SafetyPage,
  privacy: PrivacyPage,
  analog: AnalogScalePage,
  modbus: ModbusPage,
  modbusDecoder: ModbusDecoderPage,
  modbusFloat: ModbusFloatPage,
  mcDecoder: McDecoderPage,
  rs485: Rs485Page,
  serialTiming: SerialTimingPage,
  checksum: ChecksumPage,
  subnet: SubnetPage,
  pinouts: PinoutsPage,
  // 2차 묶음(scope.ts SCOPE2 — 언어별로 번역된 쪽만 그려진다)
  wiring: WiringPage,
  troubleshoot: TroubleshootPage,
  multimeterCheck: MultimeterCheckPage,
  canDecoder: CanDecoderPage,
  canTiming: CanTimingPage,
  i2c: I2cPage,
  uartBaud: UartBaudPage,
  modbusRtuTcp: ModbusRtuTcpPage,
  xgtDecoder: XgtDecoderPage,
  cableSelection: CableSelectionPage,
  // 3차 묶음(scope.ts SCOPE3 — 언어별로 번역된 쪽만 그려진다)
  micTest: MicTestPage,
  keyboardTest: KeyboardTestPage,
  webcamTest: WebcamTestPage,
  speakerTest: SpeakerTestPage,
  mouseTest: MouseTestPage,
  gamepadTest: GamepadTestPage,
  monitorTest: MonitorTestPage,
  bsodCodes: BsodCodesPage,
  batteryReport: BatteryReportPage,
  barcodeTest: BarcodeTestPage,
  // 4차 묶음(scope.ts SCOPE4 — 언어별로 번역된 쪽만 그려진다)
  ascii: AsciiPage,
  hexAscii: HexAsciiPage,
  integer: IntegerPage,
  modbusBlocks: ModbusBlocksPage,
  modbusPractice: ModbusPracticePage,
  mqttDecoder: MqttDecoderPage,
  pcapAnalyzer: PcapAnalyzerPage,
  spi: SpiPage,
  uartWaveform: UartWaveformPage,
  webSerial: WebSerialPage,
  logicCapture: LogicCapturePage,
} satisfies Record<AnyPageId, unknown>;
const { lang, path } = Astro.props;
const View = VIEWS[pageOf(path)];
---

<View lang={lang} />
