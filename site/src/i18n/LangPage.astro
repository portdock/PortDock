  cableLabels: CableLabelsPage,
  ferrules: FerrulesPage,
  insulation: InsulationPage,
  metricThreads: MetricThreadsPage,
  panelHeat: PanelHeatPage,
  handover: HandoverPage,
  ioList: IoListPage,
  systemDiagram: SystemDiagramPage,
  commissioning: CommissioningPage,
} satisfies Record<Exclude<AnyPageId, Page8Id>, unknown>;
// 8차 묶음(scope.ts SCOPE8 — 프로그램 소개, 언어별로 번역된 쪽만 그려진다): 쪽 이름 → 앱
const APPS = new Set<string>(Object.values(SCOPE8));
const { lang, path } = Astro.props;
const id = pageOf(path);
const app = APPS.has(id) ? TOOLS.find((x) => x.id === id) : undefined;
if (APPS.has(id) && !app) throw new Error(`8차 묶음: data/tools.ts 에 없는 앱 ${id}`);
const View = app ? null : VIEWS[id as Exclude<AnyPageId, Page8Id>];
---

{app ? <ToolPage lang={lang} tool={app} /> : View && <View lang={lang} />}
