  "model": "VF-AS1",
  "kind": "inverter",
  "title": {
    "ko": "도시바 TOSVERT VF-AS1 인버터 (RS485 Modbus RTU)",
    "en": "Toshiba TOSVERT VF-AS1 inverter (RS485 Modbus RTU)"
  },
  "summary": {
    "ko": "2선·4선 RS485. f807 = 1 로 Modbus RTU(FC 03 한 워드·06 만). 통신 번호(16진)가 주소: 지령 FA00·FA01, 모니터 FD00~.",
    "en": "2-wire and 4-wire RS485. f807 = 1 for Modbus RTU (FC 03 one word, 06 only). The hex communication number is the address: commands FA00/FA01, monitors from FD00."
  },
  "protocols": [
    "rtu"
  ],
  "comm": {
    "baud": 19200,
    "bauds": [
      9600,
      19200,
      38400
    ],
    "dataBits": 8,
    "parity": "even",
    "stopBits": 1,
    "unitRange": [
      1,
      247
    ],
    "maxRegisters": 1,
    "addressing": "zero",
    "notes": [
      {
        "ko": "주소 체계: 통신 번호(16진)가 그대로 프레임 주소 — 읽기 예 01 03 FD 00 00 01(p.30), 쓰기 예 01 06 FA 01 17 70(p.31).",
        "en": "Addressing: the hex communication number is the frame address — read example 01 03 FD 00 00 01 (p.30), write example 01 06 FA 01 17 70 (p.31)."
      },
      {
        "ko": "VF-AS1 의 Modbus RTU 는 FC 03(한 번에 1워드만)과 06 만 (p.29~30). 출하는 도시바 프로토콜 — 2선 RS485 는 f807 = 1 뒤 리셋 (p.40).",
        "en": "VF-AS1 Modbus RTU supports only FC 03 (one word per request) and 06 (pp.29-30). Factory protocol is Toshiba's; for 2-wire RS485 set f807 = 1 and reset (p.40)."
      },
      {
        "ko": "출하 19200 bps(f800 = 1)·짝수 패리티(f801 = 1)·인버터 번호 0 (p.40). 2선(f800·FA00·FA01)과 4선(f820·FA04·FA05)은 따로 설정한다. 전원 투입 뒤 약 2초 동안 통신 안 됨 (p.29).",
        "en": "Defaults 19200 bps (f800 = 1), even parity (f801 = 1), inverter number 0 (p.40). 2-wire (f800, FA00, FA01) and 4-wire (f820, FA04, FA05) are set separately. No communication for about 2 s after power-on (p.29)."
      }
    ]
  },
