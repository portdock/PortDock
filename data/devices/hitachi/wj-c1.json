  "kind": "inverter",
  "title": {
    "ko": "히타치 WJ 시리즈 C1 인버터 (RS485 Modbus RTU)",
    "en": "Hitachi WJ Series C1 inverter (RS485 Modbus RTU)"
  },
  "summary": {
    "ko": "WJ200 후속. 내장 RS485 Modbus RTU. 코일 0001h 운전 명령, 레지스터 0001h F001 주파수 지령, 1001h d001 출력 주파수, 1003h 출력 전류, 1011h 출력 전압. 프레임 주소 = 번호 − 1",
    "en": "Successor to the WJ200. Built-in RS485 Modbus RTU. Coil 0001h run command, register 0001h F001 frequency, 1001h d001 output frequency, 1003h output current, 1011h output voltage. Frame address = number - 1"
  },
  "protocols": [
    "rtu"
  ],
  "comm": {
    "baud": 9600,
    "bauds": [
      2400,
      4800,
      9600,
      19200,
      38400,
      57600,
      76800,
      115200
    ],
    "dataBits": 8,
    "parity": "none",
    "stopBits": 1,
    "unit": 1,
    "unitRange": [
      1,
      247
    ],
    "maxRegisters": 16,
    "order": "ABCD",
    "addressing": "one",
    "notes": [
      {
        "ko": "주소 체계: 프레임 시작 번호 = 레지스터 번호 − 1 (11.2.2). 읽기 예(PDF p.341)는 01 03 00 11 00 06 95 CD 로 0012h(최근 트립 정보)부터 6개를 읽는다.",
        "en": "Addressing: register start number in the frame = register number - 1 (11.2.2). The read example (PDF p.341) 01 03 00 11 00 06 95 CD reads 6 registers from 0012h (latest trip information)."
      },
      {
        "ko": "출하값: C071 05 = 9600 bps, C072 국번 1, C074 00 = 패리티 없음, C075 01 = 정지 1비트 (PDF p.454). 함수 코드 01h·03h·05h·06h·08h·0Fh·10h, 레지스터 16개·코일 32개까지 (PDF p.335~336).",
        "en": "Factory settings: C071 05 = 9600 bps, C072 address 1, C074 00 = no parity, C075 01 = 1 stop bit (PDF p.454). Function codes 01h, 03h, 05h, 06h, 08h, 0Fh and 10h; up to 16 registers or 32 coils (PDF pp.335-336)."
      }
    ]
  },
