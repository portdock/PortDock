{
  "$schema": "../schema.json",
  "schemaVersion": 1,
  "id": "schneider-electric/atv71",
  "manufacturer": {
    "ko": "슈나이더 일렉트릭",
    "en": "Schneider Electric"
  },
  "model": "ATV71",
  "models": [
    "Altivar 71"
  ],
  "kind": "inverter",
  "title": {
    "ko": "슈나이더 일렉트릭 Altivar 71 (ATV71) 인버터 (내장 Modbus RTU)",
    "en": "Schneider Electric Altivar 71 (ATV71) drive (integrated Modbus RTU)"
  },
  "summary": {
    "ko": "내장 Modbus RTU. 논리 주소 = 프레임 주소: 제어 워드 8501·8601, 주파수 지령 8502, 상태 워드 3201·8603, 출력 주파수 3202, 전류 3204, 고장 코드 7121",
    "en": "Integrated Modbus RTU. Logical address = frame address: control word 8501/8601, frequency reference 8502, status word 3201/8603, output frequency 3202, current 3204, fault code 7121"
  },
  "protocols": [
    "rtu"
  ],
  "comm": {
    "baud": 19200,
    "dataBits": 8,
    "parity": "even",
    "stopBits": 1,
    "unitRange": [
      1,
      247
    ],
    "maxRegisters": 63,
    "addressing": "zero",
    "notes": [
      {
        "ko": "주소 체계: Modbus 매뉴얼 읽기 예(p.30)는 02 03 0C1E 0004 276C 로 W3102~W3105(16#0C1E~)를 읽고 02 03 08 0028 0258 01F4 0000 52B0 을 받는다. 쓰기 예(p.31)는 02 06 2329 000D 9270 (W9001). 매뉴얼 번호 = 프레임 주소(0 기준).",
        "en": "Addressing: the read example (Modbus manual p.30) sends 02 03 0C1E 0004 276C to read W3102-W3105 (16#0C1E-) and gets 02 03 08 0028 0258 01F4 0000 52B0; the write example (p.31) is 02 06 2329 000D 9270 (W9001). Manual number = frame address (0-based)."
      },
      {
        "ko": "출하값: 19.2 kbps, 8E1, [Modbus Address] 는 OFF — 응답을 받으려면 1~247 로 바꾼다 (Modbus 매뉴얼 p.15).",
        "en": "Factory settings: 19.2 kbps, 8E1, [Modbus Address] OFF; set 1-247 to get replies (Modbus manual p.15)."
      },
      {
        "ko": "함수 코드 03(최대 63워드)·06·08·16(최대 61워드)·23(읽기·쓰기 20/20)·43 (p.30). 8501 과 8601 처럼 같은 값이 두 주소에 있는 것은 블록 쓰기 편의용(파라미터 매뉴얼 p.81).",
        "en": "Function codes 03 (up to 63 words), 06, 08, 16 (up to 61 words), 23 (20/20 read/write) and 43 (p.30). Values at two addresses such as 8501 and 8601 are there for block writes (parameters manual p.81)."
      }
    ]
  },
