{
  "$schema": "../schema.json",
  "schemaVersion": 1,
  "id": "autonics/tf3",
  "manufacturer": {
    "ko": "오토닉스",
    "en": "Autonics"
  },
  "model": "TF3 Series",
  "kind": "temperature-controller",
  "title": {
    "ko": "오토닉스 TF3 시리즈 냉동·냉장용 온도 조절기 (RS485 모델)",
    "en": "Autonics TF3 Series refrigeration temperature controller (RS485 models)"
  },
  "summary": {
    "ko": "Modbus RTU(브로드캐스트 안 됨). 코일(보조·압축기 출력), 입력 상태(출력 표시·DI), 입력 레지스터(PV·SV·최고/최저), 홀딩 레지스터(설정, FC 03/06/16).",
    "en": "Modbus RTU (no broadcast). Coils (AUX and compressor outputs), discrete inputs (output indicators, DI), input registers (PV, SV, max/min), holding registers (settings, FC 03/06/16)."
  },
  "protocols": [
    "rtu"
  ],
  "comm": {
    "baud": 9600,
    "bauds": [
      2400,
      4800,
      9600,
      19200,
      38400
    ],
    "parity": "none",
    "stopBits": 2,
    "unit": 1,
    "unitRange": [
      1,
      99
    ],
    "addressing": "zero",
    "notes": [
      {
        "ko": "매뉴얼은 «400001(0000)» 꼴 — 1 기준 참조 번호 + 괄호 안 16진 통신 주소. 각 표 첫 항목이 (0000) 이라 괄호 값을 0 기준 통신선 주소로 썼다 (p.19~28).",
        "en": "The manual writes «400001(0000)»: 1-based reference number plus hex communication address in parentheses. Each table starts at (0000), so the parenthesized value is used as the 0-based wire address (pp.19-28)."
      },
      {
        "ko": "출하값: ADR 01(01~99), BPS 9600, PRT NON, STP 2비트, 응답 대기 20 ms (p.28). 데이터 비트 수는 이 문서에 없다. 브로드캐스트는 지원하지 않는다 (p.5).",
        "en": "Defaults: ADR 01 (01-99), BPS 9600, PRT NON, STP 2 bits, response wait 20 ms (p.28). Data bits are not given in this document. Broadcast is not supported (p.5)."
      }
    ]
  },
