{
  "$schema": "../schema.json",
  "schemaVersion": 1,
  "id": "autonics/tm4",
  "manufacturer": {
    "ko": "오토닉스",
    "en": "Autonics"
  },
  "model": "TM4",
  "models": [
    "TM4-N2RB",
    "TM4-N2SB",
    "TM4-N2RE",
    "TM4-N2SE"
  ],
  "kind": "temperature-controller",
  "title": {
    "ko": "오토닉스 TM4 모듈형 4채널 PID 온도 조절기",
    "en": "Autonics TM4 modular 4-channel PID temperature controller"
  },
  "summary": {
    "ko": "DIN 레일 모듈형 4채널 온도 조절기. 기본 모듈(…B)에 RS485 Modbus RTU/ASCII. 코일(채널별 RUN/STOP·오토튜닝), 입력 레지스터(채널별 PV·SV·MV), CH1 보유 레지스터(SV·PID·입력·통신 설정)를 담았다.",
    "en": "DIN-rail modular 4-channel temperature controller; RS485 Modbus RTU/ASCII on the basic module (…B). Covers coils (per-channel RUN/STOP, auto-tuning), input registers (per-channel PV/SV/MV) and CH1 holding registers (SV, PID, input, comm)."
  },
  "protocols": [
    "rtu",
    "ascii"
  ],
  "comm": {
    "addressing": "zero",
    "baud": 9600,
    "bauds": [
      2400,
      4800,
      9600,
      19200,
      38400,
      57600,
      115200
    ],
    "dataBits": 8,
    "parity": "none",
    "stopBits": 2,
    "unit": 1,
    "unitRange": [
      1,
      31
    ],
    "notes": [
      {
        "ko": "통신 기본값: 사용자 매뉴얼 «1.5.2 Communication Interface»(p.28) — 9600bps(기본), 데이터 8비트 고정, 패리티 None(기본), 정지 2비트(기본), 응답 대기 20 ms, 최대 31대(국번 01~31). 통신 매뉴얼 3.4.7 공장 기본값(속도 2=9600, 패리티 0, 정지 1=2비트)과 같다.",
        "en": "Defaults from user manual 1.5.2 (p.28): 9600 bps, 8 data bits fixed, parity none, 2 stop bits, response wait 20 ms, up to 31 units (01-31); matches comm manual 3.4.7 factory defaults."
      },
      {
        "ko": "매뉴얼은 «400001 (0000)» 꼴 — 1 기준 참조 번호 + 괄호 안 16진 통신 주소. 각 표 첫 항목이 (0000) 이라 괄호 값을 0 기준 프레임 주소로 썼다(통신 매뉴얼 pp.37-57). 1.1 절 프레임 예시는 바이트 자리만 있고 숫자 예는 없다.",
        "en": "Manual writes «400001 (0000)»: 1-based reference plus hex comm address; first entries are (0000), so the parenthesized value is the 0-based wire address (pp.37-57). Frame examples in 1.1 show layout only."
      },
      {
        "ko": "통신 설정을 바꾸면 기기를 다시 켜야 정상 동작한다(사용자 매뉴얼 p.28).",
        "en": "Reboot after changing communication settings (user manual p.28)."
      }
    ]
  },
