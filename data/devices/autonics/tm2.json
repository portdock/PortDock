  "manufacturer": {
    "ko": "오토닉스",
    "en": "Autonics"
  },
  "model": "TM2",
  "models": [
    "TM2-22RB",
    "TM2-22CB",
    "TM2-42RB",
    "TM2-42CB",
    "TM2-22RE",
    "TM2-22CE",
    "TM2-42RE",
