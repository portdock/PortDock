{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window — least privilege. Device web pages are opened by the open_web command (Rust checks the IP), not by the opener URL scope.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "core:window:allow-set-title",
    "core:window:allow-set-always-on-top",
    "core:window:allow-request-user-attention",
    "window-state:default",
    "dialog:allow-message",
    "dialog:allow-open",
    "dialog:allow-save",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://github.com/portdock/PortDock"
        },
        {
          "url": "https://github.com/portdock/PortDock/*"
        },
        {
          "url": "https://portdock.dev"
        },
        {
          "url": "https://portdock.dev/*"
        },
        {
          "url": "https://www.gnu.org/licenses/*"
        },
        {
          "url": "https://developer.microsoft.com/*"
        },
        {
          "url": "mailto:*"
        }
      ]
    }
  ]
}
